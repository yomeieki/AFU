/* ============================================================
   设计 token（规范见 docs/design-system.md）
   CSS 变量定义在 page 上，可继承进自定义组件（穿透样式隔离）
   ============================================================ */
page {
  /* 品牌色 */
  --brand: #e5441e;
  --brand-dark: #c33514;
  --brand-light: #ef7150;
  --brand-bg: #fef4f0;
  --brand-bg-deep: #fde5dc;
  --brand-gradient: linear-gradient(135deg, #ff6a3d 0%, #e5441e 100%);

  /* 中性色 */
  --text-1: #1a1a1a;
  --text-2: #666666;
  --text-3: #999999;
  --text-disabled: #c8c9cc;
  --border: #ebedf0;
  --divider: #f2f3f5;
  --bg: #f5f6f7;
  --card: #ffffff;

  /* 功能色 / 订单状态色 */
  --warning: #ff9500;
  --warning-bg: #fff7e8;
  --info: #3b82f6;
  --info-bg: #eff6ff;
  --cyan: #0891b2;
  --cyan-bg: #ecfeff;
  --success: #16a34a;
  --success-bg: #f0fdf4;
  --gray: #9ca3af;
  --gray-bg: #f3f4f6;
  --danger: #ef4444;
  --danger-bg: #fef2f2;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;

  /* 阴影 */
  --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--text-1);
  background-color: var(--bg);
  box-sizing: border-box;
}

/* ============================================================
   原生 button 重置
   ============================================================ */
button {
  padding: 0;
  margin: 0;
  background: none;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}
button::after {
  border: none;
}

/* ============================================================
   公共类
   ============================================================ */
.card {
  background: var(--card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

/* 按钮：渐变胶囊主按钮 / 描边次按钮 / 禁用态 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 48rpx;
  background: var(--brand-gradient);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
}
.btn-plain {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 48rpx;
  background: var(--brand-bg);
  color: var(--brand);
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid var(--brand-light);
  border-radius: 999rpx;
  box-sizing: border-box;
}
.btn-disabled {
  background: var(--text-disabled) !important;
  color: #fff !important;
  border: none !important;
}

/* 价格三段式：¥小 + 整数大 + 小数小，700 字重品牌色 */
.price {
  color: var(--brand);
  font-weight: 700;
}
.price-symbol {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 700;
}
.price-int {
  font-size: 44rpx;
  color: var(--brand);
  font-weight: 700;
}
.price-dec {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 700;
}

/* 数量步进器（购物车 / 商品详情共用视觉） */
.stepper {
  display: flex;
  align-items: center;
}
.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--divider);
  color: var(--text-2);
  font-size: 32rpx;
  border-radius: 8rpx;
}
.stepper-btn.disabled {
  color: var(--text-disabled);
}
.stepper-num {
  min-width: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-1);
}

/* 底部安全区（fixed 操作栏容器用） */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

