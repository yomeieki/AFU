.page {
  background-color: var(--bg);
  min-height: 100vh;
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
}
.legal-card {
  padding: 36rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
}
.legal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-1);
  text-align: center;
}
.legal-meta {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  margin-top: 10rpx;
  margin-bottom: 24rpx;
}
.legal-h {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-top: 28rpx;
  margin-bottom: 8rpx;
}
.legal-p {
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--text-2);
  margin-top: 8rpx;
  user-select: text;
}
.legal-intro {
  color: var(--text-1);
}
