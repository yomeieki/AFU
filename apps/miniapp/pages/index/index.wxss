.page {
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

/* Banner */
.banner {
  height: 280rpx;
  background: linear-gradient(135deg, #e5441e 0%, #ff7043 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.banner-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.banner-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
}
.banner-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

/* Section */
.section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 24rpx 0;
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
}
.section-more {
  font-size: 26rpx;
  color: #999;
}

/* Categories */
.category-scroll {
  width: 100%;
  white-space: nowrap;
}
.category-list {
  display: flex;
  flex-direction: row;
  padding: 0 20rpx;
}
.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 20rpx;
  flex-shrink: 0;
}
.category-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: #fff5f3;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.category-icon {
  width: 64rpx;
  height: 64rpx;
}
.category-icon-text {
  font-size: 36rpx;
  color: #e5441e;
  font-weight: bold;
}
.category-name {
  font-size: 24rpx;
  color: #555;
}

/* Loading / empty */
.loading-wrap,
.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}
.loading-text,
.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* Product grid */
.product-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 0 20rpx;
  gap: 16rpx;
}
.product-card {
  width: calc(50% - 8rpx);
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.product-img-wrap {
  width: 100%;
  height: 240rpx;
  background-color: #f0f0f0;
  overflow: hidden;
}
.product-img {
  width: 100%;
  height: 100%;
}
.product-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.product-img-placeholder-text {
  font-size: 24rpx;
  color: #bbb;
}
.product-info {
  padding: 16rpx;
}
.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #222;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-subtitle {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.product-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #e5441e;
}
.product-sales {
  font-size: 22rpx;
  color: #aaa;
}
