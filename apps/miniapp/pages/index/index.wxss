.page {
  background-color: var(--bg);
  padding-bottom: 30rpx;
}

/* Banner 轮播（后台配置） */
.banner-swiper {
  height: 300rpx;
}
.banner-swiper-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* Banner */
.banner {
  position: relative;
  height: 300rpx;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.banner-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.banner-deco-1 {
  width: 320rpx;
  height: 320rpx;
  top: -160rpx;
  left: -80rpx;
}
.banner-deco-2 {
  width: 420rpx;
  height: 420rpx;
  bottom: -300rpx;
  right: -120rpx;
}
.banner-deco-3 {
  width: 90rpx;
  height: 90rpx;
  top: 48rpx;
  right: 140rpx;
  background: rgba(255, 255, 255, 0.14);
}
.banner-inner {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.banner-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
.banner-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 14rpx;
  letter-spacing: 2rpx;
}

/* Section */
.section {
  background-color: var(--card);
  margin: 20rpx 24rpx 0;
  padding: 28rpx 0 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-1);
}
.section-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-3);
}
.section-more-arrow {
  width: 26rpx;
  height: 26rpx;
}

/* Categories */
.category-scroll {
  width: 100%;
  white-space: nowrap;
}
.category-list {
  display: flex;
  flex-direction: row;
  padding: 0 16rpx;
}
.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 20rpx;
  flex-shrink: 0;
}
.category-item-hover {
  opacity: 0.7;
}
.category-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: var(--brand-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}
.category-icon {
  width: 64rpx;
  height: 64rpx;
}
.category-icon-text {
  font-size: 40rpx;
  color: var(--brand);
  font-weight: bold;
}
.category-name {
  font-size: 24rpx;
  color: var(--text-2);
}

/* Product grid */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  padding: 0 20rpx;
  gap: 16rpx;
}
.product-card {
  background-color: var(--card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.product-card-hover {
  transform: scale(0.98);
  transition: transform 0.1s;
}
.product-img-wrap {
  width: 100%;
  height: 240rpx;
  overflow: hidden;
}
.product-img {
  width: 100%;
  height: 100%;
}
.product-img-placeholder {
  width: 100%;
  height: 100%;
}
.product-info {
  padding: 18rpx 16rpx 20rpx;
}
.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-subtitle {
  font-size: 22rpx;
  color: var(--text-3);
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 14rpx;
}
.product-price-wrap {
  display: flex;
  align-items: baseline;
}
.product-price-int {
  font-size: 36rpx;
}
.product-sales {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 骨架屏 */
.skeleton-img {
  width: 100%;
  height: 240rpx;
  background: var(--divider);
}
.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: var(--divider);
  margin-top: 8rpx;
}
.skeleton-line-short {
  width: 55%;
  margin-top: 16rpx;
}
.skeleton-shine {
  animation: skeleton-breath 1.2s ease-in-out infinite;
}
@keyframes skeleton-breath {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 多规格商品最低价后缀 */
.price-from {
  font-size: 20rpx;
  color: var(--text-3);
  margin-left: 4rpx;
}


/* 自绘导航栏（本页专用；tabBar 页拿不到原生返回箭头） */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-sizing: border-box;
  background: var(--card, #ffffff);
}
.navbar-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 触控区 88rpx=44px，与 iOS 原生返回键一致；箭头本身靠左对齐到 24rpx */
.navbar-back {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  width: 88rpx;
  box-sizing: border-box;
}
.navbar-back-hover { opacity: 0.45; }
.navbar-back-icon {
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+IDxwYXRoIGQ9Ik0xNS41IDUgbC03IDcgNyA3IiBmaWxsPSJub25lIiBzdHJva2U9IiMwMDAwMDAiIHN0cm9rZS13aWR0aD0iMi4yIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz4gPC9zdmc+");
}
.navbar-title {
  color: var(--text-1, #1a1a1a);
  font-size: 32rpx;
  font-weight: 500;
}
