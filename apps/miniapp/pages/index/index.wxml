<wxs src="../../utils/price.wxs" module="pricefmt" />
<view class="page {{channel === 'LOCAL' ? 'page-local' : ''}}">

  <!-- 自绘导航栏。本页是 tabBar 页，微信不会给它原生返回箭头，
       只有改 navigationStyle:custom 自己画，才能把返回键放到与同城页
       原生箭头完全相同的位置。高度与箭头中线按胶囊按钮实测值对齐，见 index.js:computeNavBar。
       fixed 定位：本页开着下拉刷新，不 fixed 的话导航栏会跟着被拉下去。 -->
  <view class="navbar" style="height:{{navTotal}}px;padding-top:{{statusBarHeight}}px">
    <view class="navbar-inner" style="height:{{navContent}}px">
      <view class="navbar-back" hover-class="navbar-back-hover" hover-stay-time="60" bindtap="goCover">
        <view class="navbar-back-icon"></view>
      </view>
      <!-- 店名与渠道标识都与下方门店头重复，店主要求精简：同城下方已有 local-store-header
           （店名 + 营业状态 + 配送规则），顶栏只留返回箭头。邮寄没有门店头，去掉标识会让顾客
           看不出自己在哪个渠道，所以邮寄侧保留这颗标识；点它回封面重选，与左侧返回箭头同一个去处。 -->
      <text wx:if="{{channel === 'EXPRESS'}}" class="navbar-channel" hover-class="navbar-channel-hover" hover-stay-time="60" bindtap="goCover" style="{{channelRight ? 'right:' + channelRight + 'px' : ''}}">{{channelLabel}}</text>
    </view>
  </view>
  <view style="height:{{navTotal}}px"></view>

  <!-- 同城：门店头（营业状态 / 配送规则 / 阻塞通知）取代 Banner 的位置 -->
  <local-store-header wx:if="{{channel === 'LOCAL'}}" meta="{{meta}}" mode="{{mode}}" bind:goexpress="onGoExpress" bind:switchmode="onSwitchMode" />

  <!-- 邮寄 Banner：后台配置的轮播优先，无配置时回退静态渐变 banner -->
  <swiper
    wx:elif="{{banners.length > 0}}"
    class="banner-swiper"
    autoplay
    circular
    interval="4000"
    indicator-dots="{{banners.length > 1}}"
    indicator-color="rgba(255,255,255,.4)"
    indicator-active-color="#ffffff"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image
        class="banner-swiper-img"
        src="{{item.imageUrl}}"
        mode="aspectFill"
        data-banner="{{item}}"
        bindtap="onBannerTap"
      />
    </swiper-item>
  </swiper>
  <view wx:elif="{{channel === 'EXPRESS'}}" class="banner">
    <view class="banner-deco banner-deco-1"></view>
    <view class="banner-deco banner-deco-2"></view>
    <view class="banner-deco banner-deco-3"></view>
    <view class="banner-inner">
      <text class="banner-title">新鲜熟食</text>
      <text class="banner-sub">每日现做 · 品质保证</text>
    </view>
  </view>

  <!-- 同城「外送 / 自取」切换栏：页头之下、分类区之上（spec P2）。
       必须放在上面那条 wx:if / wx:elif 链**之外**——插在链中间会让 banner 的 wx:elif 绑到它身上。 -->
  <local-mode-bar wx:if="{{channel === 'LOCAL'}}" meta="{{meta}}" mode="{{mode}}" bind:change="onModeChange" />

  <!-- Categories -->
  <view class="section" wx:if="{{categories.length > 0}}">
    <view class="section-header">
      <text class="section-title">{{channel === 'LOCAL' ? '同城分类' : '商品分类'}}</text>
      <text class="section-more" bindtap="goToAllProducts">全部 <text class="section-more-arrow icon icon-arrow"></text></text>
    </view>
    <scroll-view scroll-x class="category-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="category-list">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="category-item"
          hover-class="category-item-hover"
          bindtap="goToList"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
        >
          <view class="category-icon-wrap">
            <image
              wx:if="{{item.iconUrl}}"
              class="category-icon"
              src="{{item.iconUrl}}"
              mode="aspectFit"
              lazy-load="{{true}}"
            />
            <text wx:else class="category-icon-text">{{item.name[0]}}</text>
          </view>
          <text class="category-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Recommended Products -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">{{channel === 'LOCAL' ? '今日现拌' : '推荐商品'}}</text>
    </view>

    <!-- 骨架屏 -->
    <view wx:if="{{loading}}" class="product-grid">
      <view class="product-card skeleton-card" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this">
        <view class="skeleton-img skeleton-shine"></view>
        <view class="product-info">
          <view class="skeleton-line skeleton-shine"></view>
          <view class="skeleton-line skeleton-line-short skeleton-shine"></view>
        </view>
      </view>
    </view>

    <empty-state wx:elif="{{products.length === 0}}" type="product"
      text="{{channel === 'LOCAL' ? '同城菜单还在准备中' : '暂无商品'}}" />

    <view wx:else class="product-grid">
      <view
        wx:for="{{products}}"
        wx:key="id"
        class="product-card"
        hover-class="product-card-hover"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="product-img-wrap">
          <image
            wx:if="{{item.coverImage}}"
            class="product-img"
            src="{{item.coverImage}}"
            mode="aspectFill"
            lazy-load="{{true}}"
          />
          <view wx:else class="product-img-placeholder img-placeholder"></view>
        </view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
          <view class="product-bottom">
            <view class="product-price-wrap">
              <text class="price-symbol">¥</text>
              <text class="price-int product-price-int">{{pricefmt.int(item.priceText)}}</text>
              <text class="price-dec">{{pricefmt.dec(item.priceText)}}</text>
              <text wx:if="{{item.hasSkus}}" class="price-from">起</text>
            </view>
            <text wx:if="{{item.salesCount > 0 && channel !== 'LOCAL'}}" class="product-sales">已售{{item.salesCount}}</text>
            <!-- catchtap 而不是 bindtap：不 catch 的话会冒泡到整张卡的 goToDetail，
                 顾客按一下加购、页面却跳进了详情页。 -->
            <view
              wx:if="{{channel === 'LOCAL'}}"
              class="add-btn {{item.stock <= 0 ? 'add-btn-disabled' : ''}}"
              catchtap="onAddToCart"
              data-id="{{item.id}}"
            >+</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="cart-spacer" style="height: {{cartSpacerPx}}px;"></view>
</view>

<!-- 同城购物车条。fixed 在 tabBar 之上（tabBar 是画在 WebView 之外的原生组件，
     可视区本来就不含它），车空时组件自己不渲染、不占位。 -->
<local-cart-bar
  wx:if="{{channel === 'LOCAL'}}"
  id="local-cart-bar"
  meta="{{meta}}"
  blocking="{{headBlocking}}"
  mode="{{mode}}"
  bind:change="onCartChange"
/>

<local-sku-picker wx:if="{{channel === 'LOCAL'}}" id="local-sku-picker" bind:added="onAdded" />

<privacy-popup id="privacy-popup" />
