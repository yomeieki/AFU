<!-- 封面分流页：pages[0]，非 tabBar。方案 C 青瓦版 v3。
     三层结构：背景层 + Logo 图片层 + 原生交互层。刻意不做成「一张大图 + 透明热区」——
     旧亭子版是那样，换背景就得重切热区；现在换背景只动 assets，热区与路由不受影响。
     热区坐标见 config/cover-entries.js，出自设计交付包的 SVG 真实矩形，不是目测。 -->
<view class="cover-root">

  <!-- 背景。同一张图铺两次：下面一张锚顶，给长屏补足上半部分的宣纸纹理；
       上面一张锚底，保证青瓦院墙无论屏幕多高都贴着屏幕底边。
       WXSS 的 background-image 不支持本地路径，所以只能用 image 组件。 -->
  <image class="cover-bg cover-bg-paper" src="/assets/cover/home-bg-courtyard-wall.jpg"
         mode="widthFix" binderror="onImgError" aria-hidden="true" />
  <image class="cover-bg cover-bg-wall" src="/assets/cover/home-bg-courtyard-wall.jpg"
         mode="widthFix" aria-hidden="true" />

  <!-- 舞台。stageOffset 让开微信胶囊按钮，stageScale 只在极短屏上兜底。
       六个热区都在舞台内，跟着一起变换，不会出现「视觉动了热区没动」。 -->
  <view class="cover-stage" style="transform: translateY({{stageOffset}}rpx) scale({{stageScale}});">

    <image class="cover-logo" src="/assets/cover/logo-anniversary.png" mode="aspectFit"
           binderror="onImgError" aria-role="img" aria-label="丹桂阿福凉菜 30TH 老店" />

    <!-- 会员浅纸托盘：横跨三个热区之下的整块装饰，不接收点击。
         内框与分隔线都与托盘平级——嵌进去会被托盘的小数边框取整带偏 0.25rpx。 -->
    <view class="tray" aria-hidden="true"></view>
    <view class="tray-inner" aria-hidden="true"></view>
    <view class="tray-rule" style="left: 297rpx; top: 746rpx; height: 15rpx;" aria-hidden="true"></view>
    <view class="tray-rule" style="left: 297rpx; top: 773rpx; height: 16rpx;" aria-hidden="true"></view>
    <view class="tray-diamond" style="left: 297rpx; top: 767rpx;" aria-hidden="true"></view>
    <view class="tray-rule" style="left: 454rpx; top: 746rpx; height: 15rpx;" aria-hidden="true"></view>
    <view class="tray-rule" style="left: 454rpx; top: 773rpx; height: 16rpx;" aria-hidden="true"></view>
    <view class="tray-diamond" style="left: 454rpx; top: 767rpx;" aria-hidden="true"></view>

    <view wx:for="{{entries}}" wx:key="id"
          class="hot"
          style="left:{{item.rect.x}}rpx; top:{{item.rect.y}}rpx; width:{{item.rect.width}}rpx; height:{{item.rect.height}}rpx;"
          hover-class="hot-hover" hover-start-time="0" hover-stay-time="120"
          aria-role="button" aria-label="{{item.label}}"
          data-id="{{item.id}}" bindtap="onTapEntry">

      <!-- 同城配送 / 全国邮寄：阶梯转角金框走 SVG 背景，文字是原生节点 -->
      <block wx:if="{{item.variant === 'delivery'}}">
        <view class="df" aria-hidden="true"></view>
        <text class="delivery-cn">{{item.label}}</text>
        <text class="delivery-en"
              style="letter-spacing: {{item.enTracking}}rpx; padding-left: {{item.enTracking}}rpx;">{{item.en}}</text>
      </block>

      <!-- 会员中心 / 优惠券 / 积分商城：托盘在装饰层，这里只有文字 -->
      <view wx:elif="{{item.variant === 'text'}}" class="nav-text">{{item.label}}</view>

      <!-- 全国冷链配送：纸层 / 主框 / 内框 / 高光 / 竖线 / 朱红查看小签 -->
      <block wx:else>
        <view class="cc-under" aria-hidden="true"></view>
        <view class="cc-main" aria-hidden="true"></view>
        <view class="cc-inner" aria-hidden="true"></view>
        <view class="cc-highlight" aria-hidden="true"></view>
        <text class="cold-cn">{{item.label}}</text>
        <text class="cold-en">{{item.en}}</text>
        <view class="cc-rule" aria-hidden="true"></view>
        <view class="cc-tag" aria-hidden="true"></view>
        <view class="cc-tag-inner" aria-hidden="true"></view>
        <text class="cc-tag-cha">查</text>
        <text class="cc-tag-kan">看</text>
      </block>

    </view>
  </view>
</view>

<!-- 「我的订单」常驻入口。必须是 .cover-root 的兄弟、不能放进 .cover-stage：
     舞台带 translate/scale，放进去会被一起拖歪。

     为什么留着：同城页不在 tabBar 里，靠 navigateTo 打开，底部天然没有导航栏。
     顾客下完单再开小程序，要走 封面→全国邮寄(switchTab)→底部「我的」→我的订单
     才看得到自己的单。设计稿里没有这个入口，但它是 1c9de11 为解决真实问题加的。
     用 navigateTo 而不是 switchTab：switchTab 会销毁本页页栈。 -->
<view class="cover-orders" hover-class="cover-orders-hover" hover-stay-time="60" bindtap="goOrders">
  <text class="cover-orders-text">我的订单 ›</text>
</view>

<!-- 必须存在且必须是 .cover-root 的兄弟：app.js 的 onNeedPrivacyAuthorization 是按当前页
     找 #privacy-popup 的，找不到就静默 resolve(disagree)，同城入口会永远失败且不报错。 -->
<privacy-popup id="privacy-popup" />
