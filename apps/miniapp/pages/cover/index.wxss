/* 封面分流页｜方案 C 青瓦版 v3
   设计基准 750 × 1333，设计稿 1px === 1rpx。
   几何逐项取自 v3 交付包 previews/homepage-formal.svg，配色取自 specs/design-tokens.json。
   文字行盒顶边按 SVG 基线 y 反算，已在浏览器逐项实测到 0.00px（17 项几何量）。

   两条踩过的坑，改这个文件前先看：
   1. 带小数边框（1.25 / 1.7rpx）的盒子，其内绝对定位子元素相对 padding box 排布，
      而渲染器会把边框按设备像素取整，padding box 原点因此漂移 0.2~0.25rpx。
      所以所有内框都与外框**平级**，用绝对设计坐标定位，不嵌套。
   2. .hot 自带 z-index，让热区成为独立堆叠上下文；否则冷链内部 1~5 的层级
      会窜到页面根层级，盖住页面上本该更高的元素。

   底色写死 #F1E9DA（背景原图顶部 60px 均值）：冷启动时先画 page 背景再渲染，
   同色才不会闪一下灰白。 */
page {
  height: 100%;
  overflow: hidden;
  background: #F1E9DA;
}

.cover-root {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #F1E9DA;
}

/* ---------- 背景 ---------- */
.cover-bg { position: absolute; left: 0; width: 750rpx; z-index: 1; }
.cover-bg-paper { top: 0; }
/* 锚到自绘四栏上沿：98rpx = 49px 栏高，安全区随机型。JS 的 layout() 用同一口径扣高度（TAB_BAR_PX + bottomInsetPx） */
.cover-bg-wall { bottom: calc(98rpx + env(safe-area-inset-bottom)); }

/* ---------- 舞台 ---------- */
.cover-stage {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 1333rpx;
  z-index: 2;
  transform-origin: 375rpx 135rpx;
}

.cover-logo { position: absolute; left: 125rpx; top: 135rpx; width: 500rpx; height: 292.86rpx; }

/* ---------- 会员浅纸托盘（装饰层，横跨三个热区之下）---------- */
/* 托盘 140.75→609.25 是一整块，不属于任何单个热区，所以放在热区之前、由舞台直接持有。
   按下某一项时只有该项文字下移，托盘不动——这正是设计要的效果。 */
.tray {
  position: absolute; left: 140.75rpx; top: 732.75rpx; width: 468.5rpx; height: 69.5rpx;
  box-sizing: border-box; border: 1.25rpx solid #9F7F50; border-radius: 13rpx;
  background: linear-gradient(180deg, rgba(255, 251, 239, .86), rgba(246, 236, 217, .76));
  box-shadow: 0 2.5rpx 3.6rpx rgba(89, 66, 38, .14);
}
.tray-inner {
  position: absolute; left: 145rpx; top: 737rpx; width: 460rpx; height: 61rpx;
  box-sizing: border-box; border: .9rpx solid #BDA477; border-radius: 10rpx;
}
.tray-rule { position: absolute; width: 1rpx; background: #AD9163; }
.tray-diamond {
  position: absolute; width: 5.66rpx; height: 5.66rpx; background: #A74337;
  transform: translate(-50%, -50%) rotate(45deg);
}

/* ---------- 热区 ---------- */
.hot { position: absolute; z-index: 3; box-sizing: border-box; }

/* ---------- 同城配送 / 全国邮寄 ---------- */
/* 阶梯式转角 + 双层金线 + 下缘纸层 + 投影。CSS 的 border-radius 做不出这个轮廓，
   整块框做成矢量 SVG 数据 URI 当背景（任意倍率都清晰，1.7KB，不占素材文件）；
   文字仍是原生节点，字体、可访问性、按下态都不受影响。
   viewBox 向外扩 6，投影才不会被自身画布裁掉，故左 -6 上 -2。 */
.df {
  position: absolute; left: -6rpx; top: -2rpx; width: 320rpx; height: 132rpx;
  background: url("data:image/svg+xml;base64,") no-repeat 0 0;
  background-size: 320rpx 132rpx;
}

.delivery-en {
  display: block; position: absolute; left: 0; right: 0; top: 71rpx;
  height: 16rpx; line-height: 16rpx; box-sizing: border-box;
  text-align: center; font-size: 16rpx; color: #806844;
  font-family: Baskerville, Georgia, "Times New Roman", serif;
}

/* ---------- 全国冷链配送 ---------- */
.cc-under { position: absolute; left: 1rpx; top: 17rpx; width: 468rpx; height: 100rpx; border-radius: 14rpx; background: rgba(212, 191, 153, .65); z-index: 1; }
.cc-main {
  position: absolute; left: .75rpx; top: 14.75rpx; width: 468.5rpx; height: 99.5rpx; z-index: 2;
  box-sizing: border-box; border: 1.7rpx solid #96713E; border-radius: 14rpx;
  background: linear-gradient(180deg, rgba(255, 251, 239, .86), rgba(246, 236, 217, .76));
  box-shadow: 0 3.5rpx 4.4rpx rgba(89, 66, 38, .18);
}
.cc-inner { position: absolute; left: 6rpx; top: 20rpx; width: 458rpx; height: 89rpx; z-index: 3; box-sizing: border-box; border: 1rpx solid #B7955F; border-radius: 10rpx; }
.cc-highlight { position: absolute; left: 19rpx; top: 17rpx; width: 431rpx; height: 1.5rpx; background: #FFFDF3; z-index: 3; }

.cold-en { display: block; position: absolute; left: 30rpx; top: 82rpx; height: 15rpx; line-height: 15rpx; font-size: 15rpx; letter-spacing: 1.2rpx; color: #806844; z-index: 3; font-family: Baskerville, Georgia, "Times New Roman", serif; }
.cc-rule { position: absolute; left: 304rpx; top: 37rpx; width: 1rpx; height: 55rpx; background: #AD9163; z-index: 3; }
.cc-tag {
  position: absolute; left: 357rpx; top: 25rpx; width: 63rpx; height: 79rpx; z-index: 4;
  box-sizing: border-box; border: 1rpx solid #8E302A; border-radius: 10rpx;
  background: linear-gradient(180deg, #AD3936, #92302E);
  box-shadow: 0 2.5rpx 3.6rpx rgba(89, 66, 38, .14);
}
.cc-tag-inner { position: absolute; left: 361rpx; top: 29rpx; width: 55rpx; height: 71rpx; z-index: 5; box-sizing: border-box; border: .75rpx solid rgba(226, 184, 146, .8); border-radius: 7rpx; }

/* ---------- 按下态 ---------- */
/* v2/v4 交互规范：视觉内容下移 1rpx、阴影减半、纸底略暖，约 120ms 恢复，
   不做缩放和弹跳；热区本身固定不动。 */
.df, .glyphs, .delivery-en,
.cc-under, .cc-main, .cc-inner, .cc-highlight,
.cold-en, .cc-rule, .cc-tag, .cc-tag-inner {
  transition: transform .12s ease, box-shadow .12s ease, background-image .12s ease;
}
.hot-hover .df, .hot-hover .glyphs, .hot-hover .delivery-en,
.hot-hover .cc-under, .hot-hover .cc-main, .hot-hover .cc-inner, .hot-hover .cc-highlight,
.hot-hover .cold-en, .hot-hover .cc-rule, .hot-hover .cc-tag, .hot-hover .cc-tag-inner {
  transform: translateY(1rpx);
}
/* 阴影减半 + 纸底略暖。配送框的投影烘在 SVG 里，所以换一张按下态的 SVG。 */
.hot-hover .df {
  background-image: url("data:image/svg+xml;base64,");
}
.hot-hover .cc-main {
  box-shadow: 0 1.75rpx 2.2rpx rgba(89, 66, 38, .09);
  background: linear-gradient(180deg, rgba(255, 248, 230, .90), rgba(242, 229, 205, .80));
}
.hot-hover .cc-tag { box-shadow: 0 1.25rpx 1.8rpx rgba(89, 66, 38, .07); }

/* 系统开了「减少动画」就不做位移，只保留阴影与底色变化 */
@media (prefers-reduced-motion: reduce) {
  .hot-hover .df, .hot-hover .glyphs, .hot-hover .delivery-en,
  .hot-hover .cc-under, .hot-hover .cc-main, .hot-hover .cc-inner, .hot-hover .cc-highlight,
  .hot-hover .cold-en, .hot-hover .cc-rule, .hot-hover .cc-tag, .hot-hover .cc-tag-inner {
    transform: none;
  }
}

/* ---------- 中文字形层（v4）----------
   v4 中文改隶书 STLibianSC-Regular，这是 macOS 独占字体：iOS 与安卓都没有，
   走 font-family 会退化成宋体，v4 的隶书气质就没了。交付包为此提供了
   homepage-formal-outlined.svg（字形已转路径），这里按热区取出来做成矢量
   SVG 数据 URI 当背景：任意机型、任意倍率都是设计定死的字形。
   viewBox 直接用画板坐标，定位天然对齐，不需要任何偏移计算。
   坐标精度取 1 位小数（0.1rpx ≈ 3 倍屏 0.18 设备像素，足够）。
   两个配送图标也打包在同一张图里。英文仍是原生文字节点；
   无障碍靠热区上的 aria-label，字形层自身 aria-hidden。

   z-index 6：必须压在冷链的纸层/主框/内框(1~3)与朱红小签及其内框(4~5)之上——
   否则「全国冷链配送」会被半透明纸底洗白，「查看」会被小签整个盖住。 */
.glyphs {
  position: absolute;
  z-index: 6;
  background-repeat: no-repeat;
  background-position: 0 0;
  pointer-events: none;
}
.gl-local-delivery {
  left: -4rpx; top: -4rpx; width: 314rpx; height: 128rpx;
  background-image: url("data:image/svg+xml;base64,");
  background-size: 314rpx 128rpx;
}
.gl-nationwide-shipping {
  left: -4rpx; top: -4rpx; width: 314rpx; height: 128rpx;
  background-image: url("data:image/svg+xml;base64,");
  background-size: 314rpx 128rpx;
}
.gl-member-center {
  left: -4rpx; top: -4rpx; width: 153rpx; height: 96rpx;
  background-image: url("data:image/svg+xml;base64,");
  background-size: 153rpx 96rpx;
}
.gl-coupon {
  left: -4rpx; top: -4rpx; width: 153rpx; height: 96rpx;
  background-image: url("data:image/svg+xml;base64,");
  background-size: 153rpx 96rpx;
}
.gl-points-mall {
  left: -4rpx; top: -4rpx; width: 152rpx; height: 96rpx;
  background-image: url("data:image/svg+xml;base64,");
  background-size: 152rpx 96rpx;
