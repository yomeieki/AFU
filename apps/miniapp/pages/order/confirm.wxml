<wxs src="../../utils/price.wxs" module="pricefmt" />
<view class="page">

  <!-- Address -->
  <view class="section card address-section" bindtap="onSelectAddress">
    <view class="address-pin icon icon-pin"></view>
    <view wx:if="{{address}}" class="address-info">
      <view class="receiver-row">
        <text class="receiver-name">{{address.receiverName}}</text>
        <text class="receiver-phone">{{address.receiverPhone}}</text>
      </view>
      <text class="address-full">{{address.fullAddress}}</text>
    </view>
    <view wx:else class="no-address">
      <text>请选择收货地址</text>
    </view>
    <view class="arrow icon icon-arrow"></view>
  </view>

  <!-- Items -->
  <view class="section card">
    <view class="section-title">商品明细</view>
    <view class="item-list">
      <view wx:for="{{items}}" wx:key="id" class="item-row">
        <view class="item-img-wrap">
          <image wx:if="{{item.productImage}}" class="item-img" src="{{item.productImage}}" mode="aspectFill"/>
          <view wx:else class="item-img-ph img-placeholder"></view>
        </view>
        <view class="item-info">
          <text class="item-name">{{item.productName}}</text>
          <text class="item-spec" wx:if="{{item.specText}}">{{item.specText}}</text>
          <text class="item-qty">× {{item.quantity}}</text>
        </view>
        <text class="item-subtotal">¥{{pricefmt.fen(item.subtotal)}}</text>
      </view>
    </view>
  </view>

  <!-- Delivery -->
  <view class="section card">
    <view class="row">
      <text class="row-label">配送方式</text>
      <text class="row-value">快递配送</text>
    </view>
  </view>

  <!-- Remark -->
  <view class="section card">
    <view class="row">
      <text class="row-label">备注</text>
      <input
        class="remark-input"
        placeholder="选填，如配送时间要求"
        placeholder-class="remark-placeholder"
        value="{{remark}}"
        bindinput="onRemarkInput"
      />
    </view>
  </view>

  <!-- Amount -->
  <view class="section card">
    <view class="row">
      <text class="row-label">商品金额</text>
      <text class="row-value">¥{{pricefmt.fen(totalAmount)}}</text>
    </view>
    <view class="row">
      <text class="row-label">运费</text>
      <text wx:if="{{shippingFee > 0}}" class="row-value">¥{{pricefmt.fen(shippingFee)}}</text>
      <text wx:else class="row-value free">免运费</text>
    </view>
    <view class="row total-row">
      <text class="row-label">合计</text>
      <view class="total-price-wrap">
        <text class="price-symbol">¥</text>
        <text class="price-int total-price-int">{{pricefmt.int(pricefmt.fen(payAmount))}}</text>
        <text class="price-dec">{{pricefmt.dec(pricefmt.fen(payAmount))}}</text>
      </view>
    </view>
  </view>

  <view class="spacer"></view>
</view>

<!-- Bottom bar -->
<view class="bottom-bar">
  <view class="agree-row">
    <text>提交订单即表示同意</text>
    <text class="agree-link" bindtap="goLegal" data-type="agreement">《用户协议》</text>
    <text>和</text>
    <text class="agree-link" bindtap="goLegal" data-type="privacy">《隐私政策》</text>
  </view>
  <view wx:if="{{belowMinOrder}}" class="min-order-tip">{{minOrderTip}}</view>
  <view class="bottom-main">
    <view class="bottom-total-wrap">
      <text class="bottom-total-label">合计</text>
      <text class="price-symbol">¥</text>
      <text class="price-int bottom-total-int">{{pricefmt.int(pricefmt.fen(payAmount))}}</text>
      <text class="price-dec">{{pricefmt.dec(pricefmt.fen(payAmount))}}</text>
    </view>
    <view
      class="submit-btn btn-primary {{submitting || belowMinOrder ? 'btn-disabled' : ''}}"
      bindtap="onSubmit"
    >
      <text>{{submitting ? '提交中...' : '提交订单'}}</text>
    </view>
  </view>
</view>
