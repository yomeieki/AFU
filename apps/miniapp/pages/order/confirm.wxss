.page { background-color: #f5f5f5; padding-bottom: 140rpx; }
.section {
  background-color: #fff;
  margin-top: 16rpx;
  padding: 24rpx 30rpx;
}
.section-title { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 16rpx; }
.address-section { display: flex; align-items: center; gap: 16rpx; }
.address-info { flex: 1; }
.receiver-row { display: flex; gap: 20rpx; margin-bottom: 10rpx; }
.receiver-name { font-size: 30rpx; font-weight: bold; color: #222; }
.receiver-phone { font-size: 28rpx; color: #666; }
.address-full { font-size: 26rpx; color: #888; line-height: 1.5; }
.no-address { flex: 1; font-size: 28rpx; color: #999; }
.arrow { font-size: 28rpx; color: #ccc; }
.item-list { display: flex; flex-direction: column; gap: 16rpx; }
.item-row { display: flex; align-items: center; gap: 16rpx; }
.item-img-wrap { width: 100rpx; height: 100rpx; border-radius: 8rpx; overflow: hidden; background-color: #f0f0f0; flex-shrink: 0; }
.item-img { width: 100%; height: 100%; }
.item-img-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #bbb; }
.item-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; overflow: hidden; }
.item-name { font-size: 28rpx; color: #222; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-qty { font-size: 24rpx; color: #999; }
.item-subtotal { font-size: 28rpx; color: #333; font-weight: 500; }
.row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.row:last-child { border-bottom: none; }
.row-label { font-size: 28rpx; color: #555; }
.row-value { font-size: 28rpx; color: #333; }
.free { color: #4caf50; }
.total-row { padding-top: 20rpx; }
.total-price { font-size: 36rpx; font-weight: bold; color: #e5441e; }
.remark-input { font-size: 28rpx; color: #333; text-align: right; flex: 1; }
.spacer { height: 140rpx; }
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.bottom-total { flex: 1; font-size: 36rpx; font-weight: bold; color: #e5441e; }
.submit-btn {
  background-color: #e5441e;
  color: #fff;
  font-size: 30rpx;
  padding: 0 48rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
}
.submit-btn.disabled { background-color: #ccc; }
