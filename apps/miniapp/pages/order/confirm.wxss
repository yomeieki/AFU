.page {
  background-color: var(--bg);
  padding-bottom: 140rpx;
}
.section {
  margin: 16rpx 24rpx 0;
  padding: 24rpx 30rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 16rpx;
}

/* Address */
.address-section {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.address-pin {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.address-info {
  flex: 1;
  overflow: hidden;
}
.receiver-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 10rpx;
}
.receiver-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
}
.receiver-phone {
  font-size: 28rpx;
  color: var(--text-2);
}
.address-full {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}
.no-address {
  flex: 1;
  font-size: 28rpx;
  color: var(--brand);
  border: 2rpx dashed var(--brand-light);
  border-radius: var(--radius-md);
  padding: 24rpx;
  text-align: center;
  background: var(--brand-bg);
}
.arrow {
  width: 28rpx;
  height: 28rpx;
  align-self: center;
}

/* Items */
.item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.item-img-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
}
.item-img {
  width: 100%;
  height: 100%;
}
.item-img-ph {
  width: 100%;
  height: 100%;
}
.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}
.item-name {
  font-size: 28rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-qty {
  font-size: 24rpx;
  color: var(--text-3);
}
.item-subtotal {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

/* Rows */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.row:last-child {
  border-bottom: none;
}
.row-label {
  font-size: 28rpx;
  color: var(--text-2);
}
.row-value {
  font-size: 28rpx;
  color: var(--text-1);
}
.free {
  color: var(--success);
}
.total-row {
  padding-top: 20rpx;
}
.total-price-wrap {
  display: flex;
  align-items: baseline;
}
.total-price-int {
  font-size: 40rpx;
}
.remark-input {
  font-size: 28rpx;
  color: var(--text-1);
  flex: 1;
}
.remark-placeholder {
  color: var(--text-disabled);
}

.spacer {
  height: 190rpx;
}

/* Bottom bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--card);
  border-top: 1rpx solid var(--divider);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 10rpx 24rpx 14rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  gap: 8rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.03);
}
.agree-row {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.4;
}
.agree-link {
  color: var(--brand);
}
.bottom-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.bottom-total-wrap {
  flex: 1;
  display: flex;
  align-items: baseline;
}
.bottom-total-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-right: 8rpx;
}
.bottom-total-int {
  font-size: 44rpx;
}
.submit-btn {
  padding: 0 48rpx;
}

.item-spec {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  align-self: flex-start;
}
