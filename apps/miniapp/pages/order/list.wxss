.page {
  background-color: var(--bg);
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* Tabs */
.tab-scroll {
  background-color: var(--card);
  width: 100%;
  white-space: nowrap;
  border-bottom: 1rpx solid var(--divider);
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-list {
  display: flex;
  flex-direction: row;
}
.tab-item {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.tab-item.active {
  color: var(--brand);
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--brand-gradient);
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}
.tip-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* Order card */
.order-list {
  padding: 20rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.order-card {
  padding: 24rpx;
}
.order-card-hover {
  transform: scale(0.99);
}
.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.order-meta {
  display: flex;
  align-items: center;
  min-width: 0;
}
.delivery-type-tag {
  flex-shrink: 0;
  margin-right: 10rpx;
  padding: 3rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  line-height: 1.4;
}
.delivery-type-tag.local {
  background: #fdf0ec;
  color: #e5441e;
}
.delivery-type-tag.express {
  background: #eef1fd;
  color: #3b5bdb;
}
.delivery-type-tag.pickup {
  background: #eef8f0;
  color: #16a34a;
}
.order-no {
  font-size: 24rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 状态标签改用 components/order-status-tag（预约送达 2026-09-21 §5.3：
   PAID 且预约单显示「已预约」，组件内部按 tag/tag-{status} 上色，与下面这套色值一一对应）。
   这条规则只补组件实例在 flex 行里的收缩行为，颜色/文案由组件自己决定。 */
order-status-tag {
  flex-shrink: 0;
}
.order-item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--divider);
  border-bottom: 1rpx solid var(--divider);
}
.order-item-img-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
}
.order-item-img {
  width: 100%;
  height: 100%;
}
.order-item-img-ph {
  width: 100%;
  height: 100%;
}
.order-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}
.order-item-name {
  font-size: 28rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-item-qty {
  font-size: 24rpx;
  color: var(--text-3);
}
.more-count {
  font-size: 24rpx;
  color: var(--text-3);
  flex-shrink: 0;
}
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.order-amount-wrap {
  display: flex;
  align-items: baseline;
}
.order-amount-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-right: 8rpx;
}
.order-amount-int {
  font-size: 34rpx;
}
.action-btn {
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
}
.action-btn.pay {
  background: var(--brand-gradient);
  color: #fff;
  font-weight: 500;
}

.order-item-spec {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  align-self: flex-start;
}

/* 待付款倒计时 */
.countdown-text {
  font-size: 22rpx;
  color: var(--warning, #ff9500);
  margin-right: 16rpx;
}
.order-action {
  display: flex;
  align-items: center;
}
/* 退款/售后附加信息 */
.order-extra {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border, #f0f0f0);
  font-size: 22rpx;
  color: var(--danger, #e5441e);
}
.footer-tip {
  padding: 24rpx 0 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}

/* 渠道范围条。两项等宽、贴在状态 Tab 之上——先选「哪一边的单」，再选「哪一类状态」。
   两项都用同一套选中样式，避免顾客把它误认成状态 Tab 的一部分。 */
.scope-bar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 0;
  background: var(--card);
}
.scope-item {
  flex: 1;
  min-width: 0;
  padding: 12rpx 0;
  border-radius: 999rpx;
  background: var(--divider);
  color: var(--text-2);
  font-size: 24rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.scope-item.active {
  background: var(--brand-bg);
  color: var(--brand);
  font-weight: 600;
}
