.page {
  background-color: var(--bg);
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* Tabs */
.tab-scroll {
  background-color: var(--card);
  width: 100%;
  white-space: nowrap;
  border-bottom: 1rpx solid var(--divider);
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-list {
  display: flex;
  flex-direction: row;
}
.tab-item {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.tab-item.active {
  color: var(--brand);
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--brand-gradient);
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}
.tip-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* Order card */
.order-list {
  padding: 20rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.order-card {
  padding: 24rpx;
}
.order-card-hover {
  transform: scale(0.99);
}
.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.order-no {
  font-size: 24rpx;
  color: var(--text-3);
}
.order-item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--divider);
  border-bottom: 1rpx solid var(--divider);
}
.order-item-img-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
}
.order-item-img {
  width: 100%;
  height: 100%;
}
.order-item-img-ph {
  width: 100%;
  height: 100%;
}
.order-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}
.order-item-name {
  font-size: 28rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-item-qty {
  font-size: 24rpx;
  color: var(--text-3);
}
.more-count {
  font-size: 24rpx;
  color: var(--text-3);
  flex-shrink: 0;
}
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.order-amount-wrap {
  display: flex;
  align-items: baseline;
}
.order-amount-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-right: 8rpx;
}
.order-amount-int {
  font-size: 34rpx;
}
.action-btn {
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
}
.action-btn.pay {
  background: var(--brand-gradient);
  color: #fff;
  font-weight: 500;
}

.order-item-spec {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  align-self: flex-start;
}
