.page { background-color: #f5f5f5; min-height: 100vh; }
.tab-scroll { background-color: #fff; width: 100%; white-space: nowrap; border-bottom: 1rpx solid #eee; }
.tab-list { display: flex; flex-direction: row; }
.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
  border-bottom: 4rpx solid transparent;
}
.tab-item.active { color: #e5441e; border-bottom-color: #e5441e; font-weight: 500; }
.loading-wrap, .empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}
.tip-text, .empty-text { font-size: 28rpx; color: #999; }
.order-list { padding: 16rpx; display: flex; flex-direction: column; gap: 16rpx; }
.order-card { background-color: #fff; border-radius: 12rpx; padding: 24rpx; }
.order-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.order-no { font-size: 24rpx; color: #999; }
.order-status { font-size: 26rpx; font-weight: 500; }
.order-status.PENDING_PAYMENT { color: #ff9800; }
.order-status.PAID { color: #4a90e2; }
.order-status.SHIPPED { color: #9c27b0; }
.order-status.COMPLETED { color: #4caf50; }
.order-status.CANCELLED { color: #999; }
.order-item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
}
.order-item-img-wrap { width: 100rpx; height: 100rpx; border-radius: 8rpx; overflow: hidden; background-color: #f0f0f0; flex-shrink: 0; }
.order-item-img { width: 100%; height: 100%; }
.order-item-img-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #bbb; }
.order-item-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; overflow: hidden; }
.order-item-name { font-size: 28rpx; color: #222; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.order-item-qty { font-size: 24rpx; color: #999; }
.more-count { font-size: 24rpx; color: #999; flex-shrink: 0; }
.order-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.order-amount { font-size: 28rpx; color: #333; }
.action-btn { font-size: 26rpx; border-radius: 30rpx; padding: 10rpx 28rpx; }
.action-btn.pay { background-color: #e5441e; color: #fff; }
