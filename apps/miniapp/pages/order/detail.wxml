<wxs src="../../utils/price.wxs" module="pricefmt" />
<view class="page" wx:if="{{!loading && order}}">

  <!-- Status banner -->
  <view class="status-banner {{order.status}}">
    <text class="status-label">{{order.statusLabel}}</text>
    <text wx:if="{{order.status === 'PENDING_PAYMENT' && countdown}}" class="status-deadline">请在 {{order.payDeadlineText}} 前完成支付，超时订单自动取消</text>
    <text class="status-order-no">{{order.orderNo}}</text>
  </view>

  <!-- Address -->
  <view class="card">
    <view class="address-row">
      <view class="address-pin icon icon-pin"></view>
      <view class="address-body">
        <view class="receiver-row">
          <text class="receiver-name">{{order.receiverName}}</text>
          <text class="receiver-phone">{{order.receiverPhone}}</text>
        </view>
        <text class="receiver-address">{{order.receiverFullAddress}}</text>
      </view>
    </view>
  </view>

  <!-- 同城配送：不使用原生 map，以静态路线示意和文字距离展示进度。 -->
  <view class="card" wx:if="{{order.isLocal}}">
    <view class="card-title">同城配送信息</view>
    <view class="info-row">
      <text class="info-label">收货地点</text>
      <view class="info-value local-address-value">
        <text wx:if="{{order.receiverPoiName}}">{{order.receiverPoiName}} · </text>
        <text>{{order.receiverFullAddress}}</text>
      </view>
    </view>
    <view class="info-row">
      <text class="info-label">配送距离</text>
      <text class="info-value">距门店 {{order.distanceText}} km</text>
    </view>
    <view class="info-row">
      <text class="info-label">预计送达</text>
      <text class="info-value">{{order.estimatedDeliveryText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">配送费</text>
      <text class="info-value">¥{{order.shippingFeeText}}</text>
    </view>
    <view class="delivery-status" wx:if="{{order.deliveryStatusLabel}}">
      <text>{{order.deliveryStatusLabel}}</text>
      <text class="delivery-neutral-hint" wx:if="{{order.deliveryNeutralHint}}">{{order.deliveryNeutralHint}}</text>
    </view>
  </view>

  <view class="card courier-card" wx:if="{{order.showCourierCard}}">
    <view class="card-title">骑手信息</view>
    <view class="courier-row">
      <view class="courier-info">
        <text class="courier-name">{{order.delivery.courierName || '骑手'}}</text>
        <text class="courier-company">{{order.delivery.courierCompany || ''}}</text>
      </view>
      <view class="courier-contact" wx:if="{{order.delivery.courierMobile}}" bindtap="onContactCourier">联系骑手</view>
    </view>
  </view>

  <view class="card courier-route-card" wx:if="{{order.isLocal && courierLoc && storeLoc}}">
    <view class="card-title">骑手位置</view>
    <cover-view class="courier-route">
      <cover-view class="route-line"></cover-view>
      <cover-view class="route-stop route-store"><cover-view class="route-dot"></cover-view><cover-view>门店</cover-view></cover-view>
      <cover-view class="route-stop route-receiver"><cover-view class="route-dot"></cover-view><cover-view>收货点</cover-view></cover-view>
      <cover-view class="route-rider"><cover-view class="route-rider-dot"></cover-view><cover-view>骑手</cover-view></cover-view>
    </cover-view>
    <text class="courier-route-distance">距门店 {{order.distanceText}} km</text>
  </view>

  <view class="card local-cancel-card" wx:if="{{order.isLocal && (order.canRequestCancel || order.cancelRequestedAt || order.showLocalCancelUnavailable)}}">
    <view class="local-cancel-submitted" wx:if="{{order.cancelRequestedAt}}">取消申请已提交，商家会尽快处理</view>
    <view wx:elif="{{order.canRequestCancel}}">
      <text class="local-cancel-title">可申请取消</text>
      <text class="local-cancel-copy">接单后 {{graceMin}} 分钟内可申请取消（截止 {{order.localCancelDeadlineText}}）</text>
    </view>
    <view class="local-cancel-unavailable" wx:else>订单已开始制作，如有问题请联系商家</view>
  </view>

  <!-- Items -->
  <view class="card">
    <view class="card-title">商品信息</view>
    <view class="item-list">
      <view wx:for="{{order.items}}" wx:key="id" class="item-row">
        <view class="item-img-wrap">
          <image wx:if="{{item.productImage}}" class="item-img" src="{{item.productImage}}" mode="aspectFill"/>
          <view wx:else class="item-img-ph img-placeholder"></view>
        </view>
        <view class="item-info">
          <text class="item-name">{{item.productName}}</text>
          <text class="item-spec" wx:if="{{item.specText}}">{{item.specText}}</text>
          <text class="item-price">¥{{item.priceText}} × {{item.quantity}}</text>
        </view>
        <text class="item-subtotal">¥{{item.subtotalText}}</text>
      </view>
    </view>
  </view>

  <!-- Amount -->
  <view class="card">
    <view class="amount-row">
      <text class="amount-label">商品金额</text>
      <text class="amount-value">¥{{order.totalAmountText}}</text>
    </view>
    <view class="amount-row">
      <text class="amount-label">运费</text>
      <text class="amount-value">{{order.shippingFee === 0 ? '免运费' : '¥' + order.shippingFeeText}}</text>
    </view>
    <view class="amount-row" wx:if="{{order.refundedAmount > 0}}">
      <text class="amount-label">已退款</text>
      <text class="amount-value refunded">-¥{{order.refundedAmountText}}</text>
    </view>
    <view class="amount-row total-row">
      <text class="amount-label">合计</text>
      <view class="total-price-wrap">
        <text class="price-symbol">¥</text>
        <text class="price-int total-price-int">{{pricefmt.int(order.actualAmountText)}}</text>
        <text class="price-dec">{{pricefmt.dec(order.actualAmountText)}}</text>
      </view>
    </view>
  </view>

  <!-- Order info -->
  <view class="card">
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{order.orderNo}}</text>
    </view>
    <view class="info-row" wx:if="{{order.remark}}">
      <text class="info-label">备注</text>
      <text class="info-value">{{order.remark}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{order.createdAtText}}</text>
    </view>
    <view class="info-row" wx:if="{{order.paidAtText}}">
      <text class="info-label">支付时间</text>
      <text class="info-value">{{order.paidAtText}}</text>
    </view>
  </view>

  <!-- 售后申请 -->
  <view class="card" wx:if="{{order.afterSale}}">
    <view class="card-title">售后申请</view>
    <view class="info-row">
      <text class="info-label">状态</text>
      <text class="info-value after-sale-status {{order.afterSale.status}}">{{order.afterSale.statusLabel}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">原因</text>
      <text class="info-value">{{order.afterSale.reasonLabel}}</text>
    </view>
    <view class="info-row" wx:if="{{order.afterSale.description}}">
      <text class="info-label">说明</text>
      <text class="info-value">{{order.afterSale.description}}</text>
    </view>
    <view class="after-sale-images" wx:if="{{order.afterSale.images.length > 0}}">
      <image
        wx:for="{{order.afterSale.images}}"
        wx:key="*this"
        class="after-sale-img"
        src="{{item}}"
        mode="aspectFill"
        data-url="{{item}}"
        bindtap="onPreviewImage"
      />
    </view>
    <view class="info-row" wx:if="{{order.afterSale.reply}}">
      <text class="info-label">商家回复</text>
      <text class="info-value reply">{{order.afterSale.reply}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">申请时间</text>
      <text class="info-value">{{order.afterSale.timeText}}</text>
    </view>
  </view>

  <!-- 退款记录 -->
  <view class="card" wx:if="{{order.refunds.length > 0}}">
    <view class="card-title">退款记录</view>
    <view wx:for="{{order.refunds}}" wx:key="id" class="refund-row">
      <view class="refund-main">
        <text class="refund-amount">¥{{item.amountText}}</text>
        <text class="refund-status {{item.status}}">{{item.statusLabel}}</text>
      </view>
      <text class="refund-meta">{{item.reason ? item.reason + ' · ' : ''}}{{item.timeText}}</text>
    </view>
  </view>

  <!-- 订单进度时间线 -->
  <view class="card" wx:if="{{order.timeline && order.timeline.length > 0}}">
    <view class="card-title">订单进度</view>
    <view class="timeline">
      <view
        wx:for="{{order.timeline}}"
        wx:key="label"
        class="timeline-step {{item.done ? 'done' : ''}} {{index === order.timeline.length - 1 ? 'last' : ''}}"
      >
        <view class="timeline-dot-col">
          <view class="timeline-dot"></view>
          <view wx:if="{{index !== order.timeline.length - 1}}" class="timeline-line"></view>
        </view>
        <view class="timeline-info">
          <text class="timeline-label">{{item.label}}</text>
          <text wx:if="{{item.extra}}" class="timeline-extra">{{item.extra}}</text>
          <text wx:if="{{item.time}}" class="timeline-time">{{item.time}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Shipment -->
  <view class="card" wx:if="{{!order.isLocal && order.shipment}}">
    <view class="card-title">物流信息</view>
    <view class="info-row">
      <text class="info-label">快递公司</text>
      <text class="info-value">{{order.shipment.expressCompany}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">快递单号</text>
      <text class="info-value">{{order.shipment.expressNo}}</text>
    </view>
    <view class="info-row" wx:if="{{order.shipment.remark}}">
      <text class="info-label">商家备注</text>
      <text class="info-value">{{order.shipment.remark}}</text>
    </view>
  </view>

  <view class="spacer"></view>
</view>

<view wx:if="{{loading}}" class="loading-page">
  <text class="loading-text">加载中...</text>
</view>

<!-- Bottom action bar：联系商家常驻；其余按状态 -->
<view class="action-bar" wx:if="{{!loading && order}}">
  <view class="cancel-btn" bindtap="onContactShop">
    <text>联系商家</text>
  </view>
  <view class="cancel-btn" wx:if="{{order.canSelfCancel}}" bindtap="onCancelOrder">
    <text>{{order.status === 'PENDING_PAYMENT' ? '取消订单' : '申请退款'}}</text>
  </view>
  <view class="cancel-btn" wx:if="{{order.isLocal && order.canRequestCancel}}" bindtap="onRequestCancel">
    <text>申请取消</text>
  </view>
  <view class="cancel-btn" wx:if="{{order.canApplyAfterSale}}" bindtap="onApplyAfterSale">
    <text>申请售后</text>
  </view>
  <view class="pay-btn btn-primary {{countdown ? 'pay-btn-with-countdown' : ''}}" wx:if="{{order.status === 'PENDING_PAYMENT'}}" bindtap="onPay">
    <text>去支付</text>
    <text wx:if="{{countdown}}" class="pay-btn-countdown">{{countdown}}</text>
  </view>
  <view class="pay-btn btn-primary" wx:if="{{order.status === 'SHIPPED'}}" bindtap="onConfirmReceipt">
    <text>确认收货</text>
  </view>
</view>
