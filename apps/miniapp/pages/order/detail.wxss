.page {
  background-color: var(--bg);
  padding-bottom: 130rpx;
}

/* 状态横幅：浅底色 + 状态色大字 */
.status-banner {
  padding: 44rpx 34rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.status-banner.PENDING_PAYMENT { background-color: var(--warning-bg); }
.status-banner.PENDING_PAYMENT .status-label { color: var(--warning); }
.status-banner.PAID { background-color: var(--info-bg); }
.status-banner.PAID .status-label { color: var(--info); }
.status-banner.REFUNDING { background-color: var(--danger-bg); }
.status-banner.REFUNDING .status-label { color: var(--danger); }
.status-banner.REFUNDED { background-color: var(--gray-bg); }
.status-banner.REFUNDED .status-label { color: var(--gray); }
.status-banner.PREPARING { background-color: var(--warning-bg); }
.status-banner.PREPARING .status-label { color: var(--warning); }
.status-banner.SHIPPED { background-color: var(--cyan-bg); }
.status-banner.SHIPPED .status-label { color: var(--cyan); }
.status-banner.COMPLETED { background-color: var(--success-bg); }
.status-banner.COMPLETED .status-label { color: var(--success); }
.status-banner.CANCELLED { background-color: var(--gray-bg); }
.status-banner.CANCELLED .status-label { color: var(--gray); }
.status-banner.REFUNDED { background-color: var(--danger-bg); }
.status-banner.REFUNDED .status-label { color: var(--danger); }
.status-label {
  font-size: 42rpx;
  font-weight: bold;
}
.status-order-no {
  font-size: 24rpx;
  color: var(--text-3);
}

/* Card */
.card {
  margin: 16rpx 24rpx 0;
  padding: 24rpx 30rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--divider);
}

/* Address */
.address-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.address-pin {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.address-body {
  flex: 1;
  overflow: hidden;
}
.receiver-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 10rpx;
}
.receiver-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
}
.receiver-phone {
  font-size: 28rpx;
  color: var(--text-2);
}
.receiver-address {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}

/* Items */
.item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.item-img-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
}
.item-img {
  width: 100%;
  height: 100%;
}
.item-img-ph {
  width: 100%;
  height: 100%;
}
.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}
.item-name {
  font-size: 28rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-price {
  font-size: 24rpx;
  color: var(--text-3);
}
.item-subtotal {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

/* Amount */
.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.amount-row:last-child {
  border-bottom: none;
}
.amount-label {
  font-size: 28rpx;
  color: var(--text-2);
}
.amount-value {
  font-size: 28rpx;
  color: var(--text-1);
}
.total-row {
  padding-top: 16rpx;
}
.total-price-wrap {
  display: flex;
  align-items: baseline;
}
.total-price-int {
  font-size: 40rpx;
}

/* Info rows */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--divider);
  gap: 20rpx;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: var(--text-3);
  flex-shrink: 0;
}
.info-value {
  font-size: 26rpx;
  color: var(--text-2);
  text-align: right;
  flex: 1;
}
.local-address-value {
  line-height: 1.5;
}

/* 同城配送 */
.delivery-status {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 18rpx;
  font-size: 28rpx;
  color: var(--brand-600, #c2410c);
}
.delivery-neutral-hint {
  font-size: 24rpx;
  color: var(--text-3);
}
.courier-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.courier-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.courier-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
.courier-company {
  font-size: 24rpx;
  color: var(--text-3);
}
.courier-contact {
  padding: 12rpx 22rpx;
  border: 2rpx solid var(--brand);
  border-radius: 999rpx;
  color: var(--brand);
  font-size: 26rpx;
  flex-shrink: 0;
}
.courier-route {
  position: relative;
  height: 150rpx;
  margin: 8rpx 10rpx 0;
  background: var(--bg);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.route-line {
  position: absolute;
  left: 18%;
  right: 18%;
  top: 70rpx;
  height: 6rpx;
  background: var(--brand-bg-deep);
}
.route-stop, .route-rider {
  position: absolute;
  top: 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-2);
}
.route-store { left: 10%; }
.route-receiver { right: 10%; }
.route-dot, .route-rider-dot {
  width: 22rpx;
  height: 22rpx;
  margin-bottom: 8rpx;
  border-radius: 50%;
  background: var(--brand);
}
.route-rider {
  left: 48%;
  top: 14rpx;
  color: var(--brand-600, #c2410c);
}
.route-rider-dot { background: var(--warning); }
.courier-route-distance {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}
.local-cancel-submitted, .local-cancel-unavailable {
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-2);
}
.local-cancel-submitted {
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--gray-bg);
  color: var(--text-3);
}
.local-cancel-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 600;
}
.local-cancel-copy {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.spacer {
  height: 130rpx;
}
.loading-page {
  height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* Action bar */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--card);
  border-top: 1rpx solid var(--divider);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
}
.pay-btn {
  padding: 0 60rpx;
}

.item-spec {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  align-self: flex-start;
}


/* 订单进度时间线 */
.timeline {
  padding: 8rpx 0 0;
}
.timeline-step {
  display: flex;
  align-items: flex-start;
}
.timeline-dot-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  flex-shrink: 0;
}
.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 4rpx solid var(--border);
  background: var(--card);
  box-sizing: border-box;
  margin-top: 6rpx;
}
.timeline-step.done .timeline-dot {
  border-color: var(--brand);
  background: var(--brand);
}
.timeline-line {
  width: 4rpx;
  flex: 1;
  min-height: 40rpx;
  background: var(--divider);
}
.timeline-step.done .timeline-line {
  background: var(--brand-bg-deep);
}
.timeline-info {
  flex: 1;
  padding: 0 0 28rpx 16rpx;
  display: flex;
  flex-direction: column;
}
.timeline-step.last .timeline-info {
  padding-bottom: 4rpx;
}
.timeline-label {
  font-size: 28rpx;
  color: var(--text-3);
}
.timeline-step.done .timeline-label {
  color: var(--text-1);
  font-weight: 500;
}
.timeline-extra {
  font-size: 24rpx;
  color: var(--info);
  margin-top: 4rpx;
}
.timeline-time {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}


/* 自助取消/申请退款按钮（次级样式） */
.cancel-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 2rpx solid var(--border);
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--text-2);
}

/* 待付款倒计时 */
/* 待付款：支付截止提示（横幅第二行） */
.status-deadline {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #b45309;
  line-height: 1.4;
}
/* 去支付按钮内嵌倒计时（两行） */
.pay-btn-with-countdown {
  flex-direction: column;
  gap: 2rpx;
  height: 96rpx;
  line-height: 1.1;
}
.pay-btn-countdown {
  font-size: 22rpx;
  font-weight: 500;
  opacity: 0.92;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}
/* 已退款金额 */
.amount-value.refunded {
  color: var(--danger);
}
/* 售后 */
.after-sale-status.PENDING, .after-sale-status.APPROVED { color: var(--warning); }
.after-sale-status.DONE { color: var(--success, #16a34a); }
.after-sale-status.REJECTED { color: var(--text-3); }
.info-value.reply { color: var(--brand-600, #c2410c); }
.after-sale-images {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 0;
}
.after-sale-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md, 12rpx);
  background: var(--bg);
}
/* 退款记录 */
.refund-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.refund-row:last-child { border-bottom: none; }
.refund-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.refund-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
.refund-status {
  font-size: 24rpx;
  color: var(--warning);
}
.refund-status.SUCCESS { color: var(--success, #16a34a); }
.refund-status.CLOSED, .refund-status.FAILED { color: var(--danger); }
.refund-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
