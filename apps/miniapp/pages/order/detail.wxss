.page {
  background-color: var(--bg);
  padding-bottom: 130rpx;
}

/* 状态横幅：浅底色 + 状态色大字 */
.status-banner {
  padding: 44rpx 34rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.status-banner.PENDING_PAYMENT { background-color: var(--warning-bg); }
.status-banner.PENDING_PAYMENT .status-label { color: var(--warning); }
.status-banner.PAID { background-color: var(--info-bg); }
.status-banner.PAID .status-label { color: var(--info); }
.status-banner.REFUNDING { background-color: var(--danger-bg); }
.status-banner.REFUNDING .status-label { color: var(--danger); }
.status-banner.REFUNDED { background-color: var(--gray-bg); }
.status-banner.REFUNDED .status-label { color: var(--gray); }
.status-banner.PREPARING { background-color: var(--warning-bg); }
.status-banner.PREPARING .status-label { color: var(--warning); }
.status-banner.SHIPPED { background-color: var(--cyan-bg); }
.status-banner.SHIPPED .status-label { color: var(--cyan); }
.status-banner.COMPLETED { background-color: var(--success-bg); }
.status-banner.COMPLETED .status-label { color: var(--success); }
.status-banner.CANCELLED { background-color: var(--gray-bg); }
.status-banner.CANCELLED .status-label { color: var(--gray); }
.status-banner.REFUNDED { background-color: var(--danger-bg); }
.status-banner.REFUNDED .status-label { color: var(--danger); }
.status-label {
  font-size: 42rpx;
  font-weight: bold;
}
.status-order-no {
  font-size: 24rpx;
  color: var(--text-3);
}

/* Card */
.card {
  margin: 16rpx 24rpx 0;
  padding: 24rpx 30rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--divider);
}

/* Address */
.address-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.address-pin {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.address-body {
  flex: 1;
  overflow: hidden;
}
.receiver-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 10rpx;
}
.receiver-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
}
.receiver-phone {
  font-size: 28rpx;
  color: var(--text-2);
}
.receiver-address {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}

/* Items */
.item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.item-img-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
}
.item-img {
  width: 100%;
  height: 100%;
}
.item-img-ph {
  width: 100%;
  height: 100%;
}
.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}
.item-name {
  font-size: 28rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-price {
  font-size: 24rpx;
  color: var(--text-3);
}
.item-subtotal {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

/* Amount */
.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.amount-row:last-child {
  border-bottom: none;
}
.amount-label {
  font-size: 28rpx;
  color: var(--text-2);
}
.amount-value {
  font-size: 28rpx;
  color: var(--text-1);
}
.total-row {
  padding-top: 16rpx;
}
.total-price-wrap {
  display: flex;
  align-items: baseline;
}
.total-price-int {
  font-size: 40rpx;
}

/* Info rows */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--divider);
  gap: 20rpx;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: var(--text-3);
  flex-shrink: 0;
}
.info-value {
  font-size: 26rpx;
  color: var(--text-2);
  text-align: right;
  flex: 1;
}

.spacer {
  height: 130rpx;
}
.loading-page {
  height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* Action bar */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--card);
  border-top: 1rpx solid var(--divider);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
}
.pay-btn {
  padding: 0 60rpx;
}

.item-spec {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  align-self: flex-start;
}


/* 订单进度时间线 */
.timeline {
  padding: 8rpx 0 0;
}
.timeline-step {
  display: flex;
  align-items: flex-start;
}
.timeline-dot-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  flex-shrink: 0;
}
.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 4rpx solid var(--border);
  background: var(--card);
  box-sizing: border-box;
  margin-top: 6rpx;
}
.timeline-step.done .timeline-dot {
  border-color: var(--brand);
  background: var(--brand);
}
.timeline-line {
  width: 4rpx;
  flex: 1;
  min-height: 40rpx;
  background: var(--divider);
}
.timeline-step.done .timeline-line {
  background: var(--brand-bg-deep);
}
.timeline-info {
  flex: 1;
  padding: 0 0 28rpx 16rpx;
  display: flex;
  flex-direction: column;
}
.timeline-step.last .timeline-info {
  padding-bottom: 4rpx;
}
.timeline-label {
  font-size: 28rpx;
  color: var(--text-3);
}
.timeline-step.done .timeline-label {
  color: var(--text-1);
  font-weight: 500;
}
.timeline-extra {
  font-size: 24rpx;
  color: var(--info);
  margin-top: 4rpx;
}
.timeline-time {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}


/* 自助取消/申请退款按钮（次级样式） */
.cancel-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 2rpx solid var(--border);
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--text-2);
}
