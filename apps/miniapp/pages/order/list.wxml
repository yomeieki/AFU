<wxs src="../../utils/price.wxs" module="pricefmt" />
<view class="page">

  <!-- Tabs -->
  <scroll-view scroll-x class="tab-scroll" show-scrollbar="{{false}}">
    <view class="tab-list">
      <view
        wx:for="{{tabs}}"
        wx:key="index"
        class="tab-item {{activeTab === index ? 'active' : ''}}"
        bindtap="onTabChange"
        data-idx="{{index}}"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="tip-text">加载中...</text>
  </view>

  <empty-state wx:elif="{{orders.length === 0}}" type="order" text="暂无订单" />

  <view wx:else class="order-list">
    <view
      wx:for="{{orders}}"
      wx:key="id"
      class="order-card card"
      hover-class="order-card-hover"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="order-header">
        <view class="order-meta">
          <text class="delivery-type-tag {{item.deliveryType === 'LOCAL' ? 'local' : 'express'}}">{{item.deliveryType === 'LOCAL' ? '同城' : '邮寄'}}</text>
          <text class="order-no">订单号：{{item.orderNo}}</text>
        </view>
        <text class="order-status-tag order-status-{{item.status}}">{{item.statusLabel}}</text>
      </view>

      <view class="order-item-row" wx:if="{{item.firstItem}}">
        <view class="order-item-img-wrap">
          <image
            wx:if="{{item.firstItem.productImage}}"
            class="order-item-img"
            src="{{item.firstItem.productImage}}"
            mode="aspectFill"
          />
          <view wx:else class="order-item-img-ph img-placeholder"></view>
        </view>
        <view class="order-item-info">
          <text class="order-item-name">{{item.firstItem.productName}}</text>
          <text class="order-item-spec" wx:if="{{item.firstItem.specText}}">{{item.firstItem.specText}}</text>
          <text class="order-item-qty">× {{item.firstItem.quantity}}</text>
        </view>
        <text wx:if="{{item.moreCount > 0}}" class="more-count">等{{item.moreCount + 1}}件</text>
      </view>

      <view class="order-footer">
        <view class="order-amount-wrap">
          <!-- 合计仍是实付，「已用券」只解释它为什么比商品金额小。
               外层沿用 order-amount-label 只为它的右间距与基线对齐（list.wxss 不在本次可改文件内）。 -->
          <view class="order-amount-label" wx:if="{{item.discountAmount > 0}}"><text class="order-item-spec">已用券</text></view>
          <text class="order-amount-label">合计</text>
          <text class="price-symbol">¥</text>
          <text class="price-int order-amount-int">{{pricefmt.int(item.actualAmountText)}}</text>
          <text class="price-dec">{{pricefmt.dec(item.actualAmountText)}}</text>
        </view>
        <view class="order-action">
          <text wx:if="{{item.status === 'PENDING_PAYMENT' && item.countdown}}" class="countdown-text">剩余 {{item.countdown}} 自动取消</text>
          <text wx:if="{{item.status === 'PENDING_PAYMENT'}}" class="action-btn pay">去支付</text>
        </view>
      </view>
      <view class="order-extra" wx:if="{{item.extraText}}">
        <text>{{item.extraText}}</text>
      </view>
    </view>
    <view class="footer-tip" wx:if="{{loadingMore}}"><text>加载中...</text></view>
    <view class="footer-tip" wx:elif="{{!hasMore && orders.length > 0}}"><text>- 没有更多了 -</text></view>
  </view>

</view>
