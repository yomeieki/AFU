.page {
  background-color: var(--bg);
  min-height: 100vh;
  padding-bottom: 150rpx;
  box-sizing: border-box;
}

/* Card */
.card {
  margin: 16rpx 24rpx 0;
  padding: 24rpx 30rpx;
}
.card:first-child {
  margin-top: 20rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 20rpx;
}
.required {
  color: var(--brand);
  margin-left: 4rpx;
}
.optional {
  font-size: 24rpx;
  font-weight: normal;
  color: var(--text-3);
  margin-left: 4rpx;
}

/* 订单摘要 */
.order-no-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--divider);
}
.order-no-label {
  font-size: 24rpx;
  color: var(--text-3);
}
.order-no {
  font-size: 24rpx;
  color: var(--text-2);
}
.order-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 20rpx;
}
.order-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.order-item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-item-spec {
  font-size: 24rpx;
  color: var(--text-3);
}
.order-item-qty {
  font-size: 24rpx;
  color: var(--text-2);
}
.order-amount {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}
.order-amount-label {
  font-size: 24rpx;
  color: var(--text-3);
  margin-right: 8rpx;
}
.order-amount-int {
  font-size: 36rpx;
}

/* 原因 chips */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.chip {
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background-color: var(--bg);
  border: 2rpx solid transparent;
  border-radius: 999rpx;
}
.chip-hover {
  opacity: 0.8;
}
.chip.active {
  color: var(--brand);
  background-color: var(--brand-bg);
  border-color: var(--brand);
  font-weight: 500;
}

/* 说明 textarea */
.desc-input {
  width: 100%;
  height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-1);
  background-color: var(--bg);
  border-radius: var(--radius-md);
}
.desc-placeholder {
  color: var(--text-disabled);
}
.desc-counter {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 图片九宫格 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.img-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background-color: var(--bg);
}
.img-thumb {
  width: 100%;
  height: 100%;
  display: block;
}
.img-uploading {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background-color: rgba(0, 0, 0, 0.45);
}
.img-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: img-spin 0.8s linear infinite;
}
@keyframes img-spin {
  to { transform: rotate(360deg); }
}
.img-uploading-text {
  font-size: 22rpx;
  color: #fff;
}
.img-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  background-color: rgba(0, 0, 0, 0.55);
  border-radius: 0 0 0 var(--radius-md);
}
.img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: 2rpx dashed var(--text-disabled);
  box-sizing: border-box;
}
.img-add-hover {
  background-color: var(--divider);
}
.img-add-plus {
  font-size: 56rpx;
  line-height: 1;
  color: var(--text-disabled);
}
.img-add-text {
  font-size: 22rpx;
  color: var(--text-3);
}
.img-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.spacer {
  height: 20rpx;
}

/* 底部固定提交栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx;
  background-color: var(--card);
  border-top: 1rpx solid var(--divider);
  z-index: 20;
}
.submit-btn {
  height: 88rpx;
}
