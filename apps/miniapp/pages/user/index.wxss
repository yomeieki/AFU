.page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* User header */
.user-header {
  background: linear-gradient(135deg, #e5441e 0%, #ff7043 100%);
  padding: 60rpx 40rpx 50rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 30rpx;
}
.avatar-wrap {
  flex-shrink: 0;
}
.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-icon {
  font-size: 60rpx;
}
.user-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}
.login-btn {
  background-color: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
  padding: 6rpx 28rpx;
  border: none;
  width: fit-content;
}
.login-btn::after {
  border: none;
}

/* Menu section */
.menu-section {
  background-color: #fff;
  margin-top: 20rpx;
}
.menu-title {
  padding: 20rpx 30rpx 12rpx;
  font-size: 26rpx;
  color: #999;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-list {
  display: flex;
  flex-direction: column;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 20rpx;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-icon {
  font-size: 36rpx;
  width: 50rpx;
  text-align: center;
}
.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}
.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}
