.page {
  background-color: var(--bg);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* User header */
.user-header {
  position: relative;
  background: var(--brand-gradient);
  padding: 70rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
/* 头像 + 昵称原来那一行：整条积分/券条要落在它下面，所以头部改成竖排、这里包一层横排 */
.user-header-main {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 30rpx;
}
.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.header-deco-1 {
  width: 300rpx;
  height: 300rpx;
  top: -150rpx;
  right: -60rpx;
}
.header-deco-2 {
  width: 140rpx;
  height: 140rpx;
  bottom: -50rpx;
  left: 40%;
}
.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}
.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  box-sizing: border-box;
}
.avatar-placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-icon {
  font-size: 60rpx;
}
.user-info {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}
.login-btn {
  background-color: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 8rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  width: fit-content;
}

/* 积分/券入口条（页头卡内，压在品牌渐变上，所以用半透明白而不是 --card） */
.member-bar {
  position: relative;
  margin-top: 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}
.member-cell {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
  padding: 24rpx 12rpx;
}
.member-cell-hover {
  opacity: 0.7;
}
.member-cell-divider {
  width: 1rpx;
  height: 44rpx;
  background-color: rgba(255, 255, 255, 0.4);
}
.member-cell-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}
.member-cell-value {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}
.member-cell-arrow {
  font-size: 30rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.8);
}
/* 未登录：整条一格，点哪都走 onLogin */
.member-bar-guest {
  justify-content: center;
  gap: 10rpx;
  padding: 24rpx 12rpx;
}
.member-guest-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* Menu section */
.menu-section {
  margin: 20rpx 24rpx 0;
}
.menu-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx 16rpx;
  border-bottom: 1rpx solid var(--divider);
}
.menu-section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
}
.menu-section-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-3);
}
.more-arrow {
  width: 26rpx;
  height: 26rpx;
}

/* Order shortcuts */
.order-shortcuts {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  padding: 30rpx 0 28rpx;
}
.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.shortcut-item-hover {
  opacity: 0.7;
}
.shortcut-icon {
  width: 52rpx;
  height: 52rpx;
}
.shortcut-label {
  font-size: 24rpx;
  color: var(--text-2);
}

/* Menu list */
.menu-list {
  display: flex;
  flex-direction: column;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--divider);
  gap: 20rpx;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item-hover {
  background-color: var(--bg);
}
.menu-icon {
  width: 40rpx;
  height: 40rpx;
}
.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-1);
}
.menu-arrow {
  width: 28rpx;
  height: 28rpx;
}
