<view class="page">

  <!-- User header -->
  <view class="user-header">
    <view class="avatar-wrap">
      <image wx:if="{{isLoggedIn && avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">
        <text class="avatar-icon">👤</text>
      </view>
    </view>
    <view class="user-info">
      <text wx:if="{{isLoggedIn}}" class="user-name">{{nickname}}</text>
      <text wx:else class="user-name">未登录</text>
      <button wx:if="{{!isLoggedIn}}" class="login-btn" bindtap="onLogin">点击登录</button>
    </view>
  </view>

  <!-- Order shortcuts -->
  <view class="menu-section">
    <view class="menu-section-header">
      <text class="menu-section-title">我的订单</text>
      <text class="menu-section-more" bindtap="goToOrders">全部订单 &gt;</text>
    </view>
    <view class="order-shortcuts">
      <view class="shortcut-item" bindtap="goToOrdersByStatus" data-status="PENDING_PAYMENT">
        <text class="shortcut-icon">💳</text>
        <text class="shortcut-label">待付款</text>
      </view>
      <view class="shortcut-item" bindtap="goToOrdersByStatus" data-status="PAID">
        <text class="shortcut-icon">📦</text>
        <text class="shortcut-label">待发货</text>
      </view>
      <view class="shortcut-item" bindtap="goToOrdersByStatus" data-status="SHIPPED">
        <text class="shortcut-icon">🚚</text>
        <text class="shortcut-label">已发货</text>
      </view>
      <view class="shortcut-item" bindtap="goToOrdersByStatus" data-status="COMPLETED">
        <text class="shortcut-icon">✅</text>
        <text class="shortcut-label">已完成</text>
      </view>
    </view>
  </view>

  <!-- More menu -->
  <view class="menu-section">
    <view class="menu-list">
      <view class="menu-item" bindtap="goToAddresses">
        <text class="menu-icon">📍</text>
        <text class="menu-label">收货地址</text>
        <text class="menu-arrow">&gt;</text>
      </view>
    </view>
  </view>

</view>
