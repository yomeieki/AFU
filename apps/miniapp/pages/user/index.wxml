<view class="page">

  <!-- User header -->
  <view class="user-header">
    <view class="header-deco header-deco-1"></view>
    <view class="header-deco header-deco-2"></view>
    <view class="avatar-wrap">
      <image wx:if="{{isLoggedIn && avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">
        <text class="avatar-icon">👤</text>
      </view>
    </view>
    <view class="user-info">
      <text wx:if="{{isLoggedIn}}" class="user-name">{{nickname}}</text>
      <text wx:else class="user-name">未登录</text>
      <button wx:if="{{!isLoggedIn}}" class="login-btn" bindtap="onLogin">点击登录</button>
    </view>
  </view>

  <!-- Order shortcuts -->
  <view class="menu-section card">
    <view class="menu-section-header">
      <text class="menu-section-title">我的订单</text>
      <view class="menu-section-more" bindtap="goToOrders">
        <text>全部订单</text>
        <view class="more-arrow icon icon-arrow"></view>
      </view>
    </view>
    <view class="order-shortcuts">
      <view class="shortcut-item" hover-class="shortcut-item-hover" bindtap="goToOrdersByStatus" data-status="PENDING_PAYMENT">
        <view class="shortcut-icon icon icon-pay"></view>
        <text class="shortcut-label">待付款</text>
      </view>
      <view class="shortcut-item" hover-class="shortcut-item-hover" bindtap="goToOrdersByStatus" data-status="PAID,PREPARING">
        <view class="shortcut-icon icon icon-ship"></view>
        <text class="shortcut-label">待发货</text>
      </view>
      <view class="shortcut-item" hover-class="shortcut-item-hover" bindtap="goToOrdersByStatus" data-status="SHIPPED">
        <view class="shortcut-icon icon icon-truck"></view>
        <text class="shortcut-label">已发货</text>
      </view>
      <view class="shortcut-item" hover-class="shortcut-item-hover" bindtap="goToOrdersByStatus" data-status="COMPLETED">
        <view class="shortcut-icon icon icon-done"></view>
        <text class="shortcut-label">已完成</text>
      </view>
    </view>
  </view>

  <!-- More menu -->
  <view class="menu-section card">
    <view class="menu-list">
      <view class="menu-item" hover-class="menu-item-hover" bindtap="goToAddresses">
        <view class="menu-icon icon icon-pin"></view>
        <text class="menu-label">收货地址</text>
        <view class="menu-arrow icon icon-arrow"></view>
      </view>
      <view class="menu-item" hover-class="menu-item-hover" bindtap="goToMerchant">
        <view class="menu-icon icon icon-shop"></view>
        <text class="menu-label">商家管理</text>
        <view class="menu-arrow icon icon-arrow"></view>
      </view>
    </view>
  </view>

</view>
