.page {
  min-height: 100vh;
  background-color: var(--bg);
  padding: 120rpx 40rpx 0;
  box-sizing: border-box;
}
.login-card {
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.login-logo {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.login-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-1);
}
.login-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 8rpx;
  margin-bottom: 40rpx;
}
.field {
  width: 100%;
  margin-bottom: 28rpx;
}
.field-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}
.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--bg);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-1);
}
.login-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  font-size: 30rpx;
}
.btn-disabled {
  opacity: 0.6;
}
