<view class="page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="tip-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 待处理概览 -->
    <view class="pending-card card">
      <view class="pending-info">
        <text class="pending-label">待接单 / 备餐中</text>
        <text class="pending-count">{{pendingCount}}</text>
      </view>
      <view class="pending-side">
        <text class="pending-side-item" wx:if="{{refundingCount > 0}}">退款中 {{refundingCount}}</text>
        <text class="pending-side-item" wx:if="{{afterSaleCount > 0}}">售后待处理 {{afterSaleCount}}</text>
      </view>
    </view>

    <!-- 进入后台 -->
    <view class="section card">
      <text class="section-title">管理后台</text>
      <text class="section-desc">接单、发货、退款、售后、商品上下架、库存、轮播图等全部功能，与电脑端完全一致，已适配手机操作。</text>
      <view class="open-btn btn-primary {{opening ? 'btn-disabled' : ''}}" bindtap="onOpenAdmin">
        <text>{{opening ? '正在打开...' : '进入管理后台'}}</text>
      </view>
      <view class="quick-row">
        <view class="quick-item" bindtap="onOpenAdmin" data-target="orders?status=PAID">
          <text class="quick-num">{{pendingCount}}</text>
          <text class="quick-label">待处理订单</text>
        </view>
        <view class="quick-item" bindtap="onOpenAdmin" data-target="orders?status=AFTER_SALE">
          <text class="quick-num">{{afterSaleCount}}</text>
          <text class="quick-label">售后申请</text>
        </view>
        <view class="quick-item" bindtap="onOpenAdmin" data-target="products">
          <text class="quick-num">·</text>
          <text class="quick-label">商品/库存</text>
        </view>
      </view>
    </view>

    <!-- 门店坐标：地图选点，店主亲眼确认图钉落在店门口再保存 -->
    <view class="section card">
      <text class="section-title">门店位置</text>
      <text class="section-desc">用于计算同城配送距离与运费，坐标错一位小数全店订单都会算错，请务必核对地图上的图钉是否落在本店门口。</text>
      <view class="open-btn btn-secondary {{locating ? 'btn-disabled' : ''}}" bindtap="onSetStoreLocation">
        <text>{{locating ? '定位中...' : '在地图上设置门店位置'}}</text>
      </view>
    </view>

    <view class="logout-btn" bindtap="onLogout">
      <text>退出商家登录</text>
    </view>
  </block>
</view>
