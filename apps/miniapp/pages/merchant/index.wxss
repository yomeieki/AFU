.page {
  min-height: 100vh;
  background-color: var(--bg);
  padding: 24rpx;
  box-sizing: border-box;
}
.loading-wrap {
  padding-top: 200rpx;
  text-align: center;
}
.tip-text {
  font-size: 26rpx;
  color: var(--text-3);
}
.pending-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx;
  background: var(--brand-gradient);
  margin-bottom: 24rpx;
}
.pending-info {
  display: flex;
  flex-direction: column;
}
.pending-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}
.pending-count {
  font-size: 72rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
}
.pending-icon {
  font-size: 72rpx;
}
.section {
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 12rpx;
}
.section-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.url-box {
  background: var(--bg);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.url-text {
  font-size: 26rpx;
  color: var(--info);
  word-break: break-all;
}
.copy-btn {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.section-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 16rpx;
}
.logout-btn {
  margin-top: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-3);
  padding: 20rpx;
}
