.page {
  min-height: 100vh;
  background-color: var(--bg);
  padding: 24rpx;
  box-sizing: border-box;
}
.loading-wrap {
  padding-top: 200rpx;
  text-align: center;
}
.tip-text {
  font-size: 26rpx;
  color: var(--text-3);
}
.pending-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx;
  background: var(--brand-gradient);
  margin-bottom: 24rpx;
}
.pending-info {
  display: flex;
  flex-direction: column;
}
.pending-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}
.pending-count {
  font-size: 72rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
}
.pending-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.pending-side-item {
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}
.section {
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 12rpx;
}
.section-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.open-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}
.quick-row {
  display: flex;
  margin-top: 24rpx;
  border-top: 1rpx solid var(--border);
  padding-top: 20rpx;
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}
.quick-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand-500);
  line-height: 1.2;
}
.quick-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}
.logout-btn {
  margin-top: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-3);
  padding: 20rpx;
}
