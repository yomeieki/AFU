.page {
  background-color: var(--bg);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 品牌卡 */
.brand-card {
  position: relative;
  overflow: hidden;
  margin: 20rpx 24rpx 0;
  padding: 44rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 真实 logo 为印章红 + 黑字，用米白纸感底色衬托，不再用橙色渐变 */
  background: linear-gradient(180deg, #fffdf9 0%, #fbf5ee 100%);
  border: 1rpx solid rgba(176, 40, 49, 0.08);
}
.brand-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(229, 68, 30, 0.05);
}
.brand-deco-1 {
  width: 260rpx;
  height: 260rpx;
  right: -80rpx;
  top: -100rpx;
}
.brand-deco-2 {
  width: 160rpx;
  height: 160rpx;
  left: -50rpx;
  bottom: -60rpx;
}
.brand-logo {
  width: 460rpx;
  display: block;
}
.brand-since {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--text-3);
  letter-spacing: 3rpx;
}

/* 菜单区（与「我的」页保持一致） */
.menu-section {
  margin: 20rpx 24rpx 0;
}
.menu-section-header {
  padding: 26rpx 30rpx 16rpx;
  border-bottom: 1rpx solid var(--divider);
}
.menu-section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
}
.menu-list {
  display: flex;
  flex-direction: column;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--divider);
  gap: 20rpx;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item-hover {
  background-color: var(--bg);
}
.menu-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.menu-label {
  font-size: 30rpx;
  color: var(--text-1);
  flex-shrink: 0;
}
.menu-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--text-2);
}
.menu-value-wrap {
  white-space: normal;
  line-height: 1.4;
}
.menu-arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

/* 资质 */
.info-list {
  padding: 10rpx 30rpx 16rpx;
}
.info-row {
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 24rpx;
  color: var(--text-3);
}
.info-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: var(--text-1);
  word-break: break-all;
}

.version {
  display: block;
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}
