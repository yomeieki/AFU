.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
}

.meta-loading,
.closed-screen {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  font-size: 28rpx;
  padding: 80rpx 48rpx;
  text-align: center;
}
.retry-btn {
  margin-top: 32rpx;
  width: 260rpx;
}
.closed-icon {
  font-size: 84rpx;
  margin-bottom: 24rpx;
}
.closed-title {
  color: var(--text-1);
  font-size: 36rpx;
  font-weight: 600;
}
.closed-text {
  margin-top: 16rpx;
}
.closed-btn {
  margin-top: 48rpx;
  width: 300rpx;
}

.store-head {
  flex-shrink: 0;
  background: var(--card);
  padding: 22rpx 24rpx 18rpx;
  border-bottom: 1rpx solid var(--divider);
}
.store-title-row,
.store-name-wrap,
.product-row-bottom,
.cart-detail-head,
.cart-item,
.cart-item-actions,
.cart-summary,
.local-cart-bar {
  display: flex;
  align-items: center;
}
.store-title-row {
  justify-content: space-between;
}
.store-name-wrap {
  min-width: 0;
}
.store-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}
.store-name {
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.status-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  margin-left: 16rpx;
}
.status-pill-open {
  color: var(--success);
  background: var(--success-bg);
}
.status-pill-warning {
  color: #b76a00;
  background: var(--warning-bg);
}
.delivery-rules {
  display: block;
  margin-top: 14rpx;
  color: var(--text-3);
  font-size: 23rpx;
}
.head-notice {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  background: var(--warning-bg);
  border-radius: var(--radius-sm);
  color: #a86500;
  gap: 16rpx;
}
.head-notice-text {
  flex: 1;
  font-size: 24rpx;
}
.head-notice-action {
  flex-shrink: 0;
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 500;
}

.menu-body {
  flex: 1;
  min-height: 0;
  display: flex;
  border-top: 1rpx solid var(--divider);
}
.cat-panel {
  width: 180rpx;
  height: 100%;
  flex-shrink: 0;
  background: var(--bg);
}
.cat-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}
.cat-item-hover {
  background: var(--divider);
}
.cat-item-bar {
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 0;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
}
.cat-item-name {
  color: var(--text-2);
  font-size: 26rpx;
  text-align: center;
  line-height: 1.3;
}
.cat-item.active {
  background: var(--card);
}
.cat-item.active .cat-item-bar {
  background: var(--brand);
}
.cat-item.active .cat-item-name {
  color: var(--brand);
  font-weight: 600;
}
.prod-panel {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: var(--card);
}
.product-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx 20rpx 164rpx;
}
.product-row {
  display: flex;
  gap: 20rpx;
  padding: 16rpx;
  border: 1rpx solid var(--divider);
  border-radius: var(--radius-lg);
}
.product-row-img-wrap {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: var(--radius-md);
}
.product-row-img,
.product-row-img-placeholder,
.cart-img {
  width: 100%;
  height: 100%;
}
.product-row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.product-row-name,
.cart-item-name {
  display: block;
  color: var(--text-1);
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-row-subtitle {
  display: block;
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-row-meta {
  display: flex;
  gap: 14rpx;
  margin-top: 8rpx;
}
.product-row-stock {
  color: var(--success);
  font-size: 22rpx;
}
.product-row-sales,
.product-row-unit,
.product-row-price-from {
  color: var(--text-3);
  font-size: 22rpx;
}
.product-row-bottom {
  justify-content: space-between;
  margin-top: 10rpx;
}
.product-price-wrap {
  display: flex;
  align-items: baseline;
  min-width: 0;
}
.product-row-price-int {
  font-size: 36rpx;
}
.product-row-price-from {
  margin-left: 2rpx;
  font-size: 20rpx;
}
.product-row-unit {
  margin-left: 6rpx;
}
.add-btn {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 40rpx;
  line-height: 44rpx;
  text-align: center;
}
.add-btn-disabled {
  background: var(--text-disabled);
}
.footer-tip {
  padding: 26rpx 0 176rpx;
  color: var(--text-disabled);
  font-size: 24rpx;
  text-align: center;
}

.cart-detail {
  position: fixed;
  z-index: 80;
  left: 0;
  right: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  max-height: 56vh;
  padding: 22rpx 24rpx 12rpx;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
}
.cart-detail-head {
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--divider);
}
.cart-detail-title {
  font-size: 30rpx;
  font-weight: 600;
}
.cart-detail-close,
.cart-delete {
  color: var(--text-3);
  font-size: 24rpx;
}
.cart-detail-list {
  max-height: 42vh;
}
.cart-item {
  padding: 16rpx 0;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--divider);
}
.cart-img-wrap {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: var(--radius-sm);
}
.cart-item-info {
  flex: 1;
  min-width: 0;
}
.cart-item-spec,
.cart-item-price {
  display: block;
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 22rpx;
}
.cart-item-price {
  color: var(--brand);
}
.cart-item-actions {
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.cart-delete {
  padding: 4rpx;
}

.local-cart-bar {
  position: fixed;
  z-index: 90;
  left: 0;
  right: 0;
  bottom: 0;
  justify-content: space-between;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: #2b2b2b;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.12);
}
.cart-summary {
  min-width: 0;
  color: #fff;
}
.cart-badge {
  min-width: 42rpx;
  height: 42rpx;
  padding: 0 5rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
  box-sizing: border-box;
}
.cart-summary-title,
.cart-summary-amount {
  display: block;
  line-height: 1.2;
}
.cart-summary-title {
  color: #e5e5e5;
  font-size: 22rpx;
}
.cart-summary-amount {
  margin-top: 4rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.checkout-btn {
  flex-shrink: 0;
  min-width: 200rpx;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--brand-gradient);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
  box-sizing: border-box;
}
