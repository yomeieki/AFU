/* 以下选择器从 pages/local/confirm.wxss 原样复制（两页各自独立，不用 @import）：
   .page / .section / .section-title / .head-notice* / 商品明细整段 / .stepper* /
   .remark-row / .row-label / .remark-input / .remark-placeholder / .spacer /
   .bottom-bar / .escape-btn / .agree-row / .agree-link / .bottom-main /
   .bottom-total-wrap / .bottom-total-label / .bottom-total-int / .bottom-calculating /
   .submit-btn / 金额明细整段 / 阻塞条整段 / .retry-inline */
.page {
  background: var(--bg);
  min-height: 100vh;
  padding: 16rpx 0 246rpx;
  box-sizing: border-box;
}
.section { margin: 0 24rpx 16rpx; padding: 24rpx 30rpx; }
.section-title { margin-bottom: 18rpx; font-size: 30rpx; font-weight: 600; color: var(--text-1); }
.head-notice { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 24rpx 16rpx; padding: 16rpx 20rpx; border-radius: var(--radius-md); background: var(--warning-bg); color: #a86500; }
.head-notice-text { flex: 1; font-size: 25rpx; line-height: 1.45; }
.head-notice-action { flex-shrink: 0; color: var(--brand); font-size: 24rpx; }
.item-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--divider); }
.item-row:last-child { border-bottom: none; }
.item-img-wrap { width: 96rpx; height: 96rpx; flex-shrink: 0; overflow: hidden; border-radius: var(--radius-sm); }
.item-img { width: 100%; height: 100%; }
.item-info { flex: 1; min-width: 0; }
.item-name { display: block; overflow: hidden; color: var(--text-1); font-size: 28rpx; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.item-spec, .item-price { display: block; margin-top: 6rpx; color: var(--text-3); font-size: 22rpx; }
.item-price { color: var(--brand); font-size: 24rpx; }
.item-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; }
.stepper { display: flex; align-items: center; gap: 14rpx; }
.stepper-btn { width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--brand-bg); color: var(--brand); font-size: 32rpx; line-height: 38rpx; text-align: center; }
.stepper-btn.disabled { background: var(--bg); color: var(--text-disabled); }
.stepper-num { min-width: 24rpx; color: var(--text-1); font-size: 26rpx; text-align: center; }
.item-delete { color: var(--text-3); font-size: 22rpx; }
.tableware-row { display: flex; gap: 20rpx; align-items: center; padding: 10rpx 0; }
.remark-row { display: flex; gap: 20rpx; align-items: flex-start; padding: 10rpx 0; }
.row-label { width: 116rpx; flex-shrink: 0; color: var(--text-2); font-size: 27rpx; }
.remark-input { flex: 1; min-height: 72rpx; color: var(--text-1); font-size: 26rpx; line-height: 1.45; }
.remark-placeholder { color: var(--text-disabled); }
.tableware-value { flex: 1; text-align: right; color: var(--text-1); font-size: 26rpx; }
.tableware-empty { color: var(--brand); }
.tableware-arrow { color: var(--text-3); font-size: 30rpx; }
.spacer { height: 8rpx; }
.bottom-bar { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; padding: 10rpx 24rpx calc(14rpx + env(safe-area-inset-bottom)); background: var(--card); border-top: 1rpx solid var(--divider); box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, .03); }
.escape-btn {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border: 1rpx solid currentColor;
  border-radius: 999rpx;
  color: #b42318;
  font-size: 21rpx;
  white-space: nowrap;
  text-align: center;
}
.agree-row { color: var(--text-3); font-size: 22rpx; line-height: 1.4; text-align: center; }
.agree-link { color: var(--brand); }
.bottom-main { display: flex; align-items: center; gap: 18rpx; margin-top: 8rpx; }
.bottom-total-wrap { flex: 1; display: flex; align-items: baseline; min-width: 0; }
.bottom-total-label { margin-right: 8rpx; color: var(--text-2); font-size: 26rpx; }
.bottom-total-int { font-size: 42rpx; }
.bottom-calculating { color: var(--text-3); font-size: 24rpx; }
.submit-btn { max-width: 360rpx; padding: 0 28rpx; overflow: hidden; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }

/* ── 金额明细卡（与 confirm.wxss 同款）───────────────────── */
.sum-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 9rpx 0;
}
.sum-k { font-size: 25rpx; color: var(--text-2); flex-shrink: 0; }
.sum-v { font-size: 25rpx; color: var(--text-1); text-align: right; min-width: 0; }
.sum-cut { color: var(--brand); }
.sum-wait { color: var(--text-3); }
.sum-total {
  border-top: 1rpx solid var(--divider);
  margin-top: 8rpx;
  padding-top: 16rpx;
}
.sum-total .sum-k { font-size: 27rpx; color: var(--text-1); font-weight: 600; }
.sum-pay { color: var(--brand); font-size: 30rpx; font-weight: 600; }

/* ── 阻塞提示条（与 confirm.wxss 同款）────────────────────── */
.block-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: var(--danger-bg, #fef2f2);
}
.block-strip-text {
  font-size: 22rpx;
  color: #b42318;
  line-height: 1.4;
  min-width: 0;
}
.block-strip-acts { display: flex; gap: 10rpx; flex-shrink: 0; }
.retry-inline { padding: 8rpx 16rpx; border: 1rpx solid var(--brand); border-radius: 999rpx; font-size: 23rpx; }

/* ── 自取专属 ─────────────────────────────────────────── */
.head-notice-soft { background: var(--gray-bg); color: var(--text-2); }
.store-row { display: flex; align-items: center; gap: 16rpx; }
.store-body { flex: 1; min-width: 0; }
.store-name { display: block; color: var(--text-1); font-size: 30rpx; font-weight: 600; }
.store-address { display: block; margin-top: 6rpx; color: var(--text-2); font-size: 24rpx; line-height: 1.5; }
.store-acts { display: flex; gap: 12rpx; flex-shrink: 0; }
.store-act { padding: 8rpx 18rpx; border: 1rpx solid var(--brand); border-radius: 999rpx; color: var(--brand); font-size: 23rpx; }
.slot-value { display: flex; align-items: center; gap: 12rpx; }
.slot-text { flex: 1; color: var(--text-1); font-size: 30rpx; font-weight: 600; }
.slot-stale .slot-text { color: var(--text-3); text-decoration: line-through; }
.slot-stale-tip { color: var(--brand); font-size: 23rpx; }
.slot-muted { color: var(--text-3); font-size: 26rpx; line-height: 1.5; }
.slot-error { display: flex; align-items: center; justify-content: space-between; color: var(--brand); font-size: 26rpx; }
.slot-hint { display: block; margin-top: 10rpx; color: var(--text-3); font-size: 23rpx; }
.arrow { width: 28rpx; height: 28rpx; }
.field-row { display: flex; align-items: center; gap: 20rpx; padding: 12rpx 0; border-bottom: 1rpx solid var(--divider); }
.field-row:last-child { border-bottom: none; }
.field-input { flex: 1; min-height: 64rpx; color: var(--text-1); font-size: 28rpx; }
.field-placeholder { color: var(--text-disabled); }

/* 时段弹层：最大高度约 70vh、含安全区（与券弹层同一套约定） */
.sheet-mask { position: fixed; z-index: 100; inset: 0; background: rgba(0, 0, 0, 0.45); }
.sheet { position: absolute; left: 0; right: 0; bottom: 0; max-height: 70vh; display: flex; flex-direction: column; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); background: var(--card); border-radius: 24rpx 24rpx 0 0; box-sizing: border-box; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 16rpx; }
.sheet-title { font-size: 30rpx; font-weight: 600; color: var(--text-1); }
.sheet-close { font-size: 26rpx; color: var(--text-3); }
.day-tabs { display: flex; gap: 16rpx; padding: 8rpx 0 16rpx; }
.day-tab { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 14rpx 0; border-radius: 10rpx; background: var(--bg); color: var(--text-2); font-size: 27rpx; }
.day-tab.active { background: var(--brand-bg); color: var(--brand); font-weight: 600; }
.day-date { font-size: 21rpx; color: var(--text-3); }
.day-tab.active .day-date { color: var(--brand); opacity: 0.8; }
.day-empty { font-size: 20rpx; color: var(--text-3); }
.slot-grid-wrap { flex: 1; min-height: 200rpx; max-height: 48vh; }
.slot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; padding-bottom: 8rpx; }
.slot-cell { padding: 18rpx 0; border-radius: 10rpx; background: var(--bg); color: var(--text-1); font-size: 26rpx; text-align: center; }
.slot-cell.active { background: var(--brand); color: #fff; font-weight: 600; }
.slot-grid-empty { padding: 60rpx 0; color: var(--text-3); font-size: 26rpx; text-align: center; }

.bottom-total-wrap { flex-direction: column; align-items: flex-start; }
.bottom-total-line { display: flex; align-items: baseline; }
.bottom-total-sub { display: block; font-size: 22rpx; color: var(--brand); }
