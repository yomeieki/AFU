<!-- 兼容跳转页，正常情况下一闪而过。只有 switchTab 失败时才有内容可看。 -->
<view class="page redirect-page">
  <block wx:if="{{failed}}">
    <text class="redirect-title">页面暂时打不开</text>
    <text class="redirect-text">请重试，或从首页进入同城配送</text>
    <view class="redirect-btn btn-primary" bindtap="go">重试</view>
  </block>
  <text wx:else class="redirect-text">正在进入同城配送…</text>
</view>

<privacy-popup id="privacy-popup" />
