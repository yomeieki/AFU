<wxs src="../../utils/price.wxs" module="pricefmt" />
<view class="page">
  <view wx:if="{{!meta}}" class="meta-loading">
    <text>{{metaError ? '同城配送信息加载失败' : '加载同城配送信息中...'}}</text>
    <view wx:if="{{metaError}}" class="retry-btn btn-plain" bindtap="loadMeta">重新加载</view>
  </view>

  <block wx:elif="{{!meta.enabled}}">
    <view class="closed-screen">
      <view class="closed-icon">⏳</view>
      <text class="closed-title">同城配送即将开通</text>
      <text class="closed-text">敬请期待，也可先选购全国邮寄商品</text>
      <view class="closed-btn btn-primary" bindtap="goExpress">去全国邮寄</view>
    </view>
  </block>

  <block wx:else>
    <view class="store-head">
      <view class="store-title-row">
        <view class="store-name-wrap">
          <view class="icon icon-shop store-icon"></view>
          <text class="store-name">{{meta.store.name || '同城配送'}}</text>
        </view>
        <text class="status-pill {{headBlocking ? 'status-pill-warning' : 'status-pill-open'}}">
          {{meta.paused ? '暂停接单' : (!meta.isOpen ? '已打烊' : '营业中')}}
        </text>
      </view>
      <text class="delivery-rules">配送范围 {{meta.radiusKm}} km · 满 ¥{{pricefmt.fen(meta.fee.minOrderAmount)}} 起送 · 基础运费 ¥{{pricefmt.fen(meta.fee.baseFee)}} 起</text>
      <view wx:if="{{headNotice}}" class="head-notice">
        <text class="head-notice-text">{{headNotice}}</text>
        <view class="head-notice-action" bindtap="goExpress">去全国邮寄</view>
      </view>
    </view>

    <view class="menu-body">
      <scroll-view class="cat-panel" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
        <view
          wx:for="{{categories}}"
          wx:key="name"
          class="cat-item {{activeCategoryId === item.id ? 'active' : ''}}"
          hover-class="cat-item-hover"
          bindtap="onSelectCategory"
          data-id="{{item.id}}"
        >
          <view class="cat-item-bar"></view>
          <text class="cat-item-name">{{item.name}}</text>
        </view>
      </scroll-view>

      <scroll-view
        class="prod-panel"
        scroll-y
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
        scroll-top="{{rightScrollTop}}"
        lower-threshold="120"
        bindscrolltolower="onScrollToLower"
      >
        <empty-state
          wx:if="{{list.length === 0 && !loading}}"
          type="product"
          text="{{categories.length <= 1 ? '同城菜单还在准备中' : '该分类暂无商品'}}"
        />

        <view class="product-list">
          <view wx:for="{{list}}" wx:key="id" class="product-row">
            <view class="product-row-img-wrap">
              <image wx:if="{{item.coverImage}}" class="product-row-img" src="{{item.coverImage}}" mode="aspectFill" lazy-load="{{true}}" />
              <view wx:else class="product-row-img-placeholder img-placeholder"></view>
            </view>
            <view class="product-row-info">
              <text class="product-row-name">{{item.name}}</text>
              <text wx:if="{{item.subtitle}}" class="product-row-subtitle">{{item.subtitle}}</text>
              <view class="product-row-meta">
                <text class="product-row-stock">{{item.stockLabel}}</text>
                <text wx:if="{{item.salesCount > 0}}" class="product-row-sales">已售{{item.salesCount}}</text>
              </view>
              <view class="product-row-bottom">
                <view class="product-price-wrap">
                  <text class="price-symbol">¥</text>
                  <text class="price-int product-row-price-int">{{pricefmt.int(item.priceText)}}</text>
                  <text class="price-dec">{{pricefmt.dec(item.priceText)}}</text>
                  <text wx:if="{{item.hasSkus}}" class="product-row-price-from">起</text>
                  <text class="product-row-unit">/ {{item.unit}}</text>
                </view>
                <view class="add-btn {{item.stock <= 0 ? 'add-btn-disabled' : ''}}" catchtap="onAddToCart" data-id="{{item.id}}">+</view>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{loading}}" class="footer-tip">加载中...</view>
        <view wx:elif="{{!hasMore && list.length > 0}}" class="footer-tip">- 没有更多了 -</view>
      </scroll-view>
    </view>

    <view wx:if="{{cartExpanded && cartItems.length > 0}}" class="cart-detail">
      <view class="cart-detail-head">
        <text class="cart-detail-title">同城购物车</text>
        <text class="cart-detail-close" bindtap="toggleCart">收起</text>
      </view>
      <scroll-view class="cart-detail-list" scroll-y>
        <view wx:for="{{cartItems}}" wx:key="id" class="cart-item">
          <view class="cart-img-wrap">
            <image wx:if="{{item.productImage}}" class="cart-img" src="{{item.productImage}}" mode="aspectFill" />
            <view wx:else class="cart-img img-placeholder"></view>
          </view>
          <view class="cart-item-info">
            <text class="cart-item-name">{{item.productName}}</text>
            <text wx:if="{{item.specText}}" class="cart-item-spec">{{item.specText}}</text>
            <text class="cart-item-price">¥{{pricefmt.fen(item.price)}}</text>
          </view>
          <view class="cart-item-actions">
            <view class="stepper">
              <view class="stepper-btn {{item.quantity <= 1 ? 'disabled' : ''}}" bindtap="onDecrease" data-id="{{item.id}}">−</view>
              <text class="stepper-num">{{item.quantity}}</text>
              <view class="stepper-btn" bindtap="onIncrease" data-id="{{item.id}}">+</view>
            </view>
            <view class="cart-delete" bindtap="onDelete" data-id="{{item.id}}">删除</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{cartCount > 0}}" class="local-cart-bar" bindtap="toggleCart">
      <view class="cart-summary">
        <view class="cart-badge">{{cartCount}}</view>
        <view>
          <text class="cart-summary-title">共 {{cartCount}} 件</text>
          <text class="cart-summary-amount">¥{{pricefmt.fen(cartAmount)}}</text>
        </view>
      </view>
      <view class="checkout-btn {{checkoutDisabled ? 'btn-disabled' : ''}}" catchtap="goCheckout">{{checkoutText}}</view>
    </view>
  </block>

  <sku-popup show="{{skuShow}}" product="{{skuProduct}}" mode="cart" bind:close="onSkuClose" bind:confirm="onSkuConfirm" />
</view>

<privacy-popup id="privacy-popup" />
