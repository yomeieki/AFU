.page {
  background: var(--bg);
  min-height: 100vh;
  padding: 16rpx 0 246rpx;
  box-sizing: border-box;
}
.section { margin: 0 24rpx 16rpx; padding: 24rpx 30rpx; }
.section-title { margin-bottom: 18rpx; font-size: 30rpx; font-weight: 600; color: var(--text-1); }
.head-notice { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 24rpx 16rpx; padding: 16rpx 20rpx; border-radius: var(--radius-md); background: var(--warning-bg); color: #a86500; }
.head-notice-text { flex: 1; font-size: 25rpx; line-height: 1.45; }
.head-notice-action { flex-shrink: 0; color: var(--brand); font-size: 24rpx; }
.address-section { display: flex; align-items: flex-start; gap: 18rpx; }
.address-pin { width: 40rpx; height: 40rpx; flex-shrink: 0; margin-top: 2rpx; }
.address-info { flex: 1; min-width: 0; }
.receiver-row { display: flex; gap: 20rpx; margin-bottom: 8rpx; }
.receiver-name { color: var(--text-1); font-size: 30rpx; font-weight: 600; }
.receiver-phone { color: var(--text-2); font-size: 27rpx; }
.address-poi { display: block; color: var(--text-1); font-size: 27rpx; margin-bottom: 4rpx; }
.address-full { display: block; color: var(--text-2); font-size: 24rpx; line-height: 1.5; }
.address-missing { display: inline-block; margin-top: 10rpx; color: var(--brand); font-size: 24rpx; }
.no-address { flex: 1; color: var(--brand); font-size: 28rpx; }
.arrow { width: 28rpx; height: 28rpx; align-self: center; }
.delivery-section { min-height: 126rpx; }
.delivery-info { display: flex; flex-direction: column; gap: 9rpx; color: var(--text-2); font-size: 26rpx; line-height: 1.4; }
.arrival-time { display: block; margin-top: 10rpx; color: var(--text-3); font-size: 23rpx; }
.delivery-loading, .delivery-empty { color: var(--text-3); font-size: 26rpx; line-height: 1.5; }
.delivery-error { display: flex; align-items: center; justify-content: space-between; color: var(--brand); font-size: 26rpx; }
.retry-inline { padding: 8rpx 16rpx; border: 1rpx solid var(--brand); border-radius: 999rpx; font-size: 23rpx; }
.delivery-block { display: block; margin-top: 12rpx; color: var(--brand); font-size: 24rpx; line-height: 1.45; }

/* ── 头条软提示（预约送达 2026-09-21 §5.2）：打烊但预约开着时不阻塞，颜色不用警示色 ── */
.head-notice-soft { background: var(--gray-bg); color: var(--text-2); }

/* ── 送达时间卡（尽快 / 预约） ─────────────────────────────── */
.mode-row { display: flex; gap: 16rpx; }
.mode-opt { flex: 1; border: 2rpx solid var(--border); border-radius: 12rpx; padding: 18rpx; text-align: center; }
.mode-opt.active { border-color: var(--brand); background: var(--brand-bg); }
.mode-opt.disabled { opacity: .45; }
.mode-name { display: block; color: var(--text-1); font-weight: 600; }
.mode-opt.active .mode-name { color: var(--brand); }
.mode-sub { display: block; margin-top: 6rpx; color: var(--text-3); font-size: 22rpx; }
.slot-row { display: flex; align-items: center; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--divider); }
.slot-text { color: var(--text-1); font-size: 28rpx; font-weight: 600; }
.slot-stale { color: var(--text-3); text-decoration: line-through; }
.slot-stale-tip { color: var(--brand); font-size: 23rpx; text-decoration: none; }
.slot-muted { color: var(--text-3); font-size: 26rpx; line-height: 1.5; }
.slot-error { color: var(--brand); font-size: 26rpx; }
.slot-change { margin-left: auto; color: var(--brand); font-size: 24rpx; flex-shrink: 0; }
.fee-flash { animation: fee-flash 1.2s ease-in-out; }
@keyframes fee-flash { 0%, 100% { color: var(--text-2); } 50% { color: var(--brand); font-weight: 600; } }
.item-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--divider); }
.item-row:last-child { border-bottom: none; }
.item-img-wrap { width: 96rpx; height: 96rpx; flex-shrink: 0; overflow: hidden; border-radius: var(--radius-sm); }
.item-img { width: 100%; height: 100%; }
.item-info { flex: 1; min-width: 0; }
.item-name { display: block; overflow: hidden; color: var(--text-1); font-size: 28rpx; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.item-spec, .item-price { display: block; margin-top: 6rpx; color: var(--text-3); font-size: 22rpx; }
.item-price { color: var(--brand); font-size: 24rpx; }
.item-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; }
.stepper { display: flex; align-items: center; gap: 14rpx; }
.stepper-btn { width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--brand-bg); color: var(--brand); font-size: 32rpx; line-height: 38rpx; text-align: center; }
.stepper-btn.disabled { background: var(--bg); color: var(--text-disabled); }
.stepper-num { min-width: 24rpx; color: var(--text-1); font-size: 26rpx; text-align: center; }
.item-delete { color: var(--text-3); font-size: 22rpx; }
.tableware-row, .remark-row { display: flex; gap: 20rpx; align-items: center; padding: 10rpx 0; }
.remark-row { align-items: flex-start; }
/* 与自取页同宽，保持两页备注输入框对齐 */
.row-label { width: 116rpx; flex-shrink: 0; color: var(--text-2); font-size: 27rpx; }
.remark-input { flex: 1; min-height: 72rpx; color: var(--text-1); font-size: 26rpx; line-height: 1.45; }
.remark-placeholder { color: var(--text-disabled); }
.tableware-value { flex: 1; text-align: right; color: var(--text-1); font-size: 26rpx; }
.tableware-empty { color: var(--brand); }
.tableware-arrow { color: var(--text-3); font-size: 30rpx; }
.spacer { height: 8rpx; }
.bottom-bar { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; padding: 10rpx 24rpx calc(14rpx + env(safe-area-inset-bottom)); background: var(--card); border-top: 1rpx solid var(--divider); box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, .03); }
/* 出口按钮。原来在一条独占整行的 .escape-actions 里（flex:1 平分整宽），
   现在挪进阻塞提示条、与原因文字同一行，所以不能再平分——按内容宽、不换行、不收缩，
   该被压缩的是左边的原因文字。 */
.escape-btn {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border: 1rpx solid currentColor;
  border-radius: 999rpx;
  color: #b42318;
  font-size: 21rpx;
  white-space: nowrap;
  text-align: center;
}
.agree-row { color: var(--text-3); font-size: 22rpx; line-height: 1.4; text-align: center; }
.agree-link { color: var(--brand); }
.bottom-main { display: flex; align-items: center; gap: 18rpx; margin-top: 8rpx; }
.bottom-total-wrap { flex: 1; display: flex; align-items: baseline; min-width: 0; }
.bottom-total-label { margin-right: 8rpx; color: var(--text-2); font-size: 26rpx; }
.bottom-total-int { font-size: 42rpx; }
.bottom-calculating { color: var(--text-3); font-size: 24rpx; }
.submit-btn { max-width: 360rpx; padding: 0 28rpx; overflow: hidden; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }

/* ── 金额明细卡（Spec §5.5）───────────────────────────── */
.sum-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 9rpx 0;
}
.sum-k { font-size: 25rpx; color: var(--text-2); flex-shrink: 0; }
.sum-v { font-size: 25rpx; color: var(--text-1); text-align: right; min-width: 0; }
.sum-cut { color: var(--brand); }
.sum-wait { color: var(--text-3); }
.sum-total {
  border-top: 1rpx solid var(--divider);
  margin-top: 8rpx;
  padding-top: 16rpx;
}
.sum-total .sum-k { font-size: 27rpx; color: var(--text-1); font-weight: 600; }
.sum-pay { color: var(--brand); font-size: 30rpx; font-weight: 600; }

/* ── 阻塞提示条 ──────────────────────────────────────────
   放在固定栏内、按钮正上方。原因可以两行，两个出口不换行、不被压缩。 */
.block-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: var(--danger-bg, #fef2f2);
}
.block-strip-text {
  font-size: 22rpx;
  color: #b42318;
  line-height: 1.4;
  min-width: 0;
}
.block-strip-acts { display: flex; gap: 10rpx; flex-shrink: 0; }

.bottom-total-wrap { flex-direction: column; align-items: flex-start; }
.bottom-total-line { display: flex; align-items: baseline; }
.bottom-total-sub { display: block; font-size: 22rpx; color: var(--brand); }
