<view class="page">

  <!-- 未登录 -->
  <view wx:if="{{needLogin}}" class="state-wrap">
    <view class="state-text">登录后查看积分明细</view>
    <button class="btn-primary state-btn" hover-class="none" bindtap="onLogin">点击登录</button>
  </view>

  <block wx:else>

    <!-- 顶部固定一行：余额 + 到期提示。文案照 docs/member-terms-copy.md 逐字 -->
    <view wx:if="{{summaryReady}}" class="summary">
      <view class="summary-row">
        <text class="summary-label">当前积分</text>
        <text class="summary-num">{{balance}}</text>
      </view>
      <view wx:if="{{showExpireTip}}" class="summary-tip">
        <text>若 1 年内无消费，您的</text>
        <text class="summary-tip-strong">{{balance}}</text>
        <text>分将于</text>
        <text class="summary-tip-strong">{{expireAtText}}</text>
        <text>全部过期</text>
      </view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="state-wrap">
      <text class="state-text">加载中...</text>
    </view>

    <!-- 加载失败（与「暂无记录」是两块界面，别混） -->
    <view wx:elif="{{loadFailed}}" class="state-wrap">
      <text class="state-text">积分明细加载失败</text>
      <button class="btn-plain state-btn" hover-class="none" bindtap="onRetry">重新加载</button>
    </view>

    <!-- 空数据 -->
    <empty-state
      wx:elif="{{list.length === 0}}"
      type="order"
      text="暂无积分记录"
      action-text="去下单赚积分"
      bind:action="goShop"
    />

    <!-- 流水 -->
    <view wx:else class="log-list">
      <view
        wx:for="{{list}}"
        wx:key="index"
        class="log-item card"
        hover-class="{{item.linkId ? 'log-item-hover' : 'none'}}"
        bindtap="goOrderDetail"
        data-id="{{item.linkId}}"
      >
        <view class="log-main">
          <view class="log-head">
            <text class="log-type">{{item.typeLabel}}</text>
            <text class="log-delta {{item.positive ? 'plus' : 'minus'}}">{{item.deltaText}}</text>
          </view>
          <text class="log-time">{{item.createdAtText}}</text>
          <text wx:if="{{item.remark}}" class="log-remark">{{item.remark}}</text>
          <view wx:if="{{item.orderNo || item.expiresAtText}}" class="log-foot">
            <text wx:if="{{item.orderNo}}" class="log-order">订单号：{{item.orderNo}}</text>
            <text wx:if="{{item.expiresAtText}}" class="log-expire">有效期至 {{item.expiresAtText}}</text>
          </view>
        </view>
        <text wx:if="{{item.linkId}}" class="log-arrow">›</text>
      </view>

      <view class="footer-tip" wx:if="{{loadingMore}}"><text>加载中...</text></view>
      <view class="footer-tip" wx:elif="{{!hasMore}}"><text>- 没有更多了 -</text></view>
    </view>

  </block>

</view>
