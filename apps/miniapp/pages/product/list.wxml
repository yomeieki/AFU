<wxs src="../../utils/price.wxs" module="pricefmt" />

<!-- 商品行：分组视图与搜索视图共用一份，用 template 引用，避免维护两份 wxml -->
<template name="product-row">
  <view
    class="product-row"
    hover-class="product-row-hover"
    bindtap="goToDetail"
    data-id="{{item.id}}"
  >
    <view class="product-row-img-wrap">
      <image
        wx:if="{{item.coverImage}}"
        class="product-row-img"
        src="{{item.coverImage}}"
        mode="aspectFill"
        lazy-load="{{true}}"
        bindload="onImageLoad"
      />
      <view wx:else class="product-row-img-placeholder img-placeholder"></view>
    </view>
    <view class="product-row-info">
      <text class="product-row-name">{{item.name}}</text>
      <text class="product-row-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
      <view class="product-row-meta">
        <text class="product-row-stock">{{item.stockLabel}}</text>
        <text wx:if="{{item.salesCount > 0}}" class="product-row-sales">已售{{item.salesCount}}</text>
      </view>
      <view class="product-row-bottom">
        <text class="price-symbol">¥</text>
        <text class="price-int product-row-price-int">{{pricefmt.int(item.priceText)}}</text>
        <text class="price-dec">{{pricefmt.dec(item.priceText)}}</text>
        <text wx:if="{{item.hasSkus}}" class="product-row-price-from">起</text>
        <text class="product-row-unit">/ {{item.unit}}</text>
        <!-- catchtap 而不是 bindtap：不 catch 的话点击会冒泡到整行的 goToDetail，
             顾客按一下加购、页面却跳进了详情页。 -->
        <view
          wx:if="{{channel === 'LOCAL'}}"
          class="add-btn {{item.stock <= 0 ? 'add-btn-disabled' : ''}}"
          catchtap="onAddToCart"
          data-id="{{item.id}}"
        >+</view>
      </view>
    </view>
  </view>
</template>

<view class="page {{channel === 'LOCAL' ? 'page-local' : ''}}">

  <!-- 同城：完整门店头（店名 + 状态 + 配送规则行 + 打烊/阻塞通知），与主页一致。
       2026-09-17 起不再用紧凑版：分类页也要能看到配送范围/起送/运费与打烊提示，
       不能逼顾客切回主页才看得到。门店头变高后右侧商品列表相应变矮，属预期。 -->
  <local-store-header wx:if="{{channel === 'LOCAL'}}" meta="{{meta}}" mode="{{mode}}" channel="{{channel}}" bind:goexpress="onGoExpress" bind:switchmode="onSwitchMode" bind:switchchannel="openChannelSheet" />

  <!-- 邮寄：搜索框 + 右端渠道标识。同城菜单只有几十件、左侧分类一眼看完，不需要搜索。 -->
  <view wx:else class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索商品"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="onSearchConfirm">
        <text>搜索</text>
      </view>
    </view>
    <channel-badge channel="{{channel}}" bind:switch="openChannelSheet" />
  </view>

  <!-- Active search chip（搜索模式：点 × 清除并回到分组视图） -->
  <view class="category-tag-bar" wx:if="{{searchKeyword}}">
    <view class="category-tag">
      <text class="category-tag-text">搜索：{{searchKeyword}}</text>
      <text class="category-tag-close" bindtap="clearSearch">×</text>
    </view>
  </view>

  <local-mode-bar wx:if="{{channel === 'LOCAL'}}" meta="{{meta}}" mode="{{mode}}" bind:change="onModeChange" />

  <!-- Two-column body -->
  <view class="body">

    <!-- Left: category sidebar（无「全部」项，进页默认停在第一项） -->
    <scroll-view class="cat-panel" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
      <view
        wx:for="{{groups}}"
        wx:key="id"
        class="cat-item {{!searchKeyword && activeGroupId === item.id ? 'active' : ''}}"
        hover-class="cat-item-hover"
        bindtap="onSelectCategory"
        data-id="{{item.id}}"
      >
        <view class="cat-item-bar"></view>
        <text class="cat-item-name">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- Right: product panel -->
    <view class="prod-wrap">

      <!-- 吸顶浮动条：不用 CSS sticky（scroll-view 内表现不一致），画一条覆盖在顶部 -->
      <view wx:if="{{!searchKeyword && !catalogLoading && activeGroupName}}" class="group-head group-float">{{activeGroupName}}</view>

      <scroll-view
        class="prod-panel"
        scroll-y
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
        scroll-top="{{rightScrollTop}}"
        scroll-into-view="{{scrollIntoView}}"
        scroll-with-animation="{{true}}"
        lower-threshold="120"
        bindscrolltolower="onScrollToLower"
        bindscroll="onRightScroll"
      >
        <!-- 分组视图：拉全量中骨架屏 → 空 → 分段 -->
        <block wx:if="{{!searchKeyword}}">
          <view wx:if="{{catalogLoading}}" class="skeleton-list">
            <view class="skeleton-row" wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
              <view class="skeleton-img skeleton-shine"></view>
              <view class="skeleton-lines"><view class="skeleton-line skeleton-shine"></view><view class="skeleton-line skeleton-line-short skeleton-shine"></view></view>
            </view>
          </view>
          <empty-state wx:elif="{{groups.length === 0}}" type="product" text="{{channel === 'LOCAL' ? '同城菜单还在准备中' : '暂无商品'}}" />
          <block wx:else>
            <view wx:for="{{groups}}" wx:key="id" wx:for-item="g" id="g-{{g.id}}" data-gid="{{g.id}}" class="group-anchor">
              <view class="group-head">{{g.name}}</view>
              <view wx:if="{{g.items.length === 0}}" class="group-empty">该分类暂无商品</view>
              <view wx:else class="product-list">
                <template wx:for="{{g.items}}" wx:key="id" is="product-row" data="{{item: item, channel: channel}}" />
              </view>
            </view>
            <view class="group-tail" style="height: {{tailHeight}}px;"></view>
            <view class="cart-spacer" style="height: {{cartSpacerPx}}px;"></view>
          </block>
        </block>
        <!-- 搜索视图（仅邮寄）：平铺 + 翻页，原样保留 -->
        <block wx:else>
          <empty-state wx:if="{{list.length === 0 && !loading}}" type="product" text="没有找到相关商品" />
          <view class="product-list">
            <template wx:for="{{list}}" wx:key="id" is="product-row" data="{{item: item, channel: channel}}" />
          </view>
          <view wx:if="{{loading}}" class="footer-tip"><text>加载中...</text></view>
          <view wx:elif="{{!hasMore && list.length > 0}}" class="footer-tip"><text>- 没有更多了 -</text></view>
          <view class="cart-spacer" style="height: {{cartSpacerPx}}px;"></view>
        </block>
      </scroll-view>

    </view>

  </view>

  <local-sku-picker wx:if="{{channel === 'LOCAL'}}" id="local-sku-picker" bind:added="onAdded" />
</view>

<!-- 渠道切换弹层：两侧标识共用。遮罩 catchtouchmove 防止底下 scroll-view 跟着滚（与 sku-popup 同一套写法）。 -->
<view wx:if="{{channelSheetOpen}}" class="channel-mask" bindtap="closeChannelSheet" catchtouchmove="noop">
  <view class="channel-sheet" catchtap="noop">
    <view class="channel-sheet-title">购物方式</view>
    <view class="channel-option {{channel === 'LOCAL' ? 'active' : ''}}" hover-class="channel-option-hover" bindtap="onPickChannel" data-channel="LOCAL">
      <text class="channel-option-name">同城配送</text>
      <text wx:if="{{channel === 'LOCAL'}}" class="channel-option-check">✓</text>
    </view>
    <view class="channel-option {{channel === 'EXPRESS' ? 'active' : ''}}" hover-class="channel-option-hover" bindtap="onPickChannel" data-channel="EXPRESS">
      <text class="channel-option-name">全国邮寄</text>
      <text wx:if="{{channel === 'EXPRESS'}}" class="channel-option-check">✓</text>
    </view>
  </view>
</view>

<!-- 同城购物车条。fixed 在原生 tabBar 之上，车空时组件自己不渲染、不占位。 -->
<local-cart-bar
  channel="{{channel}}"
  promotion="{{promotion}}"
  bind:height="onCartHeight"
  id="local-cart-bar"
  meta="{{meta}}"
  blocking="{{headBlocking}}"
  mode="{{mode}}"
  bind:change="onCartChange"
/>
