<wxs src="../../utils/price.wxs" module="pricefmt" />
<view class="page {{channel === 'LOCAL' ? 'page-local' : ''}}">

  <!-- 同城：紧凑门店头（只留店名 + 营业状态）。配送规则与阻塞通知在主页给过，
       这一页寸土寸金，右侧商品列表要尽量高。 -->
  <local-store-header wx:if="{{channel === 'LOCAL'}}" compact="{{true}}" meta="{{meta}}" mode="{{mode}}" bind:goexpress="onGoExpress" bind:switchmode="onSwitchMode" />

  <!-- 邮寄：搜索框。同城菜单只有几十件、左侧分类一眼看完，不需要搜索。 -->
  <view wx:else class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索商品"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="onSearchConfirm">
        <text>搜索</text>
      </view>
    </view>
  </view>

  <!-- Active search chip（搜索模式：点 × 清除并回到分类模式） -->
  <view class="category-tag-bar" wx:if="{{searchKeyword}}">
    <view class="category-tag">
      <text class="category-tag-text">搜索：{{searchKeyword}}</text>
      <text class="category-tag-close" bindtap="clearSearch">×</text>
    </view>
  </view>

  <local-mode-bar wx:if="{{channel === 'LOCAL'}}" meta="{{meta}}" mode="{{mode}}" bind:change="onModeChange" />

  <!-- Two-column body -->
  <view class="body">

    <!-- Left: category sidebar -->
    <scroll-view class="cat-panel" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
      <view
        wx:for="{{categories}}"
        wx:key="name"
        class="cat-item {{!searchKeyword && activeCategoryId === item.id ? 'active' : ''}}"
        hover-class="cat-item-hover"
        bindtap="onSelectCategory"
        data-id="{{item.id}}"
      >
        <view class="cat-item-bar"></view>
        <text class="cat-item-name">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- Right: product list -->
    <scroll-view
      class="prod-panel"
      scroll-y
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      scroll-top="{{rightScrollTop}}"
      lower-threshold="120"
      bindscrolltolower="onScrollToLower"
    >
      <empty-state
        wx:if="{{list.length === 0 && !loading}}"
        type="product"
        text="{{searchKeyword ? '没有找到相关商品' : (channel === 'LOCAL' && categories.length <= 1 ? '同城菜单还在准备中' : '该分类暂无商品')}}"
      />

      <view class="product-list">
        <view
          wx:for="{{list}}"
          wx:key="id"
          class="product-row"
          hover-class="product-row-hover"
          bindtap="goToDetail"
          data-id="{{item.id}}"
        >
          <view class="product-row-img-wrap">
            <image
              wx:if="{{item.coverImage}}"
              class="product-row-img"
              src="{{item.coverImage}}"
              mode="aspectFill"
              lazy-load="{{true}}"
            />
            <view wx:else class="product-row-img-placeholder img-placeholder"></view>
          </view>
          <view class="product-row-info">
            <text class="product-row-name">{{item.name}}</text>
            <text class="product-row-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
            <view class="product-row-meta">
              <text class="product-row-stock">{{item.stockLabel}}</text>
              <text wx:if="{{item.salesCount > 0}}" class="product-row-sales">已售{{item.salesCount}}</text>
            </view>
            <view class="product-row-bottom">
              <text class="price-symbol">¥</text>
              <text class="price-int product-row-price-int">{{pricefmt.int(item.priceText)}}</text>
              <text class="price-dec">{{pricefmt.dec(item.priceText)}}</text>
              <text wx:if="{{item.hasSkus}}" class="product-row-price-from">起</text>
              <text class="product-row-unit">/ {{item.unit}}</text>
              <!-- catchtap 而不是 bindtap：不 catch 的话点击会冒泡到整行的 goToDetail，
                   顾客按一下加购、页面却跳进了详情页。 -->
              <view
                wx:if="{{channel === 'LOCAL'}}"
                class="add-btn {{item.stock <= 0 ? 'add-btn-disabled' : ''}}"
                catchtap="onAddToCart"
                data-id="{{item.id}}"
              >+</view>
            </view>
          </view>
        </view>
      </view>

      <!-- Footer -->
      <view wx:if="{{loading}}" class="footer-tip">
        <text>加载中...</text>
      </view>
      <view wx:elif="{{!hasMore && list.length > 0}}" class="footer-tip">
        <text>- 没有更多了 -</text>
      </view>
    </scroll-view>

  </view>

  <local-sku-picker wx:if="{{channel === 'LOCAL'}}" id="local-sku-picker" bind:added="onAdded" />
</view>

<!-- 同城购物车条。fixed 在原生 tabBar 之上，车空时组件自己不渲染、不占位。 -->
<local-cart-bar
  wx:if="{{channel === 'LOCAL'}}"
  id="local-cart-bar"
  meta="{{meta}}"
  blocking="{{headBlocking}}"
  mode="{{mode}}"
  bind:change="onCartChange"
/>
