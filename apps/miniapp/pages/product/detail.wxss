.page {
  background-color: #f5f5f5;
  padding-bottom: 130rpx;
}

/* Image swiper */
.img-swiper {
  width: 100%;
  height: 560rpx;
  background-color: #f0f0f0;
}
.swiper-img {
  width: 100%;
  height: 100%;
}
.swiper-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f0f0f0;
}
.swiper-placeholder-text {
  font-size: 28rpx;
  color: #bbb;
}

/* Card */
.card {
  background-color: #fff;
  margin-top: 16rpx;
  padding: 28rpx 30rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #222;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* Main info */
.price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.price {
  font-size: 52rpx;
  font-weight: bold;
  color: #e5441e;
}
.original-price {
  font-size: 28rpx;
  color: #bbb;
  text-decoration: line-through;
}
.unit {
  font-size: 26rpx;
  color: #999;
}
.product-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #222;
  display: block;
  line-height: 1.5;
}
.product-subtitle {
  font-size: 28rpx;
  color: #888;
  display: block;
  margin-top: 10rpx;
  line-height: 1.5;
}
.meta-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
}
.meta-tag {
  border-radius: 6rpx;
  padding: 4rpx 16rpx;
  font-size: 24rpx;
}
.stock-tag {
  background-color: #e8f5e9;
  color: #4caf50;
}
.sales-text {
  font-size: 24rpx;
  color: #aaa;
}

/* Specs */
.spec-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.spec-row {
  display: flex;
  align-items: flex-start;
}
.spec-label {
  font-size: 28rpx;
  color: #999;
  width: 160rpx;
  flex-shrink: 0;
}
.spec-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  line-height: 1.6;
}

/* Description */
.description-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  display: block;
}

/* Loading page */
.loading-page {
  height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* Action bar */
.action-bar-spacer {
  height: 130rpx;
}
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 20rpx;
  /* safe area for phones with home indicator */
  padding-bottom: env(safe-area-inset-bottom);
}
.btn-cart {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #fff5f3;
  color: #e5441e;
  border: 2rpx solid #e5441e;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-cart::after {
  border: none;
}
.btn-buy {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #e5441e;
  color: #fff;
  border: none;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-buy::after {
  border: none;
}
