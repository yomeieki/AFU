.page {
  background-color: var(--bg);
  padding-bottom: 130rpx;
}

/* Image swiper */
.img-swiper {
  width: 100%;
  height: 560rpx;
  background-color: var(--divider);
}
.swiper-img {
  width: 100%;
  height: 100%;
}
.swiper-placeholder {
  width: 100%;
  height: 100%;
  background-size: 30%;
}

/* Card（在全局 .card 基础上补间距；圆角阴影来自 app.wxss） */
.card {
  margin: 16rpx 24rpx 0;
  padding: 28rpx 30rpx;
}
.info-card {
  margin-top: -36rpx;
  position: relative;
  border-radius: var(--radius-xl) var(--radius-xl) var(--radius-md) var(--radius-md);
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--divider);
}

/* Main info */
.price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 18rpx;
}
.price-main {
  display: flex;
  align-items: baseline;
}
.detail-price-symbol {
  font-size: 30rpx;
}
.detail-price-int {
  font-size: 56rpx;
}
.detail-price-dec {
  font-size: 30rpx;
}
.original-price {
  font-size: 28rpx;
  color: var(--text-disabled);
  text-decoration: line-through;
}
.unit {
  font-size: 26rpx;
  color: var(--text-3);
}
.product-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-1);
  display: block;
  line-height: 1.5;
}
.product-subtitle {
  font-size: 28rpx;
  color: var(--text-2);
  display: block;
  margin-top: 10rpx;
  line-height: 1.5;
}
.meta-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
}
.meta-tag {
  border-radius: 6rpx;
  padding: 4rpx 16rpx;
  font-size: 24rpx;
}
.stock-tag {
  background-color: var(--success-bg);
  color: var(--success);
}
.stock-tag-low {
  background-color: var(--warning-bg);
  color: var(--warning);
}
.stock-tag-out {
  background-color: var(--gray-bg);
  color: var(--gray);
}
.sales-text {
  font-size: 24rpx;
  color: var(--text-3);
}

/* 规格/数量选择入口行（间距继承页面 .card） */
.select-sku-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.select-sku-label {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
  flex-shrink: 0;
}
.select-sku-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
  overflow: hidden;
}
.select-sku-placeholder {
  color: var(--text-3);
}
.select-sku-arrow {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

/* Specs */
.spec-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.spec-row {
  display: flex;
  align-items: flex-start;
}
.spec-label {
  font-size: 28rpx;
  color: var(--text-3);
  width: 160rpx;
  flex-shrink: 0;
}
.spec-value {
  font-size: 28rpx;
  color: var(--text-1);
  flex: 1;
  line-height: 1.6;
}

/* Description */
.description-text {
  font-size: 28rpx;
  color: var(--text-2);
  line-height: 1.8;
  display: block;
}

/* Loading page */
.loading-page {
  height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* Action bar */
.action-bar-spacer {
  height: 130rpx;
}
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--card);
  border-top: 1rpx solid var(--divider);
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  gap: 20rpx;
  animation: action-bar-in 0.2s ease-out;
}
@keyframes action-bar-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.btn-cart {
  flex: 1;
}
.btn-buy {
  flex: 1;
}

/* 多规格未选规格时显示最低价「起」 */
.detail-price-from {
  font-size: 22rpx;
  color: var(--text-3);
  margin-left: 6rpx;
  align-self: flex-end;
  padding-bottom: 6rpx;
}
