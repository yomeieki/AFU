<wxs src="../../utils/price.wxs" module="pricefmt" />
<view class="page" wx:if="{{!loading && product}}">

  <!-- Image swiper -->
  <swiper
    class="img-swiper"
    indicator-dots="{{product.images.length > 1}}"
    indicator-color="rgba(255,255,255,0.5)"
    indicator-active-color="#fff"
    autoplay="{{false}}"
    circular="{{true}}"
  >
    <swiper-item wx:for="{{product.images}}" wx:key="index">
      <image class="swiper-img" src="{{item}}" mode="aspectFill" />
    </swiper-item>
    <swiper-item wx:if="{{product.images.length === 0}}">
      <view class="swiper-placeholder img-placeholder"></view>
    </swiper-item>
  </swiper>

  <!-- Main info -->
  <view class="card info-card">
    <view class="price-row">
      <view class="price-main">
        <text class="price-symbol detail-price-symbol">¥</text>
        <text class="price-int detail-price-int">{{pricefmt.int(product.priceText)}}</text>
        <text class="price-dec detail-price-dec">{{pricefmt.dec(product.priceText)}}</text>
        <text wx:if="{{product.skus.length > 0 && !selectedSkuText}}" class="detail-price-from">起</text>
      </view>
      <text class="original-price" wx:if="{{product.originalPriceText}}">¥{{product.originalPriceText}}</text>
      <text class="unit">/ {{product.unit}}</text>
    </view>
    <text class="product-name">{{product.name}}</text>
    <view wx:if="{{product.channel === 'LOCAL'}}" class="meta-tag">
      <text>同城配送</text>
    </view>
    <text class="product-subtitle" wx:if="{{product.subtitle}}">{{product.subtitle}}</text>
    <view class="meta-row">
      <view class="meta-tag stock-tag {{product.stock <= 0 ? 'stock-tag-out' : (product.stock <= 10 ? 'stock-tag-low' : '')}}">
        <text>{{product.stockLabel}}</text>
      </view>
      <text wx:if="{{product.salesCount > 0}}" class="sales-text">已售 {{product.salesCount}}</text>
    </view>
  </view>

  <!-- 规格/数量选择入口 -->
  <view class="card select-sku-card" bindtap="onOpenSkuPopup">
    <text class="select-sku-label">{{product.skus.length > 0 ? '选择规格' : '选择数量'}}</text>
    <view class="select-sku-value">
      <text wx:if="{{selectedSkuText}}">已选：{{selectedSkuText}}</text>
      <text wx:else class="select-sku-placeholder">{{product.specHint || '请选择'}}</text>
      <view class="select-sku-arrow icon icon-arrow"></view>
    </view>
  </view>

  <!-- Specs -->
  <view class="card" wx:if="{{product.weight || product.shelfLife || product.storageMethod || product.deliveryInfo}}">
    <view class="card-title">
      <text>规格说明</text>
    </view>
    <view class="spec-list">
      <view class="spec-row" wx:if="{{product.weight}}">
        <text class="spec-label">规格/重量</text>
        <text class="spec-value">{{product.weight}}</text>
      </view>
      <view class="spec-row" wx:if="{{product.shelfLife}}">
        <text class="spec-label">保质期</text>
        <text class="spec-value">{{product.shelfLife}}</text>
      </view>
      <view class="spec-row" wx:if="{{product.storageMethod}}">
        <text class="spec-label">储存方式</text>
        <text class="spec-value">{{product.storageMethod}}</text>
      </view>
      <view class="spec-row" wx:if="{{product.deliveryInfo}}">
        <text class="spec-label">配送说明</text>
        <text class="spec-value">{{product.deliveryInfo}}</text>
      </view>
    </view>
  </view>

  <!-- Description -->
  <view class="card" wx:if="{{product.description}}">
    <view class="card-title">
      <text>商品详情</text>
    </view>
    <text class="description-text">{{product.description}}</text>
  </view>

  <!-- Bottom spacer for action bar -->
  <view class="action-bar-spacer"></view>

</view>

<!-- Loading state -->
<view wx:if="{{loading}}" class="loading-page">
  <text class="loading-text">加载中...</text>
</view>

<!-- Bottom action bar -->
<view class="action-bar safe-bottom" wx:if="{{!loading && product && entered}}">
  <button class="btn-cart btn-plain" hover-class="none" bindtap="onAddToCart">{{product.channel === 'LOCAL' ? '加入同城购物车' : '加入购物车'}}</button>
  <button wx:if="{{product.channel !== 'LOCAL'}}" class="btn-buy btn-primary" hover-class="none" bindtap="onBuyNow">立即购买</button>
  <button wx:else class="btn-buy btn-primary" hover-class="none" bindtap="goLocalCheckout">去同城结算</button>
</view>

<!-- 规格选择弹层 -->
<sku-popup
  show="{{skuPopupShow}}"
  product="{{product}}"
  mode="{{skuPopupMode}}"
  bind:confirm="onSkuConfirm"
  bind:close="onSkuPopupClose"
/>
