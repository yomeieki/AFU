.page {
  background-color: var(--bg);
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* Search bar */
.search-bar {
  background-color: var(--card);
  padding: 20rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: var(--bg);
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
  height: 40rpx;
  line-height: 40rpx;
}
.search-placeholder {
  color: var(--text-disabled);
  font-size: 28rpx;
}
.search-clear {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
  padding-left: 16rpx;
}

/* Category tag */
.category-tag-bar {
  padding: 16rpx 24rpx;
  background-color: var(--card);
  border-top: 1rpx solid var(--divider);
}
.category-tag {
  display: inline-flex;
  align-items: center;
  background-color: var(--brand-bg);
  border: 1rpx solid var(--brand-bg-deep);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.category-tag-text {
  font-size: 24rpx;
  color: var(--brand);
}
.category-tag-close {
  font-size: 30rpx;
  color: var(--brand);
  margin-left: 8rpx;
  line-height: 1;
}

/* Product list */
.product-list {
  padding: 20rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.product-row {
  display: flex;
  flex-direction: row;
  background-color: var(--card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  padding: 20rpx;
  gap: 20rpx;
  box-shadow: var(--shadow-card);
}
.product-row-hover {
  transform: scale(0.99);
}
.product-row-img-wrap {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  overflow: hidden;
}
.product-row-img {
  width: 100%;
  height: 100%;
}
.product-row-img-placeholder {
  width: 100%;
  height: 100%;
}
.product-row-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}
.product-row-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-1);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-row-subtitle {
  font-size: 24rpx;
  color: var(--text-3);
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-row-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}
.product-row-stock {
  font-size: 22rpx;
  color: var(--success);
}
.product-row-sales {
  font-size: 22rpx;
  color: var(--text-3);
}
.product-row-bottom {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}
.product-row-price-int {
  font-size: 38rpx;
}
.product-row-unit {
  font-size: 24rpx;
  color: var(--text-3);
  margin-left: 6rpx;
}

/* Footer */
.footer-tip {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: var(--text-disabled);
}
