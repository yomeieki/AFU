/* 分类页：顶部搜索 + 左分类栏 / 右商品列表（tabBar 页，100vh 即 tabBar 以上区域） */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg);
  overflow: hidden;
}

/* Search bar */
.search-bar {
  flex-shrink: 0;
  background-color: var(--card);
  padding: 20rpx 24rpx;
  z-index: 10;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: var(--bg);
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
  height: 40rpx;
  line-height: 40rpx;
}
.search-placeholder {
  color: var(--text-disabled);
  font-size: 28rpx;
}
.search-clear {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
  padding-left: 16rpx;
}

/* Search chip（搜索模式提示，点 × 回到分类模式） */
.category-tag-bar {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  background-color: var(--card);
  border-top: 1rpx solid var(--divider);
}
.category-tag {
  display: inline-flex;
  align-items: center;
  background-color: var(--brand-bg);
  border: 1rpx solid var(--brand-bg-deep);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.category-tag-text {
  font-size: 24rpx;
  color: var(--brand);
}
.category-tag-close {
  font-size: 30rpx;
  color: var(--brand);
  margin-left: 8rpx;
  line-height: 1;
  padding: 0 4rpx;
}

/* Two-column body：占满剩余高度，两侧各自独立滚动 */
.body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  border-top: 1rpx solid var(--divider);
}

/* Left: category sidebar */
.cat-panel {
  width: 180rpx;
  flex-shrink: 0;
  height: 100%;
  background-color: var(--bg);
}
.cat-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}
.cat-item-hover {
  background-color: var(--divider);
}
.cat-item-bar {
  position: absolute;
  left: 0;
  top: 30rpx;
  bottom: 30rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: transparent;
}
.cat-item-name {
  font-size: 26rpx;
  color: var(--text-2);
  text-align: center;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.cat-item.active {
  background-color: var(--card);
}
.cat-item.active .cat-item-bar {
  background: var(--brand);
}
.cat-item.active .cat-item-name {
  color: var(--brand);
  font-weight: 600;
}

/* Right: product panel wrapper（给 Task 5 的吸顶浮动条一个定位父级） */
.prod-wrap {
  flex: 1;
  min-width: 0;
  position: relative;
  height: 100%;
}
.prod-panel {
  width: 100%;
  height: 100%;
  background-color: var(--card);
}
.product-list {
  padding: 16rpx 20rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.product-row {
  display: flex;
  flex-direction: row;
  background-color: var(--card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  padding: 16rpx;
  gap: 20rpx;
  border: 1rpx solid var(--divider);
}
.product-row-hover {
  background-color: var(--bg);
}
.product-row-img-wrap {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  overflow: hidden;
}
.product-row-img {
  width: 100%;
  height: 100%;
}
.product-row-img-placeholder {
  width: 100%;
  height: 100%;
}
.product-row-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}
.product-row-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-row-subtitle {
  font-size: 22rpx;
  color: var(--text-3);
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-row-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}
.product-row-stock {
  font-size: 22rpx;
  color: var(--success);
}
.product-row-sales {
  font-size: 22rpx;
  color: var(--text-3);
}
.product-row-bottom {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
  flex-wrap: wrap;
}
.product-row-price-int {
  font-size: 36rpx;
}
.product-row-price-from {
  font-size: 20rpx;
  color: var(--text-3);
  margin-left: 2rpx;
}
.product-row-unit {
  font-size: 22rpx;
  color: var(--text-3);
  margin-left: 6rpx;
}

/* Footer */
.footer-tip {
  text-align: center;
  padding: 30rpx 0 40rpx;
  font-size: 24rpx;
  color: var(--text-disabled);
}

/* ── 同城快速加购 ─────────────────────────────────────────
   「+」推到行尾：margin-left:auto 而不是给价格区加 flex:1——
   价格区是 flex-wrap:wrap 的，给它 flex:1 会在窄屏上把「/ 份」挤到第二行。
   align-self:center：这一行是 align-items:baseline（为了让 ¥ 与整数对齐基线），
   圆按钮跟着基线走会偏低半个身位。 */
.add-btn {
  margin-left: auto;
  align-self: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: var(--brand-gradient, #e5441e);
  color: #fff;
  font-size: 32rpx;
  line-height: 48rpx;
  text-align: center;
}
.add-btn-disabled { background: var(--text-disabled, #c8c9cc); }

/* 同城下底部有购物车条（内容 112rpx + 安全区）。这一页右侧是 scroll-view，
   给 .page 加 padding 没用——要让出空位的是那个滚动容器的内容底部。 */
.page-local .prod-panel {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

/* 分段：段头与 Task 5 的浮动条尺寸必须完全一致，滚到 0 时两者重叠得看不出是两层 */
.group-anchor { padding-bottom: 8rpx; }
.group-head { height: 64rpx; line-height: 64rpx; padding: 0 20rpx; font-size: 26rpx; font-weight: 600; color: var(--text-1); background-color: var(--card); }
/* 空段要有高度：太矮的话滚过去后「段顶 <= scrollTop」立刻被下一段接管，高亮停不住 */
.group-empty { min-height: 200rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: var(--text-disabled); }
.group-tail { width: 100%; }
/* 骨架屏（样式从 pages/index/index.wxss 抄，页面样式互不可见） */
.skeleton-list { padding: 16rpx 20rpx; display: flex; flex-direction: column; gap: 16rpx; }
.skeleton-row { display: flex; gap: 20rpx; padding: 16rpx; border: 1rpx solid var(--divider); border-radius: var(--radius-lg); }
.skeleton-img { width: 160rpx; height: 160rpx; border-radius: var(--radius-md); background: var(--divider); flex-shrink: 0; }
.skeleton-lines { flex: 1; }
.skeleton-line { height: 28rpx; border-radius: 8rpx; background: var(--divider); margin-top: 8rpx; }
.skeleton-line-short { width: 55%; margin-top: 16rpx; }
.skeleton-shine { animation: skeleton-breath 1.2s ease-in-out infinite; }
@keyframes skeleton-breath { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
/* 吸顶浮动条：尺寸继承 .group-head，两者必须一样高，否则滚到 0 时露出双层段头 */
.group-float { position: absolute; top: 0; left: 0; right: 0; z-index: 5; border-bottom: 1rpx solid var(--divider); }
