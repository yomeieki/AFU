.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 130rpx;
}
.loading-wrap, .empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
}
.tip-text, .empty-text { font-size: 28rpx; color: #999; }
.empty-icon { font-size: 80rpx; }
.go-shop-btn {
  margin-top: 20rpx;
  background-color: #e5441e;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
}
.cart-list {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.cart-item {
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  gap: 16rpx;
}
.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.checkbox.checked {
  background-color: #e5441e;
  border-color: #e5441e;
}
.check-mark { font-size: 24rpx; color: #fff; }
.item-img-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f0f0f0;
  flex-shrink: 0;
}
.item-img { width: 100%; height: 100%; }
.item-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #bbb;
}
.item-info { flex: 1; display: flex; flex-direction: column; gap: 12rpx; overflow: hidden; }
.item-name {
  font-size: 28rpx;
  color: #222;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-row { display: flex; align-items: center; justify-content: space-between; }
.item-price { font-size: 32rpx; font-weight: bold; color: #e5441e; }
.item-stock { font-size: 22rpx; color: #ff9800; }
.qty-control { display: flex; align-items: center; gap: 0; }
.qty-btn {
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #555;
  background-color: #f8f8f8;
  border-radius: 6rpx;
}
.qty-num {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  border-top: 1rpx solid #ddd;
  border-bottom: 1rpx solid #ddd;
  height: 52rpx;
  line-height: 52rpx;
  display: block;
}
.delete-btn { padding: 10rpx; flex-shrink: 0; }
.delete-icon { font-size: 28rpx; color: #ccc; }
.bottom-spacer { height: 130rpx; }
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.total-wrap { flex: 1; display: flex; align-items: baseline; gap: 4rpx; }
.total-label { font-size: 28rpx; color: #666; }
.total-price { font-size: 40rpx; font-weight: bold; color: #e5441e; }
.checkout-btn {
  background-color: #e5441e;
  color: #fff;
  font-size: 30rpx;
  padding: 0 40rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
}
.checkout-btn.disabled { background-color: #ccc; }
