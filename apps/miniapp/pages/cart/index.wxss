.page {
  background-color: var(--bg);
  min-height: 100vh;
  padding-bottom: 130rpx;
}
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
}
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tip-text {
  font-size: 28rpx;
  color: var(--text-3);
}
.go-shop-btn {
  margin-top: -40rpx;
  width: 280rpx;
}

/* 商品行（卡片化） */
.cart-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 20rpx 24rpx 0;
}
.cart-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  gap: 16rpx;
}
.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--text-disabled);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}
.checkbox.checked {
  background: var(--brand-gradient);
  border-color: var(--brand);
}
.checkbox-disabled {
  opacity: 0.4;
}
.check-mark {
  width: 28rpx;
  height: 28rpx;
}
.item-img-wrap {
  width: 150rpx;
  height: 150rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
}
.item-img {
  width: 100%;
  height: 100%;
}
.item-img-placeholder {
  width: 100%;
  height: 100%;
}
.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  overflow: hidden;
}
.item-name {
  font-size: 28rpx;
  color: var(--text-1);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-spec {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  align-self: flex-start;
}
.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.item-price-wrap {
  display: flex;
  align-items: baseline;
}
.item-price-int {
  font-size: 34rpx;
}
.item-stock {
  font-size: 22rpx;
  color: var(--warning);
}
.stepper-disabled {
  opacity: 0.4;
}
.delete-btn {
  padding: 10rpx;
  flex-shrink: 0;
}
.delete-icon {
  font-size: 28rpx;
  color: var(--text-disabled);
}

/* 结算栏 */
.bottom-spacer {
  height: 130rpx;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--card);
  border-top: 1rpx solid var(--divider);
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  gap: 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.03);
}
.total-wrap {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}
.total-label {
  font-size: 28rpx;
  color: var(--text-2);
  margin-right: 8rpx;
}
.total-price-int {
  font-size: 44rpx;
}
.checkout-btn {
  padding: 0 44rpx;
}
