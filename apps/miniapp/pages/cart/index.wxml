<wxs src="../../utils/price.wxs" module="pricefmt" />
<view class="page">

  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="tip-text">加载中...</text>
  </view>

  <view wx:elif="{{items.length === 0}}" class="empty-wrap">
    <empty-state type="cart" text="购物车还是空的" />
    <view wx:if="{{localPendingCount > 0}}" class="cross-channel-tip" bindtap="goLocal">
      你在同城配送还有 {{localPendingCount}} 件未结算 <text class="icon icon-arrow"></text>
    </view>
    <navigator url="/pages/index/index" open-type="switchTab" class="go-shop-btn btn-primary">
      去逛逛
    </navigator>
  </view>

  <view wx:else>
    <!-- Cart items -->
    <view class="cart-list">
      <view wx:for="{{items}}" wx:key="id" class="cart-item card">
        <!-- Checkbox -->
        <view
          class="checkbox {{item.isSelected ? 'checked' : ''}} {{item.status !== 'ON_SHELF' ? 'checkbox-disabled' : ''}}"
          bindtap="onToggleSelect"
          data-id="{{item.id}}"
        >
          <view wx:if="{{item.isSelected}}" class="check-mark icon icon-check"></view>
        </view>

        <!-- Image -->
        <view class="item-img-wrap">
          <image
            wx:if="{{item.productImage}}"
            class="item-img"
            src="{{item.productImage}}"
            mode="aspectFill"
          />
          <view wx:else class="item-img-placeholder img-placeholder"></view>
        </view>

        <!-- Info -->
        <view class="item-info">
          <text class="item-name">{{item.productName}}</text>
          <text class="item-spec" wx:if="{{item.specText}}">{{item.specText}}</text>
          <view class="item-row">
            <view class="item-price-wrap">
              <text class="price-symbol">¥</text>
              <text class="price-int item-price-int">{{pricefmt.int(item.priceText)}}</text>
              <text class="price-dec">{{pricefmt.dec(item.priceText)}}</text>
            </view>
            <view class="qty-control stepper {{item.status !== 'ON_SHELF' ? 'stepper-disabled' : ''}}">
              <view class="qty-btn stepper-btn" bindtap="onDecrease" data-id="{{item.id}}">
                <text>−</text>
              </view>
              <text class="qty-num stepper-num">{{item.quantity}}</text>
              <view class="qty-btn stepper-btn" bindtap="onIncrease" data-id="{{item.id}}">
                <text>+</text>
              </view>
            </view>
          </view>
          <text class="item-stock" wx:if="{{item.status !== 'ON_SHELF'}}">该商品已下架</text>
        </view>

        <!-- Delete -->
        <view class="delete-btn" bindtap="onDelete" data-id="{{item.id}}">
          <text class="delete-icon">✕</text>
        </view>
      </view>
    </view>

    <!-- Bottom bar -->
    <view class="bottom-bar">
      <view class="total-wrap">
        <text class="total-label">合计</text>
        <text class="price-symbol">¥</text>
        <text class="price-int total-price-int">{{pricefmt.int(pricefmt.fen(totalAmount))}}</text>
        <text class="price-dec">{{pricefmt.dec(pricefmt.fen(totalAmount))}}</text>
      </view>
      <view
        class="checkout-btn btn-primary {{selectedCount === 0 ? 'btn-disabled' : ''}}"
        bindtap="onCheckout"
      >
        <text>结算（{{selectedCount}}）</text>
      </view>
    </view>
    <view class="bottom-spacer"></view>
  </view>

</view>

<privacy-popup id="privacy-popup" />
