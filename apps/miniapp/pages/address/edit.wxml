<view class="page">
  <view class="form">

    <view class="field-group">
      <view class="field">
        <text class="label">收货人</text>
        <input
          class="input"
          placeholder="请输入收货人姓名"
          value="{{form.receiverName}}"
          data-field="receiverName"
          bindinput="onInput"
        />
      </view>
      <view class="field">
        <text class="label">手机号</text>
        <input
          class="input"
          type="number"
          placeholder="请输入手机号"
          value="{{form.receiverPhone}}"
          data-field="receiverPhone"
          bindinput="onInput"
          maxlength="11"
        />
      </view>
    </view>

    <view class="field-group">
      <view class="field">
        <text class="label">省份</text>
        <input
          class="input"
          placeholder="如：广东省"
          value="{{form.province}}"
          data-field="province"
          bindinput="onInput"
        />
      </view>
      <view class="field">
        <text class="label">城市</text>
        <input
          class="input"
          placeholder="如：广州市"
          value="{{form.city}}"
          data-field="city"
          bindinput="onInput"
        />
      </view>
      <view class="field">
        <text class="label">区县</text>
        <input
          class="input"
          placeholder="如：天河区"
          value="{{form.district}}"
          data-field="district"
          bindinput="onInput"
        />
      </view>
      <view class="field">
        <text class="label">详细地址</text>
        <input
          class="input"
          placeholder="街道、门牌号等"
          value="{{form.detail}}"
          data-field="detail"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="field-group">
      <view class="field switch-field" bindtap="onToggleDefault">
        <text class="label">设为默认地址</text>
        <view class="switch {{form.isDefault ? 'on' : ''}}">
          <view class="switch-thumb"></view>
        </view>
      </view>
    </view>

  </view>

  <view class="save-btn {{saving ? 'disabled' : ''}}" bindtap="onSave">
    <text>{{saving ? '保存中...' : '保存地址'}}</text>
  </view>
</view>
