<view class="page">
  <view class="form">

    <!-- 同城配送：地图选点（必填，配送费按实际距离算） -->
    <block wx:if="{{channel === 'LOCAL'}}">
      <view
        class="locate-card {{poiName ? 'locate-card-done' : ''}}"
        hover-class="locate-card-hover"
        bindtap="onPickLocation"
      >
        <view class="locate-icon icon icon-pin"></view>
        <view class="locate-body">
          <view class="locate-title-row">
            <text class="locate-title">{{poiName || '在地图上选择收货位置'}}</text>
            <text wx:if="{{!poiName}}" class="locate-required">必填</text>
          </view>
          <text class="locate-sub">{{poiName ? pickedAddress : '同城配送按实际距离计费，需要定位到楼栋'}}</text>
        </view>
        <text class="locate-action">{{locating ? '打开中' : (poiName ? '重选' : '去选点')}}</text>
      </view>

      <view wx:if="{{quoteText}}" class="quote-strip {{quoteOk ? '' : 'quote-strip-warn'}}">
        <text class="quote-text">{{quoteText}}</text>
      </view>
    </block>

    <!-- 导入微信收货地址 -->
    <view class="import-btn" hover-class="import-btn-hover" bindtap="onImportWechatAddress">
      <view class="import-icon icon icon-pin"></view>
      <text class="import-text">导入微信收货地址</text>
      <view class="import-arrow icon icon-arrow"></view>
    </view>

    <view class="field-group">
      <view class="field">
        <text class="label">收货人</text>
        <input
          class="input"
          placeholder-class="input-placeholder"
          placeholder="请输入收货人姓名"
          value="{{form.receiverName}}"
          data-field="receiverName"
          bindinput="onInput"
        />
      </view>
      <view class="field">
        <text class="label">手机号</text>
        <input
          class="input"
          placeholder-class="input-placeholder"
          type="number"
          placeholder="请输入手机号"
          value="{{form.receiverPhone}}"
          data-field="receiverPhone"
          bindinput="onInput"
          maxlength="11"
        />
      </view>
    </view>

    <view class="field-group">
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="field picker-field">
          <text class="label">所在地区</text>
          <text class="picker-value {{regionText ? '' : 'input-placeholder'}}">{{regionText || '请选择省市区'}}</text>
          <view class="picker-arrow icon icon-arrow"></view>
        </view>
      </picker>
      <view class="field">
        <text class="label">详细地址</text>
        <input
          class="input"
          placeholder-class="input-placeholder"
          placeholder="{{channel === 'LOCAL' ? '补充楼栋单元门牌，如 3栋2单元501' : '街道、小区、门牌号（如：丹桂大街 xx 号）'}}"
          value="{{form.detail}}"
          data-field="detail"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="field-group">
      <view class="field switch-field" bindtap="onToggleDefault">
        <text class="label">设为默认地址</text>
        <view class="switch {{form.isDefault ? 'on' : ''}}">
          <view class="switch-thumb"></view>
        </view>
      </view>
    </view>

  </view>

  <view class="save-btn btn-primary {{saving ? 'btn-disabled' : ''}}" bindtap="onSave">
    <text>{{saving ? '保存中...' : '保存地址'}}</text>
  </view>
</view>
