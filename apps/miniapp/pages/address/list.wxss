.page {
  background-color: var(--bg);
  min-height: 100vh;
  padding-bottom: 40rpx;
}
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  gap: 24rpx;
}
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tip-text {
  font-size: 28rpx;
  color: var(--text-3);
}
.add-btn-inline {
  margin-top: -40rpx;
  width: 300rpx;
}

/* 地址卡片 */
.address-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}
.address-card {
  padding: 28rpx 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.address-card-hover {
  transform: scale(0.99);
}
.address-pin {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.address-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow: hidden;
}
.address-receiver {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.receiver-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
}
.receiver-phone {
  font-size: 28rpx;
  color: var(--text-2);
}
.default-tag {
  background-color: var(--brand-bg);
  color: var(--brand);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--brand-bg-deep);
}
.address-full {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}
/* 缺定位的地址：**不整卡压暗**。原来是 opacity:0.55，把姓名与电话一起变灰——
   那两项完全是好的，压暗它们既没道理又让顾客看不清自己填的是谁。
   缺的只是坐标，所以警示只画在左侧的一根竖条与那颗标签上（见 .local-distance-tag-missing），
   卡片本身照常可读、照常可点（点它进编辑页补定位）。 */
.address-card-location-missing {
  border-left: 6rpx solid var(--warning, #ff9500);
}
.local-distance-tag {
  align-self: flex-start;
  color: var(--info);
  background-color: var(--info-bg);
  font-size: 22rpx;
  line-height: 1.4;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.local-distance-tag-missing {
  color: var(--text-3);
  background-color: var(--bg);
}
.local-distance-tag-far {
  color: var(--warning);
  background-color: var(--warning-bg);
}
.address-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  flex-shrink: 0;
}
.action-btn {
  font-size: 26rpx;
  color: var(--info);
}
.action-btn.delete {
  color: var(--danger);
}
.select-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

/* 底部固定新增按钮 */
.add-btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  background-color: var(--card);
  border-top: 1rpx solid var(--divider);
}
/* btn-primary 自带左右 48rpx 内边距，width:100% 不加 border-box 会溢出屏幕右侧 */
.add-btn {
  width: 100%;
  box-sizing: border-box;
}
.add-btn-spacer {
  height: 140rpx;
}
