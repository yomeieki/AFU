.page {
  background-color: var(--bg);
  min-height: 100vh;
  padding-bottom: 40rpx;
}
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  gap: 24rpx;
}
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tip-text {
  font-size: 28rpx;
  color: var(--text-3);
}
.add-btn-inline {
  margin-top: -40rpx;
  width: 300rpx;
}

/* 地址卡片 */
.address-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}
.address-card {
  padding: 28rpx 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.address-card-hover {
  transform: scale(0.99);
}
.address-pin {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.address-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow: hidden;
}
.address-receiver {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.receiver-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
}
.receiver-phone {
  font-size: 28rpx;
  color: var(--text-2);
}
.default-tag {
  background-color: var(--brand-bg);
  color: var(--brand);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--brand-bg-deep);
}
.address-full {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}
.address-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  flex-shrink: 0;
}
.action-btn {
  font-size: 26rpx;
  color: var(--info);
}
.action-btn.delete {
  color: var(--danger);
}
.select-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

/* 底部固定新增按钮 */
.add-btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  background-color: var(--card);
  border-top: 1rpx solid var(--divider);
}
.add-btn {
  width: 100%;
}
.add-btn-spacer {
  height: 140rpx;
}
