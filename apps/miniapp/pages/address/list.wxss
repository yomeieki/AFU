.page { background-color: #f5f5f5; min-height: 100vh; padding-bottom: 40rpx; }
.loading-wrap, .empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  gap: 24rpx;
}
.tip-text, .empty-text { font-size: 28rpx; color: #999; }
.address-list { display: flex; flex-direction: column; gap: 16rpx; padding: 20rpx 24rpx; }
.address-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.address-card.selectable { active-opacity: 0.8; }
.address-main { flex: 1; display: flex; flex-direction: column; gap: 10rpx; }
.address-receiver { display: flex; align-items: center; gap: 16rpx; }
.receiver-name { font-size: 30rpx; font-weight: bold; color: #222; }
.receiver-phone { font-size: 28rpx; color: #666; }
.default-tag {
  background-color: #e5441e;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}
.address-full { font-size: 26rpx; color: #888; line-height: 1.5; }
.address-actions { display: flex; flex-direction: column; gap: 16rpx; }
.action-btn { font-size: 26rpx; color: #4a90e2; }
.action-btn.delete { color: #f44336; }
.select-icon { font-size: 28rpx; color: #ccc; }
.add-btn-wrap { padding: 24rpx; }
.add-btn {
  background-color: #e5441e;
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
}
