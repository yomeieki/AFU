<view class="page">

  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="tip-text">加载中...</text>
  </view>

  <view wx:elif="{{addresses.length === 0}}" class="empty-wrap">
    <empty-state type="address" text="还没有收货地址" />
    <view class="add-btn-inline btn-primary" bindtap="onAddAddress">新增地址</view>
  </view>

  <view wx:else>
    <view class="address-list">
      <view
        wx:for="{{addresses}}"
        wx:key="id"
        class="address-card card {{mode === 'select' ? 'selectable' : ''}} {{channel === 'LOCAL' && item.localStatus === 'missing' ? 'address-card-location-missing' : ''}}"
        hover-class="address-card-hover"
        bindtap="onSelectAddress"
        data-address="{{item}}"
      >
        <view class="address-pin icon icon-pin"></view>
        <view class="address-main">
          <view class="address-receiver">
            <text class="receiver-name">{{item.receiverName}}</text>
            <text class="receiver-phone">{{item.receiverPhone}}</text>
            <view wx:if="{{item.isDefault}}" class="default-tag">默认</view>
          </view>
          <text class="address-full">{{item.fullAddress}}</text>
          <view wx:if="{{channel === 'LOCAL' && item.localDistanceText}}" class="local-distance-tag {{item.localStatus === 'missing' ? 'local-distance-tag-missing' : ''}} {{item.localStatus === 'far' ? 'local-distance-tag-far' : ''}}">
            {{item.localDistanceText}}
          </view>
        </view>
        <view class="address-actions" wx:if="{{mode !== 'select'}}">
          <view class="action-btn" catchtap="onEditAddress" data-id="{{item.id}}">编辑</view>
          <view class="action-btn delete" catchtap="onDeleteAddress" data-id="{{item.id}}">删除</view>
        </view>
        <view class="select-icon icon icon-arrow" wx:if="{{mode === 'select'}}"></view>
      </view>
    </view>

    <!-- 选择模式（从下单页进来）同样可以新增：填错/换地址时不用退回「我的」再来 -->
    <view class="add-btn-wrap safe-bottom">
      <view class="add-btn btn-primary" bindtap="onAddAddress">+ 新增收货地址</view>
    </view>
    <view class="add-btn-spacer"></view>
  </view>

</view>
