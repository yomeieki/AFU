.page { background-color: #f5f5f5; min-height: 100vh; padding: 20rpx; }
.form { display: flex; flex-direction: column; gap: 16rpx; }
.field-group { background-color: #fff; border-radius: 12rpx; overflow: hidden; }
.field {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 20rpx;
}
.field:last-child { border-bottom: none; }
.label { width: 140rpx; font-size: 28rpx; color: #333; flex-shrink: 0; }
.input { flex: 1; font-size: 28rpx; color: #222; }
.switch-field { justify-content: space-between; }
.switch {
  width: 96rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background-color: #ddd;
  position: relative;
  transition: background-color 0.2s;
}
.switch.on { background-color: #e5441e; }
.switch-thumb {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background-color: #fff;
  transition: left 0.2s;
}
.switch.on .switch-thumb { left: 50rpx; }
.save-btn {
  margin-top: 40rpx;
  background-color: #e5441e;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 12rpx;
}
.save-btn.disabled { background-color: #ccc; }
