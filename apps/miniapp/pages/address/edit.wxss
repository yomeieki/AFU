.page {
  background-color: var(--bg);
  min-height: 100vh;
  padding: 20rpx 24rpx;
}
.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 导入微信收货地址入口（浅品牌底、胶囊感卡片） */
.import-btn {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 30rpx;
  background-color: var(--brand-bg);
  border: 1rpx solid var(--brand-bg-deep);
  border-radius: var(--radius-lg);
}
.import-btn-hover {
  background-color: var(--brand-bg-deep);
}
.import-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}
.import-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--brand);
}
.import-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.field-group {
  background-color: var(--card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}
.field {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--divider);
  gap: 20rpx;
}
.field:last-child {
  border-bottom: none;
}
/* picker 外层包裹后，.field 不再是 group 的直接子元素，手动保留分隔线 */
.picker-field {
  border-bottom: 1rpx solid var(--divider);
}
.label {
  width: 152rpx;
  font-size: 28rpx;
  color: var(--text-1);
  flex-shrink: 0;
}
.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}
.input-placeholder {
  color: var(--text-disabled);
}

/* 省市区选择器行 */
.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* 默认地址开关（品牌渐变） */
.switch-field {
  justify-content: space-between;
}
.switch-field .label {
  width: auto;
}
.switch {
  width: 96rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background-color: var(--text-disabled);
  position: relative;
  transition: background-color 0.2s;
}
.switch.on {
  background: var(--brand-gradient);
}
.switch-thumb {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  transition: left 0.2s;
}
.switch.on .switch-thumb {
  left: 50rpx;
}

/* 保存按钮 */
.save-btn {
  margin-top: 48rpx;
  height: 88rpx;
}
