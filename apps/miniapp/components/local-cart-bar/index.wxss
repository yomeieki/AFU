.cart-detail {
  position: fixed;
  z-index: 80;
  left: 0;
  right: 0;
  max-height: 56vh;
  padding: 22rpx 24rpx 12rpx;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
}
.cart-detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--divider);
}
.cart-detail-title { font-size: 30rpx; font-weight: 600; }
.cart-detail-close,
.cart-delete { color: var(--text-3); font-size: 24rpx; }
.cart-detail-list { max-height: 42vh; }
.cart-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--divider);
}
.cart-img-wrap {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: var(--radius-sm);
}
.cart-img { width: 100%; height: 100%; }
.cart-item-info { flex: 1; min-width: 0; }
.cart-item-name {
  display: block;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-item-spec,
.cart-item-price {
  display: block;
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 22rpx;
}
.cart-item-price { color: var(--brand); }
.cart-item-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}
.cart-delete { padding: 4rpx; }
.stepper { display: flex; align-items: center; gap: 4rpx; }
.stepper-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-sm);
  background: var(--divider);
  color: var(--text-1);
  font-size: 26rpx;
  line-height: 44rpx;
  text-align: center;
}
.stepper-btn.disabled { color: var(--text-disabled); }
.stepper-num { min-width: 52rpx; text-align: center; font-size: 26rpx; }

.cart-dock { position: fixed; z-index: 90; left: 0; right: 0; bottom: 0; }
.local-cart-bar {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 10rpx 12rpx 10rpx 24rpx;
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  background: #2b2b2b;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.12);
}
.cart-summary { display: flex; align-items: center; min-width: 0; flex: 1; color: #fff; }
.cart-icon { position: relative; width: 68rpx; height: 68rpx; border-radius: 50%; background: #3c3c3c; flex-shrink: 0; margin-right: 14rpx; }
.cart-drawing { position: absolute; left: 19rpx; top: 19rpx; width: 28rpx; height: 22rpx; border: 3rpx solid #fff; border-top: none; transform: skew(-8deg); }
.cart-drawing::before { content: ''; position: absolute; left: -8rpx; top: -7rpx; width: 8rpx; border-top: 3rpx solid #fff; }
.cart-drawing::after { content: ''; position: absolute; bottom: -11rpx; left: 2rpx; width: 5rpx; height: 5rpx; border-radius: 50%; background: #fff; box-shadow: 20rpx 0 #fff; }
.cart-badge { position: absolute; top: -5rpx; right: -6rpx; min-width: 28rpx; height: 28rpx; padding: 0 5rpx; box-sizing: border-box; border-radius: 999rpx; background: var(--brand); color: #fff; font-size: 19rpx; line-height: 28rpx; text-align: center; }
.cart-summary-text { min-width: 0; }
.cart-summary-main { white-space: nowrap; line-height: 1.1; }
.cart-summary-amount { color: #fff; font-size: 34rpx; font-weight: 700; }
.cart-summary-orig { margin-left: 8rpx; color: #8c8c8c; font-size: 23rpx; text-decoration: line-through; }
.cart-summary-sub { display: block; margin-top: 3rpx; color: #a8a8a8; font-size: 21rpx; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.local-cart-bar .checkout-btn {
  height: 68rpx;
  min-width: 200rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  margin-left: auto;
  box-sizing: border-box;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-weight: 600;
  white-space: nowrap;
}
.cart-tip { font-size: 24rpx; padding: 10rpx 20rpx; text-align: center; background: #fff7e6; color: #9a3412; border-top: 1rpx solid #fde7c7; }
.cart-tip-done { background: var(--success-bg); color: #166534; border-top-color: #dcfce7; }
.cart-tip-em { color: var(--brand); font-weight: 600; }
