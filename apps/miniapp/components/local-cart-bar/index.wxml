<wxs src="../../utils/price.wxs" module="pricefmt" />

<!-- 展开的明细面板。压在合计条之上，车空时整块不渲染。 -->
<view wx:if="{{expanded && items.length > 0}}" class="cart-detail" style="bottom: {{dockPx}}px;">
  <view class="cart-detail-head">
    <text class="cart-detail-title">{{channel === 'EXPRESS' ? '邮寄购物车' : '同城购物车'}}</text>
    <text class="cart-detail-close" bindtap="toggle">收起</text>
  </view>
  <scroll-view class="cart-detail-list" scroll-y>
    <view wx:for="{{items}}" wx:key="id" class="cart-item">
      <view class="cart-img-wrap">
        <image wx:if="{{item.productImage}}" class="cart-img" src="{{item.productImage}}" mode="aspectFill" />
        <view wx:else class="cart-img img-placeholder"></view>
      </view>
      <view class="cart-item-info">
        <text class="cart-item-name">{{item.productName}}</text>
        <text wx:if="{{item.specText}}" class="cart-item-spec">{{item.specText}}</text>
        <text class="cart-item-price">¥{{pricefmt.fen(item.price)}}</text>
      </view>
      <view class="cart-item-actions">
        <view class="stepper">
          <view class="stepper-btn {{item.quantity <= 1 ? 'disabled' : ''}}" bindtap="onDecrease" data-id="{{item.id}}">−</view>
          <text class="stepper-num">{{item.quantity}}</text>
          <view class="stepper-btn" bindtap="onIncrease" data-id="{{item.id}}">+</view>
        </view>
        <view class="cart-delete" bindtap="onDelete" data-id="{{item.id}}">删除</view>
      </view>
    </view>
  </scroll-view>
</view>

<!-- WebView 底部紧贴原生 tabBar；整个 dock（含提示）统一量高。 -->
<view wx:if="{{count > 0}}" class="cart-dock">
  <view wx:if="{{tip.show}}" class="cart-tip {{tip.tone === 'done' ? 'cart-tip-done' : ''}}"><text class="cart-tip-em">{{tip.text}}</text></view>
  <view class="local-cart-bar" bindtap="toggle">
    <view class="cart-summary">
      <view class="cart-icon"><view class="cart-drawing"></view><view class="cart-badge">{{count}}</view></view>
      <view class="cart-summary-text">
        <view class="cart-summary-main"><text class="cart-summary-amount">{{amountText}}</text><text wx:if="{{origText}}" class="cart-summary-orig">{{origText}}</text></view>
        <text class="cart-summary-sub">{{subText}}</text>
      </view>
    </view>
    <view class="checkout-btn {{disabled ? 'btn-disabled' : 'btn-primary'}}" catchtap="goCheckout">{{actionText}}</view>
  </view>
</view>
