/* 空态组件：插画 + 文案 + 可选按钮（颜色经 CSS 变量继承自 app.wxss） */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx;
}
.empty-img {
  width: 320rpx;
  height: 260rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--text-3, #999);
}
.empty-action {
  margin-top: 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 56rpx;
  background: var(--brand-gradient, linear-gradient(135deg, #ff6a3d 0%, #e5441e 100%));
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

/* 插画（源文件 scripts/svg-src/empty-*.svg） */
.empty-img-cart {
  background-image: url("data:image/svg+xml;base64,");
}
.empty-img-order {
  background-image: url("data:image/svg+xml;base64,");
}
.empty-img-address {
  background-image: url("data:image/svg+xml;base64,");
}
.empty-img-product,
.empty-img-generic {
  background-image: url("data:image/svg+xml;base64,");
}
