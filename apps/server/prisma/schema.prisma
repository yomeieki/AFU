generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// 用户
// ─────────────────────────────────────────────────────────
model User {
  id          Int       @id @default(autoincrement())
  openid      String    @unique @db.VarChar(64)
  unionid     String?   @db.VarChar(64)
  nickname    String?   @db.VarChar(64)
  avatarUrl   String?   @map("avatar_url") @db.VarChar(500)
  phone       String?   @db.VarChar(20)
  status      Int       @default(1) @db.TinyInt
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  carts     Cart[]
  addresses Address[]
  orders    Order[]
  scanLogs  ScanLog[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────
// 后台管理员
// ─────────────────────────────────────────────────────────
model Admin {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(64)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String?   @db.VarChar(64)
  role         String    @default("admin") @db.VarChar(32)
  status       Int       @default(1) @db.TinyInt
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

// ─────────────────────────────────────────────────────────
// 商品分类
// ─────────────────────────────────────────────────────────
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(64)
  iconUrl   String?   @map("icon_url") @db.VarChar(500)
  sortOrder Int       @default(0) @map("sort_order")
  status    Int       @default(1) @db.TinyInt
  // 渠道：EXPRESS=全国邮寄 LOCAL=同城配送。一个分类只属于一个渠道，商品随分类归属
  channel   String    @default("EXPRESS") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@index([status, sortOrder])
  @@index([channel, status, sortOrder])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────
// 商品
// ─────────────────────────────────────────────────────────
model Product {
  id            Int       @id @default(autoincrement())
  categoryId    Int       @map("category_id")
  name          String    @db.VarChar(128)
  subtitle      String?   @db.VarChar(255)
  coverImage    String?   @map("cover_image") @db.VarChar(500)
  price         Int
  originalPrice Int?      @map("original_price")
  stock         Int       @default(0)
  salesCount    Int       @default(0) @map("sales_count")
  unit          String    @default("份") @db.VarChar(16)
  weight        String?   @db.VarChar(32)
  shelfLife     String?   @map("shelf_life") @db.VarChar(64)
  storageMethod String?   @map("storage_method") @db.VarChar(128)
  deliveryInfo  String?   @map("delivery_info") @db.Text
  description   String?   @db.Text
  // ON_SHELF=上架  OFF_SHELF=下架  DELETED=已删除
  status        String    @default("ON_SHELF") @db.VarChar(16)
  // @deprecated 历史列，渠道以 channel 为准；后台不再写入
  deliveryType  String    @default("EXPRESS") @map("delivery_type") @db.VarChar(64)
  // 渠道冗余自分类（只在 services/product-channel.ts 写入），列表按渠道过滤不必 join
  channel       String    @default("EXPRESS") @db.VarChar(16)
  // 净重（克），同城下单换算快递100 weight(kg)；空则用同城设置的默认值
  netWeightG    Int?      @map("net_weight_g")
  isRecommended Int       @default(0) @map("is_recommended") @db.TinyInt
  qrScene       String?   @map("qr_scene") @db.VarChar(64)
  qrCodeUrl     String?   @map("qr_code_url") @db.VarChar(500)
  qrGeneratedAt DateTime? @map("qr_generated_at")
  // 规格维度定义 [{name:"辣度",values:["微辣","中辣"]},...]；null=无规格商品
  specDimensions Json?    @map("spec_dimensions")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  skus       ProductSku[]
  carts      Cart[]
  orderItems OrderItem[]
  scanLogs   ScanLog[]

  @@index([categoryId, status])
  @@index([status, isRecommended])
  @@index([channel, status])
  @@map("products")
}

// ─────────────────────────────────────────────────────────
// 商品规格 SKU（有 SKU 的商品：product.price=min(sku.price)、product.stock=sum(sku.stock) 由服务端写入时同步）
// ─────────────────────────────────────────────────────────
model ProductSku {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  // 展示与匹配键，如 "中辣/去骨/250g"（各维度值按 specDimensions 顺序以 / 连接）
  specText      String   @map("spec_text") @db.VarChar(128)
  // ["中辣","去骨","250g"] 与 specDimensions 顺序一一对应
  specValues    Json     @map("spec_values")
  price         Int
  originalPrice Int?     @map("original_price")
  stock         Int      @default(0)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  carts   Cart[]

  @@unique([productId, specText])
  @@map("product_skus")
}

// ─────────────────────────────────────────────────────────
// 商品图片
// ─────────────────────────────────────────────────────────
model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  imageUrl  String   @map("image_url") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ─────────────────────────────────────────────────────────
// 购物车
// ─────────────────────────────────────────────────────────
model Cart {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  productId  Int      @map("product_id")
  skuId      Int?     @map("sku_id")
  quantity   Int      @default(1)
  isSelected Int      @default(1) @map("is_selected") @db.TinyInt
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id])
  product Product     @relation(fields: [productId], references: [id])
  sku     ProductSku? @relation(fields: [skuId], references: [id], onDelete: Cascade)

  // 同一 user+product+sku 一行；skuId 为 NULL 时 MySQL 唯一索引不生效，由代码 findFirst 保证
  @@unique([userId, productId, skuId])
  @@map("carts")
}

// ─────────────────────────────────────────────────────────
// 收货地址
// ─────────────────────────────────────────────────────────
model Address {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  receiverName  String    @map("receiver_name") @db.VarChar(64)
  receiverPhone String    @map("receiver_phone") @db.VarChar(20)
  province      String    @db.VarChar(32)
  city          String    @db.VarChar(32)
  district      String    @db.VarChar(32)
  detail        String    @db.VarChar(255)
  fullAddress   String    @map("full_address") @db.VarChar(500)
  // GCJ-02 微度坐标 + 地图选点 POI 名；EXPRESS 地址可为空，LOCAL 下单必填
  latE6         Int?      @map("lat_e6")
  lngE6         Int?      @map("lng_e6")
  poiName       String?   @map("poi_name") @db.VarChar(128)
  isDefault     Int       @default(0) @map("is_default") @db.TinyInt
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────
// 订单
// ─────────────────────────────────────────────────────────
model Order {
  id                  Int       @id @default(autoincrement())
  orderNo             String    @unique @map("order_no") @db.VarChar(32)
  userId              Int       @map("user_id")
  // PENDING_PAYMENT / PAID(待接单) / PREPARING(备餐中) / SHIPPED / COMPLETED / CANCELLED / REFUNDING / REFUNDED
  status              String    @db.VarChar(32)
  totalAmount         Int       @map("total_amount")
  shippingFee         Int       @default(0) @map("shipping_fee")
  actualAmount        Int       @map("actual_amount")
  deliveryType        String    @map("delivery_type") @db.VarChar(16)
  remark              String?   @db.VarChar(255)
  // 收货地址快照
  receiverName        String    @map("receiver_name") @db.VarChar(64)
  receiverPhone       String    @map("receiver_phone") @db.VarChar(20)
  receiverProvince    String    @map("receiver_province") @db.VarChar(32)
  receiverCity        String    @map("receiver_city") @db.VarChar(32)
  receiverDistrict    String    @map("receiver_district") @db.VarChar(32)
  receiverDetail      String    @map("receiver_detail") @db.VarChar(255)
  receiverFullAddress String    @map("receiver_full_address") @db.VarChar(500)
  paidAt              DateTime? @map("paid_at")
  // 商家接单时间（PAID → PREPARING）
  acceptedAt          DateTime? @map("accepted_at")
  // 完成时间（确认收货）
  completedAt         DateTime? @map("completed_at")
  // 退款完成时间（REFUNDING → REFUNDED，仅全额退完时写）
  refundedAt          DateTime? @map("refunded_at")
  // 已成功退款累计金额（分），部分退款多次累加；== actualAmount 即全额退完
  refundedAmount      Int       @default(0) @map("refunded_amount")
  // 付款后超时未接单的催单已推送时间（定时任务只催一次）
  acceptRemindedAt    DateTime? @map("accept_reminded_at")
  cancelledAt         DateTime? @map("cancelled_at")
  cancelReason        String?   @map("cancel_reason") @db.VarChar(255)
  // ── 同城配送快照（deliveryType=LOCAL 时写入）──
  receiverLatE6       Int?      @map("receiver_lat_e6")
  receiverLngE6       Int?      @map("receiver_lng_e6")
  receiverPoiName     String?   @map("receiver_poi_name") @db.VarChar(128)
  // 计费距离（米）= 直线 × detourFactor
  distanceM           Int?      @map("distance_m")
  estimatedDeliveryAt DateTime? @map("estimated_delivery_at")
  // 顾客在接单后宽限期内申请取消（D6 ②）；快照当时有效配送单状态，NONE=无单
  cancelRequestedAt   DateTime? @map("cancel_requested_at")
  cancelRequestNote   String?   @map("cancel_request_note") @db.VarChar(255)
  cancelRequestDeliveryStatus String? @map("cancel_request_delivery_status") @db.VarChar(16)
  // 未接单重复播报（M2b）
  announceCount       Int       @default(0) @map("announce_count")
  lastAnnouncedAt     DateTime? @map("last_announced_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
  payment    Payment?
  shipment   Shipment?
  refunds    Refund[]
  afterSales AfterSale[]
  deliveries Delivery[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("orders")
}

// ─────────────────────────────────────────────────────────
// 订单商品（含商品快照）
// ─────────────────────────────────────────────────────────
model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  productId    Int?     @map("product_id")
  // SKU 快照（无外键，商品规格变更/删除不影响历史订单）
  skuId        Int?     @map("sku_id")
  specText     String?  @map("spec_text") @db.VarChar(128)
  productName  String   @map("product_name") @db.VarChar(128)
  productImage String?  @map("product_image") @db.VarChar(500)
  productPrice Int      @map("product_price")
  quantity     Int
  subtotal     Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────
// 支付记录
// ─────────────────────────────────────────────────────────
model Payment {
  id              Int       @id @default(autoincrement())
  orderId         Int       @unique @map("order_id")
  orderNo         String    @map("order_no") @db.VarChar(32)
  // MOCK / WECHAT
  paymentType     String    @map("payment_type") @db.VarChar(16)
  // 微信 out_trade_no（格式 order_<orderId>_<timestamp>），用于对账和退款
  outTradeNo      String?   @map("out_trade_no") @db.VarChar(64)
  amount          Int
  // PENDING / SUCCESS / FAILED / REFUNDED
  status          String    @db.VarChar(16)
  wxPrepayId      String?   @map("wx_prepay_id") @db.VarChar(64)
  wxTransactionId String?   @unique @map("wx_transaction_id") @db.VarChar(64)
  wxNotifyData    String?   @map("wx_notify_data") @db.Text
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderNo])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────
// 退款记录（微信退款 API，支持全额与部分退款；每笔发起一条）
// ─────────────────────────────────────────────────────────
model Refund {
  id             Int       @id @default(autoincrement())
  orderId        Int       @map("order_id")
  orderNo        String    @map("order_no") @db.VarChar(32)
  outTradeNo     String?   @map("out_trade_no") @db.VarChar(64)
  // 商户退款单号 refund_<orderId>_<timestamp>，微信侧幂等键
  outRefundNo    String    @unique @map("out_refund_no") @db.VarChar(64)
  wxRefundId     String?   @unique @map("wx_refund_id") @db.VarChar(64)
  // 退款金额 / 原订单实付（分）
  amount         Int
  totalAmount    Int       @map("total_amount")
  // PENDING(已发起) / PROCESSING / SUCCESS / ABNORMAL / CLOSED / FAILED(发起即失败)
  status         String    @db.VarChar(16)
  // MOCK / WECHAT
  mode           String    @db.VarChar(16)
  reason         String?   @db.VarChar(80)
  operator       String?   @db.VarChar(64)
  // 关联售后单（顾客申请售后 → 店员同意退款时写入）
  afterSaleId    Int?      @map("after_sale_id")
  // 并发防线：在途态（PENDING/PROCESSING/ABNORMAL）= orderId，终态 SUCCESS/FAILED/CLOSED 置 NULL
  // MySQL 唯一索引允许多个 NULL → 同一订单同时只能有一条在途退款；成功后可再发起部分退款
  // 超额由 initiateRefund 校验 amount <= actualAmount - refundedAmount
  activeOrderId  Int?      @unique @map("active_order_id")
  channel        String?   @db.VarChar(32)
  errorCode      String?   @map("error_code") @db.VarChar(64)
  errorMessage   String?   @map("error_message") @db.VarChar(255)
  wxResponseData String?   @map("wx_response_data") @db.Text
  wxNotifyData   String?   @map("wx_notify_data") @db.Text
  successTime    DateTime? @map("success_time")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// ─────────────────────────────────────────────────────────
// 售后单（顾客收货后申请，店员审核后走部分/全额退款）
// ─────────────────────────────────────────────────────────
model AfterSale {
  id          Int       @id @default(autoincrement())
  orderId     Int       @map("order_id")
  orderNo     String    @map("order_no") @db.VarChar(32)
  userId      Int       @map("user_id")
  // SHORTAGE 少发/漏发  WRONG 错发  DAMAGED 变质/破损  OTHER 其他
  reason      String    @db.VarChar(32)
  description String?   @db.Text
  // 图片 URL 数组（最多 3 张）
  images      Json
  // PENDING 待处理 / APPROVED 已同意（退款发起中） / DONE 退款到账 / REJECTED 已拒绝
  status      String    @default("PENDING") @db.VarChar(16)
  // 店员回复（顾客可见）
  reply       String?   @db.VarChar(255)
  refundId    Int?      @map("refund_id")
  handledBy   String?   @map("handled_by") @db.VarChar(64)
  handledAt   DateTime? @map("handled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("after_sales")
}

// ─────────────────────────────────────────────────────────
// 发货/物流信息
// ─────────────────────────────────────────────────────────
model Shipment {
  id             Int       @id @default(autoincrement())
  orderId        Int       @unique @map("order_id")
  orderNo        String    @map("order_no") @db.VarChar(32)
  expressCompany String?   @map("express_company") @db.VarChar(64)
  expressNo      String?   @map("express_no") @db.VarChar(64)
  shippedAt      DateTime? @map("shipped_at")
  deliveryType   String    @map("delivery_type") @db.VarChar(16)
  remark         String?   @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("shipments")
}

// ─────────────────────────────────────────────────────────
// 二维码扫码日志
// ─────────────────────────────────────────────────────────
model ScanLog {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  userId    Int?     @map("user_id")
  openid    String?  @db.VarChar(64)
  scene     String   @db.VarChar(64)
  source    String   @default("package") @db.VarChar(32)
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([openid])
  @@index([createdAt])
  @@map("scan_logs")
}

// 首页轮播 Banner
model Banner {
  id        Int      @id @default(autoincrement())
  title     String?  @db.VarChar(64)
  imageUrl  String   @map("image_url") @db.VarChar(500)
  // none | product（跳商品详情）
  linkType  String   @default("none") @map("link_type") @db.VarChar(16)
  productId Int?     @map("product_id")
  sortOrder Int      @default(0) @map("sort_order")
  // 1 上架 0 下架
  status    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("banners")
}

// 店铺设置（键值对，值统一存 JSON 字符串）
//
// 用键值对而不是给每项配置开一列：配置项会随经营需要不断增加
// （运费、公告、营业时间开关…），每次加列都要迁移一次表，不划算。
model Setting {
  key       String   @id @map("setting_key") @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ─────────────────────────────────────────────────────────
// 同城配送单（M2 使用）。同一订单可有多张（重呼/换运力），同一时刻只一张有效：
// activeOrderId 有效时 = orderId，终态置 NULL，与 Refund.activeOrderId 同款并发防线。
// ─────────────────────────────────────────────────────────
model Delivery {
  id                Int       @id @default(autoincrement())
  orderId           Int       @map("order_id")
  orderNo           String    @map("order_no") @db.VarChar(32)
  // 商户单号 D<orderId>-<seq>，传给运力方，回调回退查找键
  deliveryNo        String    @unique @map("delivery_no") @db.VarChar(32)
  // 普通 Int 列（非关系字段）：有效单 = orderId，终态 NULL
  activeOrderId     Int?      @unique @map("active_order_id")
  // KD100 | SELF | MOCK
  provider          String    @db.VarChar(16)
  // PENDING CALLING ACCEPTED ARRIVING ARRIVED DELIVERING REASSIGNING ABNORMAL DELIVERED CANCELLED FAILED UNKNOWN
  status            String    @db.VarChar(16)
  statusRank        Int       @default(0) @map("status_rank")
  providerStatus    Int?      @map("provider_status")
  statusDesc        String?   @map("status_desc") @db.VarChar(255)
  providerTaskId    String?   @unique @map("provider_task_id") @db.VarChar(64)
  providerOrderId   String?   @map("provider_order_id") @db.VarChar(64)
  courierCompany    String?   @map("courier_company") @db.VarChar(32)
  courierName       String?   @map("courier_name") @db.VarChar(64)
  courierMobile     String?   @map("courier_mobile") @db.VarChar(20)
  callbackSalt      String    @map("callback_salt") @db.VarChar(20)
  quotedFee         Int?      @map("quoted_fee")
  actualFee         Int?      @map("actual_fee")
  tipFee            Int       @default(0) @map("tip_fee")
  cancelFee         Int       @default(0) @map("cancel_fee")
  providerDistanceM Int?      @map("provider_distance_m")
  errorCode         String?   @map("error_code") @db.VarChar(16)
  failReason        String?   @map("fail_reason") @db.VarChar(255)
  calledAt          DateTime? @map("called_at")
  acceptedAt        DateTime? @map("accepted_at")
  pickedUpAt        DateTime? @map("picked_up_at")
  deliveredAt       DateTime? @map("delivered_at")
  cancelledAt       DateTime? @map("cancelled_at")
  cancelReason      String?   @map("cancel_reason") @db.VarChar(255)
  lastCallbackAt    DateTime? @map("last_callback_at")
  callTimeoutRemindedAt   DateTime? @map("call_timeout_reminded_at")
  acceptedStuckRemindedAt DateTime? @map("accepted_stuck_reminded_at")
  deliveringRemindedAt    DateTime? @map("delivering_reminded_at")
  operator          String?   @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order  Order           @relation(fields: [orderId], references: [id])
  events DeliveryEvent[]

  @@index([orderId])
  @@index([status, calledAt])
  @@map("deliveries")
}

// 配送单事件流水：回调幂等去重 + 时间线 + 对账
model DeliveryEvent {
  id                 Int      @id @default(autoincrement())
  deliveryId         Int      @map("delivery_id")
  // sha1(deliveryId|providerStatus|updateTime ?? sha1(rawBody))；ADMIN/SCHEDULER 事件用 uuid
  dedupeKey          String   @unique @map("dedupe_key") @db.VarChar(64)
  // CALLBACK | API | ADMIN | SCHEDULER
  source             String   @db.VarChar(16)
  providerStatus     Int?     @map("provider_status")
  statusDesc         String?  @map("status_desc") @db.VarChar(255)
  courierName        String?  @map("courier_name") @db.VarChar(64)
  courierMobile      String?  @map("courier_mobile") @db.VarChar(20)
  providerUpdateTime String?  @map("provider_update_time") @db.VarChar(32)
  operator           String?  @db.VarChar(64)
  latencyMs          Int?     @map("latency_ms")
  rawPayload         Json?    @map("raw_payload")
  createdAt          DateTime @default(now()) @map("created_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId, createdAt])
  @@map("delivery_events")
}

// 云打印作业（M2b 使用）
model PrintJob {
  id            Int       @id @default(autoincrement())
  orderId       Int       @map("order_id")
  orderNo       String    @map("order_no") @db.VarChar(32)
  // NEW_ORDER | REPEAT | CANCEL | REPRINT | TEST
  kind          String    @db.VarChar(16)
  // FEIE | MOCK
  provider      String    @db.VarChar(16)
  printerSn     String    @map("printer_sn") @db.VarChar(32)
  // PENDING | SENT | PRINTED | FAILED | SKIPPED
  status        String    @db.VarChar(16)
  providerJobId String?   @map("provider_job_id") @db.VarChar(64)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.VarChar(255)
  content       String    @db.Text
  dedupeKey     String    @unique @map("dedupe_key") @db.VarChar(64)
  sentAt        DateTime? @map("sent_at")
  printedAt     DateTime? @map("printed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([orderId])
  @@map("print_jobs")
}
