generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// 用户
// ─────────────────────────────────────────────────────────
model User {
  id            Int       @id @default(autoincrement())
  openid        String    @unique @db.VarChar(64)
  unionid       String?   @db.VarChar(64)
  nickname      String?   @db.VarChar(64)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  phone         String?   @db.VarChar(20)
  status        Int       @default(1) @db.TinyInt
  lastLoginAt   DateTime? @map("last_login_at")
  // 冗余缓存 == Σ 入账行（EARN/GIFT_REVERT）remaining（**不带**到期过滤；到期行由
  // expirePoints 清零 remaining 时同事务等量 decrement 本列，恒等式不含 expiresAt 条件）。
  // 权威来源仍是 PointsLedger，见 scripts/check-points-consistency.mjs 的只读校验
  pointsBalance Int       @default(0) @map("points_balance")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  carts         Cart[]
  addresses     Address[]
  orders        Order[]
  scanLogs      ScanLog[]
  pointsLedgers PointsLedger[]
  userCoupons   UserCoupon[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────
// 后台管理员
// ─────────────────────────────────────────────────────────
model Admin {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(64)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String?   @db.VarChar(64)
  role         String    @default("admin") @db.VarChar(32)
  status       Int       @default(1) @db.TinyInt
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

// ─────────────────────────────────────────────────────────
// 商品分类
// ─────────────────────────────────────────────────────────
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(64)
  iconUrl   String?  @map("icon_url") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  status    Int      @default(1) @db.TinyInt
  // 渠道：EXPRESS=全国邮寄 LOCAL=同城配送。一个分类只属于一个渠道，商品随分类归属
  channel   String   @default("EXPRESS") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([status, sortOrder])
  @@index([channel, status, sortOrder])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────
// 商品
// ─────────────────────────────────────────────────────────
model Product {
  id             Int       @id @default(autoincrement())
  categoryId     Int       @map("category_id")
  name           String    @db.VarChar(128)
  subtitle       String?   @db.VarChar(255)
  coverImage     String?   @map("cover_image") @db.VarChar(500)
  price          Int
  originalPrice  Int?      @map("original_price")
  stock          Int       @default(0)
  salesCount     Int       @default(0) @map("sales_count")
  unit           String    @default("份") @db.VarChar(16)
  weight         String?   @db.VarChar(32)
  shelfLife      String?   @map("shelf_life") @db.VarChar(64)
  storageMethod  String?   @map("storage_method") @db.VarChar(128)
  deliveryInfo   String?   @map("delivery_info") @db.Text
  description    String?   @db.Text
  // ON_SHELF=上架  OFF_SHELF=下架  DELETED=已删除
  status         String    @default("ON_SHELF") @db.VarChar(16)
  // @deprecated 历史列，渠道以 channel 为准；后台不再写入
  deliveryType   String    @default("EXPRESS") @map("delivery_type") @db.VarChar(64)
  // 渠道冗余自分类（只在 services/product-channel.ts 写入），列表按渠道过滤不必 join
  channel        String    @default("EXPRESS") @db.VarChar(16)
  // 净重（克），同城下单换算快递100 weight(kg)；空则用同城设置的默认值
  netWeightG     Int?      @map("net_weight_g")
  isRecommended  Int       @default(0) @map("is_recommended") @db.TinyInt
  qrScene        String?   @map("qr_scene") @db.VarChar(64)
  qrCodeUrl      String?   @map("qr_code_url") @db.VarChar(500)
  qrGeneratedAt  DateTime? @map("qr_generated_at")
  // 规格维度定义 [{name:"辣度",values:["微辣","中辣"]},...]；null=无规格商品
  specDimensions Json?     @map("spec_dimensions")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  skus       ProductSku[]
  carts      Cart[]
  orderItems OrderItem[]
  scanLogs   ScanLog[]

  @@index([categoryId, status])
  @@index([status, isRecommended])
  @@index([channel, status])
  @@map("products")
}

// ─────────────────────────────────────────────────────────
// 商品规格 SKU（有 SKU 的商品：product.price=min(sku.price)、product.stock=sum(sku.stock) 由服务端写入时同步）
// ─────────────────────────────────────────────────────────
model ProductSku {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  // 展示与匹配键，如 "中辣/去骨/250g"（各维度值按 specDimensions 顺序以 / 连接）
  specText      String   @map("spec_text") @db.VarChar(128)
  // ["中辣","去骨","250g"] 与 specDimensions 顺序一一对应
  specValues    Json     @map("spec_values")
  price         Int
  originalPrice Int?     @map("original_price")
  stock         Int      @default(0)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  carts   Cart[]

  @@unique([productId, specText])
  @@map("product_skus")
}

// ─────────────────────────────────────────────────────────
// 商品图片
// ─────────────────────────────────────────────────────────
model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  imageUrl  String   @map("image_url") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ─────────────────────────────────────────────────────────
// 购物车
// ─────────────────────────────────────────────────────────
model Cart {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  productId  Int      @map("product_id")
  skuId      Int?     @map("sku_id")
  quantity   Int      @default(1)
  isSelected Int      @default(1) @map("is_selected") @db.TinyInt
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id])
  product Product     @relation(fields: [productId], references: [id])
  sku     ProductSku? @relation(fields: [skuId], references: [id], onDelete: Cascade)

  // 同一 user+product+sku 一行；skuId 为 NULL 时 MySQL 唯一索引不生效，由代码 findFirst 保证
  @@unique([userId, productId, skuId])
  @@map("carts")
}

// ─────────────────────────────────────────────────────────
// 收货地址
// ─────────────────────────────────────────────────────────
model Address {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  receiverName  String    @map("receiver_name") @db.VarChar(64)
  receiverPhone String    @map("receiver_phone") @db.VarChar(20)
  province      String    @db.VarChar(32)
  city          String    @db.VarChar(32)
  district      String    @db.VarChar(32)
  detail        String    @db.VarChar(255)
  fullAddress   String    @map("full_address") @db.VarChar(500)
  // GCJ-02 微度坐标 + 地图选点 POI 名；EXPRESS 地址可为空，LOCAL 下单必填
  latE6         Int?      @map("lat_e6")
  lngE6         Int?      @map("lng_e6")
  poiName       String?   @map("poi_name") @db.VarChar(128)
  isDefault     Int       @default(0) @map("is_default") @db.TinyInt
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────
// 订单
// ─────────────────────────────────────────────────────────
model Order {
  id                          Int       @id @default(autoincrement())
  orderNo                     String    @unique @map("order_no") @db.VarChar(32)
  userId                      Int       @map("user_id")
  // PENDING_PAYMENT / PAID(待接单) / PREPARING(备餐中) / SHIPPED / COMPLETED / CANCELLED / REFUNDING / REFUNDED
  status                      String    @db.VarChar(32)
  totalAmount                 Int       @map("total_amount")
  shippingFee                 Int       @default(0) @map("shipping_fee")
  actualAmount                Int       @map("actual_amount")
  deliveryType                String    @map("delivery_type") @db.VarChar(16)
  remark                      String?   @db.VarChar(255)
  // 收货地址快照
  receiverName                String    @map("receiver_name") @db.VarChar(64)
  receiverPhone               String    @map("receiver_phone") @db.VarChar(20)
  receiverProvince            String    @map("receiver_province") @db.VarChar(32)
  receiverCity                String    @map("receiver_city") @db.VarChar(32)
  receiverDistrict            String    @map("receiver_district") @db.VarChar(32)
  receiverDetail              String    @map("receiver_detail") @db.VarChar(255)
  receiverFullAddress         String    @map("receiver_full_address") @db.VarChar(500)
  paidAt                      DateTime? @map("paid_at")
  // 商家接单时间（PAID → PREPARING）
  acceptedAt                  DateTime? @map("accepted_at")
  // 完成时间（确认收货）
  completedAt                 DateTime? @map("completed_at")
  // 退款完成时间（REFUNDING → REFUNDED，仅全额退完时写）
  refundedAt                  DateTime? @map("refunded_at")
  // 已成功退款累计金额（分），部分退款多次累加；== actualAmount 即全额退完
  refundedAmount              Int       @default(0) @map("refunded_amount")
  // 付款后超时未接单的催单已推送时间（定时任务只催一次）
  acceptRemindedAt            DateTime? @map("accept_reminded_at")
  cancelledAt                 DateTime? @map("cancelled_at")
  cancelReason                String?   @map("cancel_reason") @db.VarChar(255)
  // ── 同城配送快照（deliveryType=LOCAL 时写入）──
  receiverLatE6               Int?      @map("receiver_lat_e6")
  receiverLngE6               Int?      @map("receiver_lng_e6")
  receiverPoiName             String?   @map("receiver_poi_name") @db.VarChar(128)
  // 计费距离（米）：运力方 batchPrice 返回的真实道路距离，查价失败时退回直线 × detourFactor 估算
  distanceM                   Int?      @map("distance_m")
  // 上面这段距离是实测（MEASURED）还是估算（ESTIMATED）——随行审计信息，不参与任何计费/作废判断，
  // 见 services/local-settings.ts 的 QuotePayload.distanceSource 注释。查价失败按估算价成交的单，
  // 事后靠这一列直接查得出来，不用去关联别的表推断。
  distanceSource              String?   @map("distance_source") @db.VarChar(16)
  estimatedDeliveryAt         DateTime? @map("estimated_delivery_at")
  // 顾客在接单后宽限期内申请取消（D6 ②）；快照当时有效配送单状态，NONE=无单
  cancelRequestedAt           DateTime? @map("cancel_requested_at")
  cancelRequestNote           String?   @map("cancel_request_note") @db.VarChar(255)
  cancelRequestDeliveryStatus String?   @map("cancel_request_delivery_status") @db.VarChar(16)
  // 未接单重复播报（M2b）
  announceCount               Int       @default(0) @map("announce_count")
  lastAnnouncedAt             DateTime? @map("last_announced_at")
  // M2 定时任务「每单只提醒一次」标记（备餐超时未呼叫 / 顾客取消申请未处理）
  localUncalledRemindedAt     DateTime? @map("local_uncalled_reminded_at")
  cancelRequestRemindedAt     DateTime? @map("cancel_request_reminded_at")
  // 取消申请被驳回的时刻（人工驳回或超时自动驳回都写）。
  // 驳回的动作是把上面几个 cancelRequest* 标记清空——不留这一列的话，驳回之后**没有任何痕迹**，
  // 工作台就无从显示「已驳回 · 继续完成此订单」，顾客端也无从显示「商家未同意取消」。
  cancelRequestRejectedAt     DateTime? @map("cancel_request_rejected_at")
  // 驳回是谁做的：MANUAL（店员点的）| AUTO（接单满 5 分钟没人处理，系统自动驳回）。
  // 两者对顾客的说法不同，也决定要不要在卡片上区分显示，所以必须分得开。
  cancelRequestRejectedBy     String?   @map("cancel_request_rejected_by") @db.VarChar(8)
  // 最近一次六家运力报价快照（结构见 services/delivery/quote.ts）。放在 Order 上是因为
  // 接单转备餐的那一刻就要查价，而 Delivery 行要等呼叫时才创建；呼叫时再复制到 Delivery。
  quoteSnapshot               Json?     @map("quote_snapshot")
  quotedAt                    DateTime? @map("quoted_at")
  // 联调/回归留在正式库里的测试单。所有经营统计都排除它（口径见 utils/stats-scope.ts 的
  // REAL_ORDERS），顾客端不下发（routes/orders.ts 的 withPayExpire 会剥掉）。
  // 注意它挡不住热销榜：那读的是 Product.salesCount 冗余列，隔离办法见 docs/ops-test-orders.md。
  isTest                      Boolean   @default(false) @map("is_test")
  // ── 会员积分/优惠券（M1 账本层，见 docs/superpowers/plans/2026-09-04-member-m1-ledger.md）──
  // 普通 Int 列，不建关系字段（与 Refund/Delivery.activeOrderId 同款处理）
  couponId                    Int?      @map("coupon_id")
  discountAmount              Int       @default(0) @map("discount_amount")
  // 赠品消耗的积分（M2 结算链路写入，M1 恒为 0）
  pointsUsed                  Int       @default(0) @map("points_used")
  // 本单实际发放的积分，可能为 0（小额单/已全额退款）
  pointsEarned                Int       @default(0) @map("points_earned")
  // 积分结算的唯一「已处理」标记：非空 = settlePoints 已处理过（无论是否发出流水），
  // 不得用 pointsEarned === 0 判断（spec §5.4）——否则 earn=0 的订单会被兜底任务永远重扫
  pointsSettledAt             DateTime? @map("points_settled_at")
  // 结算时用于算分的基数 = actualAmount − refundedAmount(结算时刻)；退款扣回按
  // pointsEarned × 退款额 / pointsBase 摊，与 earnRatePerYuan 无关。
  // null = 该单在本列上线前结算（退化用 actualAmount）
  pointsBase                  Int?      @map("points_base")
  // 客户端下单幂等键（UUID）。治的是「服务端已创建、客户端超时没收到响应」这一类重复下单：
  // 顾客点一次、网络卡住、他再点一次，库里就是两张单、库存扣两次、券核销两次。
  // 客户端每进一次结算页生成一个，重试沿用同一个；服务端见到重复的就把原单原样返回。
  //
  // 可空且**必须可空**：邮寄结算页与 e2e 里几十处下单都不传这个字段，
  // 不传时整条链路的行为与本列上线前逐字节一致。MySQL 唯一索引把多个 NULL 视为互不相同，
  // 所以 (user_id, NULL) 可以有任意多行。
  // 带上 userId 是安全边界而不只是去重粒度：只用 clientRequestId 做唯一键的话，
  // A 用户猜到 B 的 id 就能拿到 B 的订单号与金额。
  clientRequestId             String?   @map("client_request_id") @db.VarChar(36)
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
  payment    Payment?
  shipment   Shipment?
  refunds    Refund[]
  afterSales AfterSale[]
  deliveries Delivery[]

  @@unique([userId, clientRequestId])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([status, pointsSettledAt, completedAt])
  @@map("orders")
}

// ─────────────────────────────────────────────────────────
// 订单商品（含商品快照）
// ─────────────────────────────────────────────────────────
model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  productId    Int?     @map("product_id")
  // SKU 快照（无外键，商品规格变更/删除不影响历史订单）
  skuId        Int?     @map("sku_id")
  specText     String?  @map("spec_text") @db.VarChar(128)
  productName  String   @map("product_name") @db.VarChar(128)
  productImage String?  @map("product_image") @db.VarChar(500)
  productPrice Int      @map("product_price")
  quantity     Int
  subtotal     Int
  // 赠品行：productPrice/subtotal = 0，不进小计与门槛判定（M2 结算链路写入，M1 不产生赠品行）
  isGift       Boolean  @default(false) @map("is_gift")
  pointsCost   Int      @default(0) @map("points_cost")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────
// 支付记录
// ─────────────────────────────────────────────────────────
model Payment {
  id              Int       @id @default(autoincrement())
  orderId         Int       @unique @map("order_id")
  orderNo         String    @map("order_no") @db.VarChar(32)
  // MOCK / WECHAT
  paymentType     String    @map("payment_type") @db.VarChar(16)
  // 微信 out_trade_no（格式 order_<orderId>_<timestamp>），用于对账和退款
  outTradeNo      String?   @map("out_trade_no") @db.VarChar(64)
  amount          Int
  // PENDING / SUCCESS / FAILED / REFUNDED
  status          String    @db.VarChar(16)
  wxPrepayId      String?   @map("wx_prepay_id") @db.VarChar(64)
  wxTransactionId String?   @unique @map("wx_transaction_id") @db.VarChar(64)
  wxNotifyData    String?   @map("wx_notify_data") @db.Text
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderNo])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────
// 退款记录（微信退款 API，支持全额与部分退款；每笔发起一条）
// ─────────────────────────────────────────────────────────
model Refund {
  id             Int       @id @default(autoincrement())
  orderId        Int       @map("order_id")
  orderNo        String    @map("order_no") @db.VarChar(32)
  outTradeNo     String?   @map("out_trade_no") @db.VarChar(64)
  // 商户退款单号 refund_<orderId>_<timestamp>，微信侧幂等键
  outRefundNo    String    @unique @map("out_refund_no") @db.VarChar(64)
  wxRefundId     String?   @unique @map("wx_refund_id") @db.VarChar(64)
  // 退款金额 / 原订单实付（分）
  amount         Int
  totalAmount    Int       @map("total_amount")
  // PENDING(已发起) / PROCESSING / SUCCESS / ABNORMAL / CLOSED / FAILED(发起即失败)
  status         String    @db.VarChar(16)
  // MOCK / WECHAT
  mode           String    @db.VarChar(16)
  reason         String?   @db.VarChar(80)
  operator       String?   @db.VarChar(64)
  // 关联售后单（顾客申请售后 → 店员同意退款时写入）
  afterSaleId    Int?      @map("after_sale_id")
  // 并发防线：在途态（PENDING/PROCESSING/ABNORMAL）= orderId，终态 SUCCESS/FAILED/CLOSED 置 NULL
  // MySQL 唯一索引允许多个 NULL → 同一订单同时只能有一条在途退款；成功后可再发起部分退款
  // 超额由 initiateRefund 校验 amount <= actualAmount - refundedAmount
  activeOrderId  Int?      @unique @map("active_order_id")
  channel        String?   @db.VarChar(32)
  errorCode      String?   @map("error_code") @db.VarChar(64)
  errorMessage   String?   @map("error_message") @db.VarChar(255)
  wxResponseData String?   @map("wx_response_data") @db.Text
  wxNotifyData   String?   @map("wx_notify_data") @db.Text
  successTime    DateTime? @map("success_time")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// ─────────────────────────────────────────────────────────
// 售后单（顾客收货后申请，店员审核后走部分/全额退款）
// ─────────────────────────────────────────────────────────
model AfterSale {
  id          Int       @id @default(autoincrement())
  orderId     Int       @map("order_id")
  orderNo     String    @map("order_no") @db.VarChar(32)
  userId      Int       @map("user_id")
  // SHORTAGE 少发/漏发  WRONG 错发  DAMAGED 变质/破损  OTHER 其他
  reason      String    @db.VarChar(32)
  description String?   @db.Text
  // 图片 URL 数组（最多 3 张）
  images      Json
  // PENDING 待处理 / APPROVED 已同意（退款发起中） / DONE 退款到账 / REJECTED 已拒绝
  status      String    @default("PENDING") @db.VarChar(16)
  // 店员回复（顾客可见）
  reply       String?   @db.VarChar(255)
  refundId    Int?      @map("refund_id")
  handledBy   String?   @map("handled_by") @db.VarChar(64)
  handledAt   DateTime? @map("handled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("after_sales")
}

// ─────────────────────────────────────────────────────────
// 发货/物流信息
// ─────────────────────────────────────────────────────────
model Shipment {
  id             Int       @id @default(autoincrement())
  orderId        Int       @unique @map("order_id")
  orderNo        String    @map("order_no") @db.VarChar(32)
  expressCompany String?   @map("express_company") @db.VarChar(64)
  expressNo      String?   @map("express_no") @db.VarChar(64)
  shippedAt      DateTime? @map("shipped_at")
  deliveryType   String    @map("delivery_type") @db.VarChar(16)
  remark         String?   @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("shipments")
}

// ─────────────────────────────────────────────────────────
// 二维码扫码日志
// ─────────────────────────────────────────────────────────
model ScanLog {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  // 「独立访客」按这一列去重（匿名扫码为 NULL，只计次数不计人）。
  // 不要再加 openid 列：User.openid 是 @unique 非空，由 userId 唯一确定，存副本只会失步。
  userId    Int?     @map("user_id")
  scene     String   @db.VarChar(64)
  source    String   @default("package") @db.VarChar(32)
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@map("scan_logs")
}

// 首页轮播 Banner
model Banner {
  id        Int      @id @default(autoincrement())
  title     String?  @db.VarChar(64)
  imageUrl  String   @map("image_url") @db.VarChar(500)
  // none | product（跳商品详情）
  linkType  String   @default("none") @map("link_type") @db.VarChar(16)
  productId Int?     @map("product_id")
  sortOrder Int      @default(0) @map("sort_order")
  // 1 上架 0 下架
  status    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("banners")
}

// 店铺设置（键值对，值统一存 JSON 字符串）
//
// 用键值对而不是给每项配置开一列：配置项会随经营需要不断增加
// （运费、公告、营业时间开关…），每次加列都要迁移一次表，不划算。
model Setting {
  key       String   @id @map("setting_key") @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ─────────────────────────────────────────────────────────
// 同城配送单（M2 使用）。同一订单可有多张（重呼/换运力），同一时刻只一张有效：
// activeOrderId 有效时 = orderId，终态置 NULL，与 Refund.activeOrderId 同款并发防线。
// ─────────────────────────────────────────────────────────
model Delivery {
  id                      Int       @id @default(autoincrement())
  orderId                 Int       @map("order_id")
  orderNo                 String    @map("order_no") @db.VarChar(32)
  // 商户单号 D<orderId>-<seq>，传给运力方，回调回退查找键
  deliveryNo              String    @unique @map("delivery_no") @db.VarChar(32)
  // 普通 Int 列（非关系字段）：有效单 = orderId，终态 NULL
  activeOrderId           Int?      @unique @map("active_order_id")
  // KD100 | SELF | MOCK
  provider                String    @db.VarChar(16)
  // PENDING CALLING ACCEPTED ARRIVING ARRIVED DELIVERING REASSIGNING ABNORMAL DELIVERED CANCELLED FAILED UNKNOWN
  status                  String    @db.VarChar(16)
  statusRank              Int       @default(0) @map("status_rank")
  providerStatus          Int?      @map("provider_status")
  statusDesc              String?   @map("status_desc") @db.VarChar(255)
  providerTaskId          String?   @unique @map("provider_task_id") @db.VarChar(64)
  providerOrderId         String?   @map("provider_order_id") @db.VarChar(64)
  courierCompany          String?   @map("courier_company") @db.VarChar(32)
  courierName             String?   @map("courier_name") @db.VarChar(64)
  courierMobile           String?   @map("courier_mobile") @db.VarChar(20)
  callbackSalt            String    @map("callback_salt") @db.VarChar(20)
  quotedFee               Int?      @map("quoted_fee")
  actualFee               Int?      @map("actual_fee")
  // 呼叫当次的六家报价快照（从 Order 复制，结构见 services/delivery/quote.ts）+ 查询时间。
  // 对账依据：中标运力（courierCompany）在快照里的报价 vs 实扣（quotedFee/actualFee）。
  quoteSnapshot           Json?     @map("quote_snapshot")
  quotedAt                DateTime? @map("quoted_at")
  // 本单实际呼了哪些运力（kuaidicom 编码字符串数组）。规格 §10：将来做「指定单家运力」时，
  // 费用差异来自哪几家必须看得出来，所以记具名列表而不是一个 oneToOne 布尔值。
  calledProviders         Json?     @map("called_providers")
  // 本次呼叫用的策略：SOLO（引擎选的单家）| ALL（并呼）| MANUAL（店员指定）|
  // SOLO_HELD（该升级但预估取消费 >0，放弃自动升级）。NULL = 策略上线前的历史行。
  callStrategy            String?   @map("call_strategy") @db.VarChar(16)
  // batchOrder 响应 fee[] 原样：[{provider, feeFen, distanceM}]，与 quoteSnapshot.quotes 同结构。
  // 这是**下单那一刻各家真预扣**的金额（快递100 后台那几行扣费明细就是它），比呼叫前的
  // 免费查价快照更权威——actualFee 认领中标运力报价时优先查它。
  orderFees               Json?     @map("order_fees")
  tipFee                  Int       @default(0) @map("tip_fee")
  cancelFee               Int       @default(0) @map("cancel_fee")
  providerDistanceM       Int?      @map("provider_distance_m")
  errorCode               String?   @map("error_code") @db.VarChar(16)
  failReason              String?   @map("fail_reason") @db.VarChar(255)
  calledAt                DateTime? @map("called_at")
  acceptedAt              DateTime? @map("accepted_at")
  pickedUpAt              DateTime? @map("picked_up_at")
  deliveredAt             DateTime? @map("delivered_at")
  cancelledAt             DateTime? @map("cancelled_at")
  cancelReason            String?   @map("cancel_reason") @db.VarChar(255)
  lastCallbackAt          DateTime? @map("last_callback_at")
  callTimeoutRemindedAt   DateTime? @map("call_timeout_reminded_at")
  acceptedStuckRemindedAt DateTime? @map("accepted_stuck_reminded_at")
  deliveringRemindedAt    DateTime? @map("delivering_reminded_at")
  unknownRemindedAt       DateTime? @map("unknown_reminded_at")
  operator                String?   @db.VarChar(64)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  order  Order           @relation(fields: [orderId], references: [id])
  events DeliveryEvent[]

  @@index([orderId])
  @@index([status, calledAt])
  @@map("deliveries")
}

// 配送单事件流水：回调幂等去重 + 时间线 + 对账
model DeliveryEvent {
  id                 Int      @id @default(autoincrement())
  deliveryId         Int      @map("delivery_id")
  // `CB:${deliveryNo}:${providerStatus}:${updateTime ?? md5(rawBody)}`（截 64 位）；ADMIN/SCHEDULER 事件用 uuid（见 services/delivery/events.ts）
  dedupeKey          String   @unique @map("dedupe_key") @db.VarChar(64)
  // CALLBACK | API | ADMIN | SCHEDULER
  source             String   @db.VarChar(16)
  providerStatus     Int?     @map("provider_status")
  statusDesc         String?  @map("status_desc") @db.VarChar(255)
  courierName        String?  @map("courier_name") @db.VarChar(64)
  courierMobile      String?  @map("courier_mobile") @db.VarChar(20)
  providerUpdateTime String?  @map("provider_update_time") @db.VarChar(32)
  operator           String?  @db.VarChar(64)
  latencyMs          Int?     @map("latency_ms")
  rawPayload         Json?    @map("raw_payload")
  createdAt          DateTime @default(now()) @map("created_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId, createdAt])
  @@map("delivery_events")
}

// 云打印作业（M2b 使用）
model PrintJob {
  id            Int       @id @default(autoincrement())
  orderId       Int       @map("order_id")
  orderNo       String    @map("order_no") @db.VarChar(32)
  // NEW_ORDER | REPEAT | CANCEL | REPRINT | TEST | CANCEL_REQUEST | RESUME
  kind          String    @db.VarChar(16)
  // FEIE | MOCK
  provider      String    @db.VarChar(16)
  printerSn     String    @map("printer_sn") @db.VarChar(32)
  // PENDING | SENDING | SENT | PRINTED | FAILED | SKIPPED
  status        String    @db.VarChar(16)
  providerJobId String?   @map("provider_job_id") @db.VarChar(64)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.VarChar(255)
  content       String    @db.Text
  dedupeKey     String    @unique @map("dedupe_key") @db.VarChar(64)
  // 入队时从 PrinterEntry.copies 快照，重试/补打/手动重试一律读本列
  copies        Int       @default(1)
  sentAt        DateTime? @map("sent_at")
  printedAt     DateTime? @map("printed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([orderId])
  @@map("print_jobs")
}

// ─────────────────────────────────────────────────────────
// 会员积分 + 优惠券（M1 账本层，M2 起接入下单计价）。
// 设计依据 docs/superpowers/specs/2026-09-04-member-points-coupon-design.md §4。
// ─────────────────────────────────────────────────────────

// 积分流水。User.pointsBalance 是冗余缓存，真正的余额永远可由本表 remaining 重算，
// 出账必留痕（不允许直接改余额不记流水）。
model PointsLedger {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  // EARN 消费得分 | REDEEM 兑换券 | GIFT 随单赠品 | GIFT_REVERT 未支付取消退回
  // | REFUND_DEDUCT 退款扣回 | EXPIRE 过期 | ADMIN 手动调整（预留，本轮无入口）
  type         String    @db.VarChar(16)
  delta        Int // 正=入账 负=出账
  balanceAfter Int       @map("balance_after")
  remaining    Int       @default(0) // 仅入账行有意义：该笔尚未被消耗/过期的余量
  refType      String    @map("ref_type") @db.VarChar(16) // ORDER | COUPON | REFUND | LEDGER
  refId        String    @map("ref_id") @db.VarChar(32)
  remark       String?   @db.VarChar(255)
  // EARN/GIFT_REVERT = 到期日；GIFT = 被扣行里最早的到期日，供 GIFT_REVERT 释放时继承
  // （2026-09-05 回填：见 services/member/points.ts 的 consumePoints 与 M1 计划 Task 3 Step 2）
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([type, refType, refId]) // 幂等防线：同一来源只能记一次账
  @@index([userId, createdAt])
  @@index([userId, type, expiresAt]) // FIFO 扣减与过期扫描
  @@map("points_ledgers")
}

// 券模板：店员定义的券种
model CouponTemplate {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(64)
  description  String?  @db.VarChar(255)
  amount       Int // 减免金额（分）
  threshold    Int      @default(0) // 满多少可用（分），0 = 代金券
  channel      String   @default("ALL") @db.VarChar(16) // ALL | LOCAL | EXPRESS
  validDays    Int      @map("valid_days") // 领取后 N 天有效
  source       String   @db.VarChar(16) // ADMIN | POINTS | CAMPAIGN | NEWCOMER
  pointsCost   Int?     @map("points_cost") // source=POINTS 必填
  totalLimit   Int?     @map("total_limit") // source=CAMPAIGN 可选总量
  perUserLimit Int?     @map("per_user_limit")
  issuedCount  Int      @default(0) @map("issued_count")
  status       String   @default("ON") @db.VarChar(16) // ON | OFF
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  coupons UserCoupon[]

  @@index([source, status, sortOrder])
  @@map("coupon_templates")
}

// 发到某个人手里的一张券。面额等字段快照自模板，模板停用/改价不影响已发券
model UserCoupon {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  templateId Int       @map("template_id")
  code       String    @unique @db.VarChar(32) // 展示与客服核对用
  name       String    @db.VarChar(64) // ↓ 四个快照字段，模板改价/停用不影响已发券
  amount     Int
  threshold  Int       @default(0)
  channel    String    @default("ALL") @db.VarChar(16)
  status     String    @default("UNUSED") @db.VarChar(16) // UNUSED | USED | EXPIRED
  source     String    @db.VarChar(16) // 同模板 source
  sourceRef  String?   @map("source_ref") @db.VarChar(64) // 赔偿时 = 关联订单号
  issuedBy   String?   @map("issued_by") @db.VarChar(64) // 赔偿时 = 操作管理员
  remark     String?   @db.VarChar(255) // 赔偿原因
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  // 普通 Int 列，不建关系字段（与 Order.couponId 同款处理，避免双向强关联）
  orderId    Int?      @map("order_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User           @relation(fields: [userId], references: [id])
  template CouponTemplate @relation(fields: [templateId], references: [id])

  @@index([userId, status, expiresAt])
  @@index([orderId])
  @@index([status, expiresAt]) // 过期扫描
  @@map("user_coupons")
}

// 可用积分加购的随单赠品（M2 起接入下单结算，M1 只建表不使用）
model PointsGood {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  skuId         Int?     @map("sku_id")
  pointsCost    Int      @map("points_cost")
  perOrderLimit Int      @default(1) @map("per_order_limit")
  stockLimit    Int?     @map("stock_limit") // 可选总量，NULL = 不限
  issuedCount   Int      @default(0) @map("issued_count")
  status        String   @default("ON") @db.VarChar(16)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // 注意：MySQL 唯一索引不约束 NULL，无 SKU 商品的重复校验需在代码里先 findFirst 再插
  // （与 Cart 表 @@unique([userId, productId, skuId]) 同款处理）
  @@unique([productId, skuId])
  @@index([status, sortOrder])
  @@map("points_goods")
}

/// 当日单号流水。一行/天，`day_key` 是 Asia/Shanghai 的 YYYYMMDD。
/// 只由 services/order-no.ts 用原生 SQL 原子自增，业务代码不要直接读写。
model OrderNoSeq {
  dayKey    String   @id @map("day_key") @db.Char(8)
  seq       Int      @default(0) @db.UnsignedInt
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("order_no_seq")
}
