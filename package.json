{
  "name": "food-shop",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server",
    "build:server": "npm run build --workspace=apps/server",
    "build:admin": "npm run build --workspace=apps/admin",
    "preview:miniapp": "node tools/miniapp-preview/serve.mjs",
    "gen:tabbar": "node scripts/gen-tabbar-icons.mjs",
    "gen:pwa-icons": "node scripts/gen-pwa-icons.mjs",
    "gen:share": "node scripts/gen-share-images.mjs",
    "test:miniapp": "node --test tests/miniapp/*.test.cjs"
  },
  "devDependencies": {
    "sharp": "^0.35.3"
  }
}
