# ============================================================
# 数据库
# ============================================================
DATABASE_URL="mysql://foodshop_user:foodshop_password@localhost:3306/food_shop"

# ============================================================
# JWT（必填：缺失或少于 16 位时服务拒绝启动，无任何默认回退）
# ============================================================
JWT_SECRET="change-me-user-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
ADMIN_JWT_SECRET="change-me-admin-jwt-secret-min-32-chars"
ADMIN_JWT_EXPIRES_IN="30d"

# ============================================================
# 微信小程序
# ============================================================
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# ============================================================
# 微信支付（阶段 7 接入）
# ============================================================
WECHAT_MCH_ID=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_SERIAL_NO=""
WECHAT_PAY_PRIVATE_KEY_PATH=""
# 必须是公网可访问的 HTTPS 地址；本地 localhost 收不到微信回调，请用 ngrok 或部署后测试
WECHAT_PAY_NOTIFY_URL="https://api.yourdomain.com/api/wechat/pay/notify"
# 退款回调地址（可留空：自动由 NOTIFY_URL 把末尾 /notify 换成 /refund-notify）
WECHAT_PAY_REFUND_NOTIFY_URL=""

# ── 回调验签材料：以下两种模式二选一（商户平台 → 账户中心 → API 安全 查看当前模式）──
# 模式 A「微信支付公钥」（2024 年起新申请商户默认）：下载 pub_key.pem 上传到服务器
WECHAT_PAY_PUBLIC_KEY_PATH=""
# 公钥 ID（PUB_KEY_ID_ 开头，可选；配置后回调头 Wechatpay-Serial 必须与之一致）
WECHAT_PAY_PUBLIC_KEY_ID=""
# 模式 B「平台证书」（老商户）：用官方 CertificateDownloader 下载的 wechatpay_xxx.pem
# 序列号不匹配（证书轮换）时服务会自动调 /v3/certificates 拉取，设 false 可关闭
WECHAT_PAY_PLATFORM_CERT_PATH=""
WECHAT_PAY_CERT_AUTO_DOWNLOAD="true"
# 生产环境两者都未配置：支付/退款回调一律拒绝（启动只警告）；非生产留空则跳过验签

# ============================================================
# 腾讯云 COS（商品/Banner 图片存储）
# 生产必填（未配置服务拒绝启动）；开发留空则回退本地 apps/server/uploads/
# 建议用子账号密钥（CAM），仅授权该存储桶的读写
# ============================================================
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET="your-bucket-1250000000"
COS_REGION="ap-guangzhou"
# 对外访问域名（自定义域名 / CDN），留空则用桶默认域名 https://<bucket>.cos.<region>.myqcloud.com
COS_BASE_URL=""

# ============================================================
# 服务器
# ============================================================
PORT=3000
NODE_ENV="development"

# 对外可访问的基础 URL（用于拼接上传图片等静态资源地址）
# 开发环境默认 http://localhost:3000，生产必须配置为 https://api.yourdomain.com
PUBLIC_BASE_URL=""

# CORS 白名单（逗号分隔）。开发环境留空则放开；生产环境留空则拒绝所有浏览器跨域
# 例：https://admin.yourdomain.com
CORS_ORIGINS=""

# ============================================================
# Mock 开关（默认全部关闭，仅显式 =true 时启用；生产环境开启会拒绝启动）
# ============================================================
# 微信登录 Mock（本地开发用，无需真实 AppID/AppSecret）
WECHAT_LOGIN_MOCK=true

# 微信支付 Mock（POST /orders/:id/pay 直接标记 PAID，无需真实微信支付）
# 关闭时需配置 WECHAT_MCH_ID / WECHAT_PAY_* 全部变量
WECHAT_PAY_MOCK=true

# 二维码 Mock（未配置 WECHAT_APP_ID/WECHAT_APP_SECRET 时自动 mock）
WECHAT_QRCODE_MOCK=true

# ─────────────────────────────────────────────
# 新订单微信推送（两条通道均可选，可同时开；全部留空则不推送）
# ─────────────────────────────────────────────
# 通道一：企业微信群机器人（推荐，官方、免费、稳定）
# 获取方法：企业微信 App/PC → 进入店铺内部群（成员须全部为本企业成员）→ 右上角…
# → 添加群机器人 → 复制 Webhook 地址粘贴到下面
ORDER_NOTIFY_WECOM_WEBHOOK=""
# 通道二：PushPlus（pushplus.plus，个人微信扫码即收，免费额度有限，订单数据经第三方）
# 获取方法：pushplus.plus 微信扫码登录 → 复制 token；多人接收再建「群组」填群组编码
ORDER_NOTIFY_PUSHPLUS_TOKEN=""
ORDER_NOTIFY_PUSHPLUS_TOPIC=""

# ─────────────────────────────────────────────
# 系统告警（接口 500 / 进程崩溃 / 支付回调金额不符 / 退款失败）
# 留空则回退到 ORDER_NOTIFY_WECOM_WEBHOOK；建议单独建一个「告警群」机器人
# ─────────────────────────────────────────────
SYSTEM_ALERT_WECOM_WEBHOOK=""
