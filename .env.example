# ============================================================
# 数据库
# ============================================================
DATABASE_URL="mysql://foodshop_user:foodshop_password@localhost:3306/food_shop"

# ============================================================
# JWT（必填：缺失或少于 16 位时服务拒绝启动，无任何默认回退）
# ============================================================
JWT_SECRET="change-me-user-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
ADMIN_JWT_SECRET="change-me-admin-jwt-secret-min-32-chars"
ADMIN_JWT_EXPIRES_IN="30d"

# ============================================================
# 微信小程序
# ============================================================
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# ============================================================
# 微信支付（阶段 7 接入）
# ============================================================
WECHAT_MCH_ID=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_SERIAL_NO=""
WECHAT_PAY_PRIVATE_KEY_PATH=""
# 必须是公网可访问的 HTTPS 地址；本地 localhost 收不到微信回调，请用 ngrok 或部署后测试
WECHAT_PAY_NOTIFY_URL="https://api.yourdomain.com/api/wechat/pay/notify"
# 退款回调地址（可留空：自动由 NOTIFY_URL 把末尾 /notify 换成 /refund-notify）
WECHAT_PAY_REFUND_NOTIFY_URL=""

# ── 回调验签材料：以下两种模式二选一（商户平台 → 账户中心 → API 安全 查看当前模式）──
# 模式 A「微信支付公钥」（2024 年起新申请商户默认）：下载 pub_key.pem 上传到服务器
WECHAT_PAY_PUBLIC_KEY_PATH=""
# 公钥 ID（PUB_KEY_ID_ 开头，可选；配置后回调头 Wechatpay-Serial 必须与之一致）
WECHAT_PAY_PUBLIC_KEY_ID=""
# 模式 B「平台证书」（老商户）：用官方 CertificateDownloader 下载的 wechatpay_xxx.pem
# 序列号不匹配（证书轮换）时服务会自动调 /v3/certificates 拉取，设 false 可关闭
WECHAT_PAY_PLATFORM_CERT_PATH=""
WECHAT_PAY_CERT_AUTO_DOWNLOAD="true"
# 生产环境两者都未配置：支付/退款回调一律拒绝（启动只警告）；非生产留空则跳过验签

# ============================================================
# 腾讯云 COS（商品/Banner 图片存储）
# 生产必填（未配置服务拒绝启动）；开发留空则回退本地 apps/server/uploads/
# 建议用子账号密钥（CAM），仅授权该存储桶的读写
# ============================================================
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET="afu-images-1342627167"
COS_REGION="ap-shanghai"
# 对外访问域名（自定义域名 / CDN），留空则用桶默认域名 https://<bucket>.cos.<region>.myqcloud.com
COS_BASE_URL=""

# ============================================================
# 服务器
# ============================================================
PORT=3000
NODE_ENV="development"

# 对外可访问的基础 URL（用于拼接上传图片等静态资源地址）
# 开发环境默认 http://localhost:3000，生产必须配置为 https://api.yourdomain.com
PUBLIC_BASE_URL=""

# CORS 白名单（逗号分隔）。开发环境留空则放开；生产环境留空则拒绝所有浏览器跨域
# 例：https://admin.yourdomain.com
CORS_ORIGINS=""

# ============================================================
# Mock 开关（默认全部关闭，仅显式 =true 时启用；生产环境开启会拒绝启动）
# ============================================================
# 微信登录 Mock（本地开发用，无需真实 AppID/AppSecret）
WECHAT_LOGIN_MOCK=true

# 微信支付 Mock（POST /orders/:id/pay 直接标记 PAID，无需真实微信支付）
# 关闭时需配置 WECHAT_MCH_ID / WECHAT_PAY_* 全部变量
WECHAT_PAY_MOCK=true

# 二维码 Mock（未配置 WECHAT_APP_ID/WECHAT_APP_SECRET 时自动 mock）
WECHAT_QRCODE_MOCK=true

# ─────────────────────────────────────────────
# 新订单微信推送（两条通道均可选，可同时开；全部留空则不推送）
# ─────────────────────────────────────────────
# 通道一：企业微信群机器人（推荐，官方、免费、稳定）
# 获取方法：企业微信 App/PC → 进入店铺内部群（成员须全部为本企业成员）→ 右上角…
# → 添加群机器人 → 复制 Webhook 地址粘贴到下面
ORDER_NOTIFY_WECOM_WEBHOOK=""
# 通道二：PushPlus（pushplus.plus，个人微信扫码即收，免费额度有限，订单数据经第三方）
# 获取方法：pushplus.plus 微信扫码登录 → 复制 token；多人接收再建「群组」填群组编码
ORDER_NOTIFY_PUSHPLUS_TOKEN=""
ORDER_NOTIFY_PUSHPLUS_TOPIC=""

# ─────────────────────────────────────────────
# 系统告警（接口 500 / 进程崩溃 / 支付回调金额不符 / 退款失败 / 每日备份结果）
# 告警发给「老板」，订单发给「店员」——两者刻意分开，混在一起告警必被划过去。
# 所有已配置的通道都会收到；一个都没配则只写进 pm2 日志。
# ─────────────────────────────────────────────
# 企微：留空则回退 ORDER_NOTIFY_WECOM_WEBHOOK
SYSTEM_ALERT_WECOM_WEBHOOK=""
# PushPlus：留空则回退 ORDER_NOTIFY_PUSHPLUS_TOKEN。
# 无论用哪个 token，告警都**不带 topic**——只推给 token 所属账号本人，不进店员群。
SYSTEM_ALERT_PUSHPLUS_TOKEN=""

# ── 订单生命周期（定时任务，每分钟一轮）────────────────────────
# 待付款超时自动取消（分钟），微信预下单 time_expire 与之对齐
PAY_TIMEOUT_MIN=15
# 发货后 N 天自动确认收货（顾客仍可申请售后）
AUTO_COMPLETE_DAYS=7
# 多实例部署时只保留一个进程跑定时任务，其余设为 true
# SCHEDULER_DISABLED=false

# ── 小程序订阅消息（公众平台 → 功能 → 订阅消息 → 公共模板库选用）──
# 模板 ID + 字段映射（本系统字段=模板字段 key，逗号分隔）。字段 key 以所选模板为准。
# 下单成功通知可用字段：orderNo / amount / time / shopName / deliveryType / address / receiverName / productName
# 发货通知可用字段：orderNo / expressCompany / expressNo / productName / time / remark
# 退款通知可用字段：orderNo / amount / reason / productName / time
# WECHAT_TMPL_PAID=
# WECHAT_TMPL_PAID_FIELDS=time=date4,shopName=name8,deliveryType=phrase29,address=thing41
# WECHAT_TMPL_SHIP=
# WECHAT_TMPL_SHIP_FIELDS=orderNo=character_string1,expressCompany=thing2,expressNo=character_string3,time=time4
# WECHAT_TMPL_REFUND=
# WECHAT_TMPL_REFUND_FIELDS=orderNo=character_string1,amount=amount2,reason=thing3,time=time4

# ── 同城配送「骑手取餐出发」通知 ─────────────────────────────
# 公共模板编号 584「订单配送通知」，类目 餐饮服务场所/餐饮服务管理企业，一次性订阅。
# 2026-09-03 在 AppID wx11aa80fcd1bfd2bb 下选用；关键词与顺序提交后不可改，换模板须重选。
# 触发点：快递100 回调 status=310（骑手取餐出发，订单转 SHIPPED）。
# 字段长度限制（超长服务端截断，见 services/subscribe-message.ts）：
#   thing ≤20 字符 / name ≤10 字符 / character_string ≤32 字符 / phone_number 需为可拨号号码
#   courierMobile 缺失时兜底填店铺客服电话，空值会导致微信 47003 拒发
WECHAT_TMPL_DELIVER=PL08NeZb0ncyZh5jEpf4piTewNviU3CFs_T8Re7CPCE
WECHAT_TMPL_DELIVER_FIELDS=productName=thing6,courierName=name7,courierMobile=phone_number3,estimatedTime=time13,orderNo=character_string2

# ── 同城配送（M1 运营参数 / M2 运力密钥）─────────────────────
# 运营参数（门店坐标、配送半径、阶梯运费、营业时段、暂停接单）全部在后台
# 「同城设置」页配置，不进 env——改一次运费不该要重启服务。
#
# 下面两项是快递100（同城急送）的密钥，**位置留好、值留空，由店主在服务器上自己填**。
# 不要把真实值写进仓库、截图或聊天里。
#
# 填法（在服务器上，二选一）：
#   bash scripts/set-env.sh KD100_KEY        # 逐个填，输入不回显
#   bash scripts/set-env.sh KD100_SECRET
#   或把 KD100_KEY=xxx / KD100_SECRET=xxx 写进一个清单文件，再
#   bash scripts/import-secrets.sh <清单文件>   # 导入成功后会安全抹除该文件
#
# 从哪拿：快递100 企业版后台 → 我的信息 → 企业信息
#   （需先完成企业认证并预充值，最低 100 元、可退）。
# M1 阶段留空不影响启动：同城配送可先用「店内自送」运力跑起来；
# M2 接入运力后这两项才成为必填。
KD100_KEY=""
KD100_SECRET=""
# 30005（运力异常）自动重试延迟，毫秒逗号分隔；本地 e2e 建议 "0,0"
KD100_RETRY_DELAYS_MS="1000,3000"
# 同城运力 mock：true 时不打快递100，走指令队列（生产开启会拒绝启动）
LOCAL_DELIVERY_PROVIDER_MOCK=true
# 回调地址不设 env：按单拼成 PUBLIC_BASE_URL + '/api/kd/' + deliveryNo
#   （快递100 对 callbackUrl 的长度上限是 50 字符）。
# M2 会在启动时用最坏值 D999999-99 断言总长 ≤ 50，生产超长直接退出。
# 当前 https://api.yuegui-hotel.online/api/kd/D999999-99 = 49，**余量只有 1 个字符**：
# 换更长的 API 域名之前，必须先把路径前缀缩短（例如 /api/k/）。
