# ============================================================
# 数据库
# ============================================================
DATABASE_URL="mysql://foodshop_user:foodshop_password@localhost:3306/food_shop"

# ============================================================
# JWT
# ============================================================
JWT_SECRET="change-me-user-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
ADMIN_JWT_SECRET="change-me-admin-jwt-secret-min-32-chars"
ADMIN_JWT_EXPIRES_IN="24h"

# ============================================================
# 微信小程序
# ============================================================
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# ============================================================
# 微信支付（阶段 7 接入）
# ============================================================
WECHAT_MCH_ID=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_SERIAL_NO=""
WECHAT_PAY_PRIVATE_KEY_PATH=""
WECHAT_PAY_NOTIFY_URL="https://api.yourdomain.com/api/wechat/pay/notify"
# 微信支付平台公钥证书路径（用于回调签名验证；留空则跳过验证，不推荐用于生产）
WECHAT_PAY_PLATFORM_CERT_PATH=""

# ============================================================
# 腾讯云 COS
# ============================================================
COS_SECRET_ID="your-cos-secret-id"
COS_SECRET_KEY="your-cos-secret-key"
COS_BUCKET="your-bucket-name"
COS_REGION="ap-guangzhou"
COS_BASE_URL="https://your-cos-domain.com"

# ============================================================
# 服务器
# ============================================================
PORT=3000
NODE_ENV="development"

# ============================================================
# Mock 开关
# ============================================================
# 旧版 mock 支付（POST /payments/mock/success），保留用于向后兼容
MOCK_PAYMENT_ENABLED=true

# 微信登录 Mock（无真实 AppID/AppSecret 时自动 mock；或强制 mock）
WECHAT_LOGIN_MOCK=true

# 微信支付 Mock（POST /orders/:id/pay 直接标记 PAID，无需真实微信支付）
# 设为 false 时需配置 WECHAT_MCH_ID / WECHAT_PAY_* 全部变量
WECHAT_PAY_MOCK=true

# 二维码 Mock（未配置 WECHAT_APP_ID/WECHAT_APP_SECRET 时自动 mock）
WECHAT_QRCODE_MOCK=true
